#!/bin/sh
set -e

# Reload fcitx5 addon list if fcitx5 is running (best-effort, non-fatal).
if command -v fcitx5-remote >/dev/null 2>&1; then
    if fcitx5-remote -e >/dev/null 2>&1; then
        fcitx5-remote -e 2>/dev/null || true
    fi
fi

# Register screenshot hotkey for the installing user (best-effort).
# postinst runs as root, so we need to run gsettings as the real user.
if command -v farolkey-screenshot-daemon >/dev/null 2>&1; then
    REAL_USER="${SUDO_USER:-${USER:-}}"
    if [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
        su - "$REAL_USER" -c "farolkey-screenshot-daemon --setup" 2>/dev/null || true
    fi
fi

echo "FarolKey installed. To activate:"
echo "  1. Open Fcitx5 Configuration"
echo "  2. Add input method: FarolKey Vietnamese"
echo "  3. Restart Fcitx5: pkill fcitx5; fcitx5 -d"
echo ""
echo "Screenshot shortcut: Super+Shift+S (registered automatically on GNOME)"
