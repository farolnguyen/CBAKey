#!/usr/bin/env python3
"""farolkey-template — Smart Templates (Parametric Macro) for FarolKey.

Template file: ~/.config/farolkey/templates.json  (JSONL, one template per line)
Schema:
  {"pattern": "{n}++", "expansion": "...", "mode": "en|vi|both"}

  pattern   : trigger với {varname} làm placeholder capture
  expansion : Jinja2 template string
  mode      : "en" | "vi" | "both" (default "both")

Built-in Jinja2 globals:
  numbered(n, start=1, sep='\\n')  →  "1\\n2\\n...\\nn"
  today(fmt='%d/%m/%Y')            →  "18/05/2026"
  now(fmt='%H:%M:%S')             →  "14:30:00"
  repeat(text, n, sep='')         →  "abc" * n

  Jinja2 filters cũng available: |int, |float, |upper, |lower, |title, |trim, ...

Usage:
  farolkey-template list
  farolkey-template add <pattern> <expansion> [--mode en|vi|both]
  farolkey-template remove <pattern>
  farolkey-template expand <input>          # render nếu match → stdout; exit 0/1
  farolkey-template test <input>            # expand + debug info trên stderr
  farolkey-template path                    # in ra đường dẫn file
"""

from __future__ import annotations

import json
import os
import re
import sys
from dataclasses import dataclass, asdict
from datetime import datetime
from pathlib import Path
from typing import Optional

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

def _template_path() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d / 'templates.json'

TEMPLATE_FILE = _template_path()

# ---------------------------------------------------------------------------
# Schema
# ---------------------------------------------------------------------------

@dataclass
class Template:
    pattern: str          # e.g. "{n}++"
    expansion: str        # Jinja2 template string
    mode: str = 'both'    # en | vi | both

    def to_dict(self) -> dict:
        return asdict(self)

    @classmethod
    def from_dict(cls, d: dict) -> 'Template':
        return cls(
            pattern=d['pattern'],
            expansion=d['expansion'],
            mode=d.get('mode', 'both'),
        )

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

def load_templates() -> list[Template]:
    if not TEMPLATE_FILE.exists():
        return []
    templates = []
    try:
        with open(TEMPLATE_FILE, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                    templates.append(Template.from_dict(obj))
                except (json.JSONDecodeError, KeyError):
                    pass
    except OSError:
        pass
    return templates

def save_templates(templates: list[Template]) -> None:
    tmp = TEMPLATE_FILE.with_suffix('.tmp')
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            for t in templates:
                f.write(json.dumps(t.to_dict(), ensure_ascii=False) + '\n')
        tmp.replace(TEMPLATE_FILE)
        # Backup
        bak = TEMPLATE_FILE.with_suffix('.bak')
        try:
            import shutil
            shutil.copy2(TEMPLATE_FILE, bak)
        except Exception:
            pass
    except OSError as e:
        print(f'Error saving templates: {e}', file=sys.stderr)
        sys.exit(1)

# ---------------------------------------------------------------------------
# Pattern matching  (M15.3)
# ---------------------------------------------------------------------------

# Matches {varname} placeholders in patterns
_VAR_RE = re.compile(r'\{(\w+)\}')

def _pattern_to_regex(pattern: str) -> Optional[re.Pattern]:
    """Convert "{n}++" to compiled regex with named groups.

    Rules:
    - {varname} -> named group (.+) -- greedy so suffix anchors work
    - Literal chars -> re.escape'd
    - Pattern anchored at start ^ and end $
    """
    parts = []
    last = 0
    for m in _VAR_RE.finditer(pattern):
        # Escape literal text between vars
        literal = pattern[last:m.start()]
        if literal:
            parts.append(re.escape(literal))
        parts.append(f'(?P<{m.group(1)}>.+)')
        last = m.end()
    # Remaining literal suffix
    suffix = pattern[last:]
    if suffix:
        parts.append(re.escape(suffix))

    if not parts:
        return None

    regex_str = '^' + ''.join(parts) + '$'
    try:
        return re.compile(regex_str)
    except re.error:
        return None

def match_template(template: Template, input_str: str) -> Optional[dict[str, str]]:
    """Try to match input against template pattern.
    Returns dict of captured variables, or None if no match.
    """
    rx = _pattern_to_regex(template.pattern)
    if rx is None:
        return None
    m = rx.match(input_str)
    if m is None:
        return None
    return m.groupdict()

def find_match(templates: list[Template], input_str: str,
               mode_filter: Optional[str] = None
               ) -> Optional[tuple[Template, dict[str, str]]]:
    """Find the first template that matches input_str.
    mode_filter: if given ('en'/'vi'), skip templates not applicable to that mode.
    """
    for tmpl in templates:
        if mode_filter:
            if tmpl.mode not in ('both', mode_filter):
                continue
        caps = match_template(tmpl, input_str)
        if caps is not None:
            return tmpl, caps
    return None

# ---------------------------------------------------------------------------
# Jinja2 expansion engine  (M15.4)
# ---------------------------------------------------------------------------

def _make_jinja2_env():
    """Create a sandboxed Jinja2 environment with FarolKey built-in globals."""
    try:
        from jinja2.sandbox import SandboxedEnvironment
    except ImportError:
        return None

    env = SandboxedEnvironment(keep_trailing_newline=True)

    # ---- Built-in global functions ----

    def _numbered(n, start: int = 1, sep: str = '\n') -> str:
        """Numbered list from start to n (inclusive). VD: numbered(5) → '1\\n2\\n3\\n4\\n5'"""
        return sep.join(str(i) for i in range(int(start), int(n) + 1))

    def _today(fmt: str = '%d/%m/%Y') -> str:
        """Ngày hôm nay. VD: today() → '18/05/2026'"""
        return datetime.now().strftime(fmt)

    def _now_fn(fmt: str = '%H:%M:%S') -> str:
        """Giờ hiện tại. VD: now() → '14:30:00'"""
        return datetime.now().strftime(fmt)

    def _repeat(text, n: int, sep: str = '') -> str:
        """Lặp text n lần. VD: repeat('=-', 3) → '=-=-=-=-'"""
        return sep.join([str(text)] * int(n))

    env.globals.update({
        'numbered': _numbered,
        'today':    _today,
        'now':      _now_fn,
        'repeat':   _repeat,
    })

    return env


_jinja2_env = None  # lazily initialized

def get_jinja2_env():
    global _jinja2_env
    if _jinja2_env is None:
        _jinja2_env = _make_jinja2_env()
    return _jinja2_env


def expand(template: Template, captures: dict[str, str]) -> Optional[str]:
    """Render template.expansion (Jinja2) with captured variables.
    Returns rendered string, or None on error.
    """
    env = get_jinja2_env()
    if env is None:
        print('Error: jinja2 not installed. Run: pip3 install jinja2', file=sys.stderr)
        return None
    try:
        tmpl = env.from_string(template.expansion)
        return tmpl.render(**captures)
    except Exception as e:
        print(f'Jinja2 render error: {e}', file=sys.stderr)
        return None

# ---------------------------------------------------------------------------
# CLI commands
# ---------------------------------------------------------------------------

def cmd_list():
    templates = load_templates()
    if not templates:
        print('No templates defined.')
        print(f'File: {TEMPLATE_FILE}')
        return
    print(f'{"#":<3} {"Mode":<6} {"Pattern":<25} Expansion')
    print('-' * 72)
    for i, t in enumerate(templates, 1):
        exp_preview = t.expansion[:40].replace('\n', '↵')
        if len(t.expansion) > 40:
            exp_preview += '…'
        print(f'{i:<3} {t.mode:<6} {t.pattern:<25} {exp_preview}')

def _decode_escapes(s: str) -> str:
    """Convert \\n → newline, \\t → tab so CLI args feel natural."""
    return s.replace('\\n', '\n').replace('\\t', '\t').replace('\\r', '\r')

def cmd_add(pattern: str, expansion: str, mode: str = 'both'):
    expansion = _decode_escapes(expansion)
    if mode not in ('en', 'vi', 'both'):
        print(f'Error: mode must be en/vi/both, got "{mode}"', file=sys.stderr)
        sys.exit(1)

    # Validate pattern has at least one {var} or is a literal
    rx = _pattern_to_regex(pattern)
    if rx is None:
        print(f'Error: invalid pattern "{pattern}"', file=sys.stderr)
        sys.exit(1)

    # Validate Jinja2 template
    env = get_jinja2_env()
    if env:
        try:
            env.parse(expansion)
        except Exception as e:
            print(f'Error: invalid Jinja2 template: {e}', file=sys.stderr)
            sys.exit(1)

    templates = load_templates()
    # Warn if pattern already exists
    for t in templates:
        if t.pattern == pattern:
            print(f'Warning: pattern "{pattern}" already exists, replacing.')
            templates.remove(t)
            break

    templates.append(Template(pattern=pattern, expansion=expansion, mode=mode))
    save_templates(templates)
    print(f'Added: [{mode}] {pattern!r}')

def cmd_remove(pattern: str):
    templates = load_templates()
    before = len(templates)
    templates = [t for t in templates if t.pattern != pattern]
    if len(templates) == before:
        print(f'Pattern "{pattern}" not found.')
        sys.exit(1)
    save_templates(templates)
    print(f'Removed: {pattern!r}')

def cmd_expand(input_str: str, debug: bool = False,
               mode_filter: Optional[str] = None) -> bool:
    """Expand input if a template matches. Prints result to stdout.
    Returns True if expanded, False otherwise.
    Exit code: 0 = expanded, 1 = no match.

    Accepts trigger with or without [brackets] activation prefix.
    e.g. both '[5++]' and '5++' are accepted.
    """
    # Strip [brackets] activation prefix if present (typed in-app format)
    if input_str.startswith('[') and input_str.endswith(']') and len(input_str) > 2:
        input_str = input_str[1:-1]
    if not input_str:
        return False

    templates = load_templates()
    result_pair = find_match(templates, input_str, mode_filter=mode_filter)
    if result_pair is None:
        if debug:
            print(f'No matching template for: {input_str!r}', file=sys.stderr)
        return False

    tmpl, captures = result_pair

    if debug:
        print(f'Pattern   : {tmpl.pattern}', file=sys.stderr)
        print(f'Mode      : {tmpl.mode}', file=sys.stderr)
        print(f'Captures  : {captures}', file=sys.stderr)
        print(f'Expansion : {tmpl.expansion!r}', file=sys.stderr)
        print('--- Output ---', file=sys.stderr)

    rendered = expand(tmpl, captures)
    if rendered is None:
        return False

    # Print WITHOUT trailing newline so caller can decide
    sys.stdout.write(rendered)
    sys.stdout.flush()
    return True

def cmd_path():
    print(TEMPLATE_FILE)

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def _usage():
    print(__doc__)
    sys.exit(0)

def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        _usage()

    cmd = args[0]

    if cmd == 'list':
        cmd_list()

    elif cmd == 'add':
        if len(args) < 3:
            print('Usage: farolkey-template add <pattern> <expansion> [--mode en|vi|both]',
                  file=sys.stderr)
            sys.exit(1)
        pattern   = args[1]
        expansion = args[2]
        mode = 'both'
        if '--mode' in args:
            idx = args.index('--mode')
            if idx + 1 < len(args):
                mode = args[idx + 1]
        cmd_add(pattern, expansion, mode)

    elif cmd == 'remove':
        if len(args) < 2:
            print('Usage: farolkey-template remove <pattern>', file=sys.stderr)
            sys.exit(1)
        cmd_remove(args[1])

    elif cmd in ('expand', 'test'):
        # Parse: farolkey-template expand [--mode en|vi|both] <input>
        mode_filter = None
        positional: list[str] = []
        i = 1
        while i < len(args):
            if args[i] == '--mode' and i + 1 < len(args):
                mode_filter = args[i + 1]
                i += 2
            elif args[i].startswith('--'):
                i += 1  # skip unknown flags
            else:
                positional.append(args[i])
                i += 1

        if not positional:
            print(f'Usage: farolkey-template {cmd} [--mode en|vi|both] <input>',
                  file=sys.stderr)
            sys.exit(1)

        ok = cmd_expand(positional[0], debug=(cmd == 'test'),
                        mode_filter=mode_filter)
        sys.exit(0 if ok else 1)

    elif cmd == 'path':
        cmd_path()

    else:
        print(f'Unknown command: {cmd}', file=sys.stderr)
        _usage()

if __name__ == '__main__':
    main()
