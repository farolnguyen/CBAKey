def _fmt_time(ts: float) -> str:
    diff = time.time() - ts
    if diff < 60:   return 'just now'
    if diff < 3600: return f'{int(diff/60)}m ago'
    if diff < 86400: return time.strftime('%H:%M', time.localtime(ts))
    return time.strftime('%d/%m', time.localtime(ts))

# ---------------------------------------------------------------------------
# IPC server (shared by daemon and show-mode singleton)
# ---------------------------------------------------------------------------

class PopupServer:
    """Unix socket server: accepts SHOW commands → creates / raises popup."""

    def __init__(self, history: ClipboardHistory):
        self._history = history
        self._popup_ref: Optional[ClipboardPopup] = None
        self._sock: Optional[socket.socket] = None

    def start(self):
        if SOCKET_PATH.exists():
            # Check if stale (nobody listening)
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.5)
                s.connect(str(SOCKET_PATH))
                s.close()
                # Socket is live — someone else is already running
                raise RuntimeError('socket in use')
            except (ConnectionRefusedError, FileNotFoundError, socket.timeout):
                SOCKET_PATH.unlink(missing_ok=True)
        self._sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self._sock.bind(str(SOCKET_PATH))
        self._sock.listen(5)
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def stop(self):
        if self._sock:
            try: self._sock.close()
            except Exception: pass
        SOCKET_PATH.unlink(missing_ok=True)

    def _accept_loop(self):
        while True:
            try:
                conn, _ = self._sock.accept()
                data = conn.recv(64).strip()
                conn.close()
                if data == b'SHOW':
                    GLib.idle_add(self.show_popup)
            except Exception:
                break

    def show_popup(self) -> bool:
        """Raise existing popup or create a new one (called from GTK main loop)."""
        if self._popup_ref is not None:
            try:
                if self._popup_ref.get_realized():
                    # Capture before rebuilding so "open again" always shows latest
                    if _active_monitor:
                        _active_monitor.capture_now()
                    self._popup_ref._rebuild()
                    self._popup_ref.present()
                    return False
            except Exception:
                pass
            self._popup_ref = None

        # Fresh popup — do NOT capture here; wait for the 'map' signal instead.
        # On Wayland, wait_for_text() requires the surface to be mapped first.
        popup = ClipboardPopup(self._history)
        popup.connect('destroy', lambda *_: self._on_popup_closed())
        popup.connect('map', lambda *_: self._on_popup_mapped())
        self._popup_ref = popup

        # Register popup for real-time clipboard updates
        if _active_monitor:
            _active_monitor.set_popup_notify(self._refresh_popup)

        return False

    def _on_popup_mapped(self):
        """Called after popup window is shown on screen — safe to read clipboard now."""
        if _active_monitor:
            _active_monitor.capture_now()
        self._refresh_popup()

    def _refresh_popup(self):
        if self._popup_ref and self._popup_ref.get_realized():
            try:
                self._popup_ref._rebuild()
            except Exception:
                pass

    def _on_popup_closed(self):
        self._popup_ref = None
        if _active_monitor:
            _active_monitor.set_popup_notify(None)


def _send_show() -> bool:
    """Signal an existing popup server. Returns True if acknowledged."""
    if not SOCKET_PATH.exists():
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(str(SOCKET_PATH))
        s.sendall(b'SHOW\n')
        s.close()
        return True
    except Exception:
        return False

# ---------------------------------------------------------------------------
# X11 global hotkey
# ---------------------------------------------------------------------------

def _start_x11_hotkey(on_trigger):
    try:
        from Xlib import X
        from Xlib.display import Display
        disp = Display()
        root = disp.screen().root
        kc = disp.keysym_to_keycode(ord('v'))
        MOD = X.ControlMask | X.Mod4Mask
        for extra in (0, X.Mod2Mask):
            root.grab_key(kc, MOD | extra, True, X.GrabModeAsync, X.GrabModeAsync)
        disp.sync()
        def _loop():
            while True:
                ev = disp.next_event()
                if ev.type == X.KeyPress:
                    GLib.idle_add(on_trigger)
        threading.Thread(target=_loop, daemon=True).start()
        print('X11 hotkey: Ctrl+Super+V active', flush=True)
    except ImportError:
        print('X11 hotkey unavailable: python3-xlib not installed. '
              'Run: sudo apt install python3-xlib', flush=True)
    except Exception as e:
        print(f'X11 hotkey unavailable: {e}', flush=True)

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

def run_daemon():
    """Persistent background daemon: monitors clipboard + serves SHOW."""
    global _active_monitor
    history = ClipboardHistory()
    _active_monitor = ClipboardMonitor(history)

    server = PopupServer(history)
    server.start()

    if not _is_wayland():
        _start_x11_hotkey(server.show_popup)

    def _init():
        # Capture current clipboard once GTK main loop is running
        _active_monitor.capture_now()
        return False

    GLib.idle_add(_init)

    def _cleanup(*_):
        server.stop()
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, _cleanup)
    signal.signal(signal.SIGINT,  _cleanup)
    print(f'farolkey-clipboard daemon (socket: {SOCKET_PATH})', flush=True)
    Gtk.main()
    server.stop()


def run_show():
    """Show popup. Signals existing server if any; otherwise becomes the singleton."""
    global _active_monitor

    # Signal existing daemon / popup process
    if _send_show():
        return

    # We are the singleton for this session
    history = ClipboardHistory()
    _active_monitor = ClipboardMonitor(history)

    server = PopupServer(history)
    try:
        server.start()
    except RuntimeError:
        # Another process just bound the socket between our check and bind
        if _send_show():
            return
        # Give up and create popup without server (edge case)

    quit_timer: list[Optional[int]] = [None]

    def _cancel_quit():
        if quit_timer[0] is not None:
            GLib.source_remove(quit_timer[0])
            quit_timer[0] = None

    def _schedule_quit():
        _cancel_quit()
        def _do_quit():
            if server._popup_ref is None:
                server.stop()
                Gtk.main_quit()
            return False
        quit_timer[0] = GLib.timeout_add(2000, _do_quit)

    # Patch server to hook quit logic into popup lifecycle
    _orig_on_closed = server._on_popup_closed
    def _hooked_on_closed():
        _orig_on_closed()
        _schedule_quit()
    server._on_popup_closed = _hooked_on_closed

    _orig_show = server.show_popup
    def _hooked_show() -> bool:
        _cancel_quit()
        return _orig_show()
    server.show_popup = _hooked_show
    # Update accept_loop reference
    server.__class__.show_popup = lambda self: _hooked_show()

    def _init():
        _hooked_show()  # capture + create popup
        return False

    GLib.idle_add(_init)

    def _cleanup(*_):
        server.stop()
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, _cleanup)
    signal.signal(signal.SIGINT,  _cleanup)
    Gtk.main()
    server.stop()


if __name__ == '__main__':
    mode = sys.argv[1] if len(sys.argv) > 1 else '--show'
    if mode == '--daemon':
        run_daemon()
    else:
        run_show()
