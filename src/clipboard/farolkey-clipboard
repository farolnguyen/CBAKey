# ---------------------------------------------------------------------------
# Paths & constants
# ---------------------------------------------------------------------------

def _config_dir() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

CLIPBOARD_CONF = _config_dir() / 'clipboard.conf'
GENERAL_CONF   = _config_dir() / 'farolkey.conf'

def _load_general_conf() -> dict:
    conf = {}
    if GENERAL_CONF.exists():
        for line in GENERAL_CONF.read_text().splitlines():
            line = line.strip()
            if line.startswith('#') or '=' not in line:
                continue
            k, _, v = line.partition('=')
            conf[k.strip()] = v.strip()
    return conf

# Popup position modes: 'mouse' = near cursor, 'corner' = bottom-right of monitor
POPUP_POSITION_DEFAULT = 'mouse'

def load_clipboard_conf() -> dict:
    conf = {
        'popup_position':       POPUP_POSITION_DEFAULT,
        'close_on_click_outside': 'true',
    }
    if CLIPBOARD_CONF.exists():
        for line in CLIPBOARD_CONF.read_text().splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                k, _, v = line.partition('=')
                conf[k.strip()] = v.strip()
    return conf

def save_clipboard_conf(conf: dict):
    CLIPBOARD_CONF.write_text(
        '\n'.join(f'{k}={v}' for k, v in conf.items()) + '\n'
    )

def _get_monitor_at_cursor(display: 'Gdk.Display'):
    """Return the Gdk.Monitor that contains the current pointer position."""
    seat    = display.get_default_seat()
    pointer = seat.get_pointer()
    _, x, y = pointer.get_position()
    monitor = display.get_monitor_at_point(x, y)
    return monitor, x, y

def _data_dir() -> Path:
    xdg = os.environ.get('XDG_DATA_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.local' / 'share'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

def _images_dir() -> Path:
    d = _data_dir() / 'clipboard_images'
    d.mkdir(parents=True, exist_ok=True)
    return d

HISTORY_FILE = _data_dir() / 'clipboard_history.json'
SOCKET_PATH  = _data_dir() / 'clipboard.sock'

MAX_ITEMS    = 50
THUMB_HEIGHT = 72
PREVIEW_CHARS = 200
POPUP_WIDTH  = 380
POPUP_HEIGHT = 520
MARGIN       = 12

_WL_COPY  = shutil.which('wl-copy')
_XCLIP    = shutil.which('xclip')
_XSEL     = shutil.which('xsel')
_XDOTOOL  = shutil.which('xdotool')
_YDOTOOL  = shutil.which('ydotool')
_WTYPE    = shutil.which('wtype')

# Module-level monitor — allows popup to call suppress()
_active_monitor: Optional['ClipboardMonitor'] = None

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------

_PASSWORD_MANAGERS = {
    'keepass', 'keepassxc', '1password', 'bitwarden',
    'gnome-keyring', 'secret-tool', 'pass', 'gopass',
}

def _is_sensitive(text: str, owner: str = '') -> bool:
    if not text or not text.strip():
        return True
    if any(p in owner.lower() for p in _PASSWORD_MANAGERS):
        return True
    return False

# ---------------------------------------------------------------------------
# Clipboard write helpers (survive window destruction on Wayland)
# ---------------------------------------------------------------------------

def _is_wayland() -> bool:
    return 'wayland' in os.environ.get('XDG_SESSION_TYPE', '').lower()

def _set_clipboard_text(text: str):
    if _is_wayland() and _WL_COPY:
        try:
            proc = subprocess.Popen(['wl-copy', '--'], stdin=subprocess.PIPE)
            proc.stdin.write(text.encode('utf-8'))
            proc.stdin.close()
            return
        except Exception:
            pass
    for cmd in (
        ([_XCLIP, '-selection', 'clipboard'] if _XCLIP else None),
        ([_XSEL,  '--clipboard', '--input']  if _XSEL  else None),
    ):
        if cmd:
            try:
                proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
                proc.stdin.write(text.encode('utf-8'))
                proc.stdin.close()
                return
            except Exception:
                pass
    clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    clip.set_text(text, -1)
    clip.store()

def _set_clipboard_image(image_path: str):
    if not Path(image_path).exists():
        return
    if _is_wayland() and _WL_COPY:
        try:
            with open(image_path, 'rb') as f:
                proc = subprocess.Popen(
                    ['wl-copy', '--type', 'image/png'], stdin=subprocess.PIPE)
                proc.stdin.write(f.read())
                proc.stdin.close()
            return
        except Exception:
            pass
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(image_path)
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_image(pb)
        clip.store()
    except Exception:
        pass

# ---------------------------------------------------------------------------
# Auto-paste simulation
# ---------------------------------------------------------------------------

def _try_auto_paste(delay_ms: int = 150) -> bool:
    """Simulate Ctrl+V in the previously-focused window after a short delay.
    Returns True if a tool succeeded.

    Tool priority on Wayland (GNOME):
      1. ydotool  — needs ydotoold daemon or /dev/uinput access (udev rule)
      2. wtype    — needs wlr-virtual-keyboard (wlroots compositors, NOT GNOME)
      3. xdotool  — uses XWayland; works for apps running under XWayland on GNOME
      4. fallback — desktop notification "Ctrl+V to paste"
    """
    time.sleep(delay_ms / 1000.0)
    if _is_wayland():
        # 1. ydotool — works if ydotoold daemon is running or uinput accessible.
        #    Modern ydotool (1.x) uses XKB keysym names, NOT raw evdev CODE:VALUE.
        if _YDOTOOL:
            try:
                r = subprocess.run(
                    ['ydotool', 'key', '--key-delay', '50', 'ctrl+v'],
                    capture_output=True, timeout=2)
                if r.returncode == 0:
                    return True
            except Exception:
                pass
        # 2. wtype — wlroots compositors only (fails on GNOME Wayland)
        if _WTYPE:
            try:
                r = subprocess.run(['wtype', '-M', 'ctrl', 'v', '-m', 'ctrl'],
                                   capture_output=True, timeout=2)
                if r.returncode == 0:
                    return True
            except Exception:
                pass
        # 3. xdotool via XWayland — best-effort for XWayland-backed apps.
        #    Does NOT suppress the fallback notification: on GNOME Wayland,
        #    xdotool exits 0 even when it cannot reach a native-Wayland window,
        #    so its return code is not a reliable signal that paste succeeded.
        if _XDOTOOL:
            try:
                subprocess.run(
                    ['xdotool', 'key', '--clearmodifiers', 'ctrl+v'],
                    capture_output=True, timeout=2)
            except Exception:
                pass
        # ydotool / wtype unavailable or failed — notify user to press Ctrl+V
        _notify_paste_fallback()
        return False
    else:
        if _XDOTOOL:
            try:
                r = subprocess.run(
                    ['xdotool', 'key', '--clearmodifiers', 'ctrl+v'],
                    capture_output=True, timeout=2)
                if r.returncode == 0:
                    return True
            except Exception:
                pass
    return False


def _notify_paste_fallback():
    """Show a notification when auto-paste is not available (e.g. GNOME Wayland)."""
    try:
        notify = shutil.which('notify-send')
        if notify:
            subprocess.Popen(
                [notify, '-a', 'FarolKey', '-t', '2500',
                 'Clipboard', 'Đã copy — nhấn Ctrl+V để dán'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def _has_auto_paste_tool() -> bool:
    if _is_wayland():
        return bool(_YDOTOOL or _WTYPE)
    return bool(_XDOTOOL)

# ---------------------------------------------------------------------------
# Content hashing
# ---------------------------------------------------------------------------

def _text_hash(text: str) -> str:
    return hashlib.md5(text.encode('utf-8')).hexdigest()

def _pixbuf_hash(pb: GdkPixbuf.Pixbuf) -> str:
    try:
        data = pb.get_pixels()
        w, h = pb.get_width(), pb.get_height()
        return hashlib.md5(data + f'{w}x{h}'.encode()).hexdigest()
    except Exception:
        return ''

# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class ClipboardEntry:
    type: str           # 'text' | 'image'
    text: str = ''
    image_path: str = ''
    timestamp: float = field(default_factory=time.time)
    pinned: bool = False

class ClipboardHistory:
    def __init__(self):
        self._entries: list[ClipboardEntry] = []
        self._lock = threading.Lock()
        self._load()

    def _load(self):
        if not HISTORY_FILE.exists():
            return
        try:
            with open(HISTORY_FILE, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    obj = json.loads(line)
                    self._entries.append(ClipboardEntry(
                        type=obj.get('type', 'text'),
                        text=obj.get('text', ''),
                        image_path=obj.get('image_path', ''),
                        timestamp=obj.get('timestamp', 0.0),
                        pinned=obj.get('pinned', False),
                    ))
        except Exception:
            pass

    def _save(self):
        try:
            tmp = HISTORY_FILE.with_suffix('.tmp')
            with open(tmp, 'w', encoding='utf-8') as f:
                for e in self._entries:
                    f.write(json.dumps(asdict(e), ensure_ascii=False) + '\n')
            tmp.replace(HISTORY_FILE)
        except Exception:
            pass

    def add_text(self, text: str, owner: str = '') -> bool:
        if _is_sensitive(text, owner):
            return False
        h = _text_hash(text)
        with self._lock:
            # Dedup: skip if same hash in recent 5 entries
            for e in self._entries[:5]:
                if e.type == 'text' and _text_hash(e.text) == h:
                    return False
            self._entries.insert(0, ClipboardEntry(type='text', text=text))
            self._evict()
            self._save()
            return True

    def add_image(self, pixbuf: GdkPixbuf.Pixbuf) -> bool:
        h = _pixbuf_hash(pixbuf)
        if not h:
            return False
        with self._lock:
            # Dedup: skip if same hash in recent 5 image entries
            for e in self._entries[:5]:
                if e.type == 'image' and e.image_path:
                    try:
                        existing = GdkPixbuf.Pixbuf.new_from_file(e.image_path)
                        if _pixbuf_hash(existing) == h:
                            return False
                    except Exception:
                        pass
            fname = f'{int(time.time() * 1000)}.png'
            path = str(_images_dir() / fname)
            try:
                pixbuf.savev(path, 'png', [], [])
            except Exception:
                return False
            self._entries.insert(0, ClipboardEntry(type='image', image_path=path))
            self._evict()
            self._save()
            return True

    def _evict(self):
        non_pinned = [e for e in self._entries if not e.pinned]
        while len(self._entries) > MAX_ITEMS and non_pinned:
            oldest = non_pinned.pop()
            self._entries.remove(oldest)
            _unlink_image(oldest)

    def toggle_pin(self, index: int):
        with self._lock:
            if 0 <= index < len(self._entries):
                self._entries[index].pinned = not self._entries[index].pinned
                self._save()

    def delete(self, index: int):
        with self._lock:
            if 0 <= index < len(self._entries):
                e = self._entries.pop(index)
                _unlink_image(e)
                self._save()

    def clear_unpinned(self):
        with self._lock:
            to_remove = [e for e in self._entries if not e.pinned]
            for e in to_remove:
                self._entries.remove(e)
                _unlink_image(e)
            self._save()

    def all_entries(self) -> list[ClipboardEntry]:
        with self._lock:
            return list(self._entries)

def _unlink_image(entry: ClipboardEntry):
    if entry.type == 'image' and entry.image_path:
        try:
            Path(entry.image_path).unlink(missing_ok=True)
        except Exception:
            pass

# ---------------------------------------------------------------------------
# Clipboard monitor — debounced, hash-dedup, suppress
# ---------------------------------------------------------------------------

class ClipboardMonitor:
    """Monitors clipboard; debounces rapid owner-change bursts; supports suppress()."""

    def __init__(self, history: ClipboardHistory):
        self._history = history
        self._clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self._last_hash: str = ''
        self._debounce_id: Optional[int] = None
        self._suppress_until: float = 0.0
        # Called after each successful capture so open popups can refresh live.
        self._popup_notify = None
        self._clipboard.connect('owner-change', self._on_owner_change)

    def capture_now(self):
        """Capture current clipboard (must be called from inside GTK main loop)."""
        added = self._do_capture()
        if added and self._popup_notify:
            try:
                self._popup_notify()
            except Exception:
                pass

    def set_popup_notify(self, cb):
        """Register callback invoked after each successful capture (for live updates)."""
        self._popup_notify = cb

    def suppress(self, ms: int = 1000):
        """Ignore owner-change for ms ms (call before write-back to clipboard)."""
        self._suppress_until = time.monotonic() + ms / 1000.0
        if self._debounce_id is not None:
            GLib.source_remove(self._debounce_id)
            self._debounce_id = None

    def _on_owner_change(self, clipboard, event):
        if time.monotonic() < self._suppress_until:
            return
        # Debounce: cancel previous and reschedule 200 ms out.
        # Many apps fire owner-change once per MIME type offered.
        if self._debounce_id is not None:
            GLib.source_remove(self._debounce_id)
        self._debounce_id = GLib.timeout_add(200, self._delayed_capture)

    def _delayed_capture(self) -> bool:
        self._debounce_id = None
        if time.monotonic() < self._suppress_until:
            return False
        added = self._do_capture()
        # Notify open popup so it updates in real time
        if added and self._popup_notify:
            try:
                self._popup_notify()
            except Exception:
                pass
        return False

    def _do_capture(self) -> bool:
        """Read clipboard and add new content to history. Returns True if added."""
        try:
            pixbuf = self._clipboard.wait_for_image()
            if pixbuf is not None:
                h = _pixbuf_hash(pixbuf)
                if h and h != self._last_hash:
                    self._last_hash = h
                    added = self._history.add_image(pixbuf)
                    if added:
                        log.debug('clipboard captured: image')
                    return added
                return False
            text = self._clipboard.wait_for_text()
            if text:
                h = _text_hash(text)
                if h != self._last_hash:
                    self._last_hash = h
                    added = self._history.add_text(text)
                    if added:
                        log.debug('clipboard captured: text %d chars', len(text))
                    return added
        except Exception:
            pass
        return False

# ---------------------------------------------------------------------------
# Popup
