class ClipboardPopup(Gtk.Window):

    def __init__(self, history: ClipboardHistory):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self._history = history

        self.set_title('Clipboard History')
        self.set_decorated(False)
        self.set_default_size(POPUP_WIDTH, POPUP_HEIGHT)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        # UTILITY: no system notification, no taskbar entry.
        # Keyboard focus is obtained via XSetInputFocus (X11) or Gdk.Seat.grab (Wayland).
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)

        self._settings_open = False
        self._dragging      = False
        self._current_row: 'Gtk.ListBoxRow | None' = None

        self._apply_css()
        self._position_window()
        self._build_ui()
        self.connect('key-press-event',   self._on_key_press)
        self.connect('focus-out-event',   self._on_focus_out)
        self.connect('button-press-event', self._on_button_press_outside)
        self.show_all()
        self._search.grab_focus()
        # Focus after window is mapped (50ms gives the WM time to process the map)
        GLib.timeout_add(50, self._take_focus)

    def _apply_css(self):
        css = b"""
        window { border: 1px solid @borders; border-radius: 8px;
                 background-color: @theme_bg_color; }
        .cb-header { background-color: @theme_selected_bg_color;
                     padding: 8px 10px; border-radius: 8px 8px 0 0; }
        .cb-title  { color: @theme_selected_fg_color; font-weight: bold; font-size: 13px; }
        .cb-hbtn   { color: @theme_selected_fg_color; background: none; border: none;
                     padding: 0 4px; font-size: 11px; min-height: 0; min-width: 0; }
        .cb-item   { padding: 5px 8px; border-bottom: 1px solid alpha(@borders, 0.5); }
        row.cb-current { background-color: @theme_selected_bg_color;
                         background-image: none; }
        row.cb-current label { color: @theme_selected_fg_color; }
        row.cb-current .cb-ts { color: alpha(@theme_selected_fg_color, 0.75); }
        .cb-text   { font-size: 12px; }
        .cb-ts     { font-size: 10px; color: alpha(@theme_fg_color, 0.60); }
        .cb-footer { padding: 3px 8px; font-size: 10px;
                     color: alpha(@theme_fg_color, 0.65); }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, provider, 800)
        # Remove this provider when the popup closes so it doesn't accumulate
        # across daemon restarts (GdkScreen holds strong refs to providers).
        self.connect('destroy', lambda *_:
            Gtk.StyleContext.remove_provider_for_screen(screen, provider))

    def _position_window(self):
        conf = load_clipboard_conf()
        mode = conf.get('popup_position', POPUP_POSITION_DEFAULT)

        display = Gdk.Display.get_default()

        if _is_wayland():
            # On Wayland, move() is a no-op — compositor places window.
            # Best-effort: CENTER gives a reasonable default.
            self.set_position(Gtk.WindowPosition.CENTER)
            return

        monitor, cx, cy = _get_monitor_at_cursor(display)
        geo = monitor.get_geometry() if monitor else None
        if geo is None:
            screen = Gdk.Screen.get_default()
            geo = screen.get_monitor_geometry(screen.get_primary_monitor())

        if mode == 'mouse':
            # Position popup so it appears near the cursor, clamped to monitor
            x = cx + 16
            y = cy + 16
            # Clamp: don't overflow right/bottom edge
            if x + POPUP_WIDTH  > geo.x + geo.width:
                x = cx - POPUP_WIDTH  - 8
            if y + POPUP_HEIGHT > geo.y + geo.height:
                y = cy - POPUP_HEIGHT - 8
            x = max(geo.x, x)
            y = max(geo.y, y)
            self.move(x, y)
        else:  # corner
            self.move(
                geo.x + geo.width  - POPUP_WIDTH  - MARGIN,
                geo.y + geo.height - POPUP_HEIGHT - MARGIN)

    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Header
        inner = Gtk.Box(spacing=6)
        inner.get_style_context().add_class('cb-header')
        title = Gtk.Label(label='📋  Clipboard History', xalign=0)
        title.get_style_context().add_class('cb-title')
        settings_btn = Gtk.Button(label='⚙')
        settings_btn.get_style_context().add_class('cb-hbtn')
        settings_btn.set_tooltip_text('Cài đặt')
        settings_btn.connect('clicked', self._on_settings)
        clear_btn = Gtk.Button(label='Clear all')
        clear_btn.get_style_context().add_class('cb-hbtn')
        clear_btn.connect('clicked', self._on_clear_all)
        close_btn = Gtk.Button(label='✕')
        close_btn.get_style_context().add_class('cb-hbtn')
        close_btn.connect('clicked', lambda *_: self.destroy())
        inner.pack_start(title, True, True, 0)
        inner.pack_end(close_btn, False, False, 0)
        inner.pack_end(clear_btn, False, False, 0)
        inner.pack_end(settings_btn, False, False, 0)

        hdr_eb = Gtk.EventBox()
        hdr_eb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        hdr_eb.add(inner)
        hdr_eb.connect('button-press-event', self._on_drag)
        root.pack_start(hdr_eb, False, False, 0)

        # Search
        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text('Search…')
        self._search.set_margin_start(8); self._search.set_margin_end(8)
        self._search.set_margin_top(5);   self._search.set_margin_bottom(3)
        self._search.connect('search-changed', lambda *_: self._rebuild())
        root.pack_start(self._search, False, False, 0)

        # List
        self._scroll = Gtk.ScrolledWindow()
        scroll = self._scroll
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        self._listbox = Gtk.ListBox()
        self._listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self._listbox.connect('row-activated', self._on_activate)
        scroll.add(self._listbox)
        root.pack_start(scroll, True, True, 0)

        # Footer
        self._footer = Gtk.Label(label='', xalign=0)
        self._footer.get_style_context().add_class('cb-footer')
        self._footer.set_margin_start(8)
        root.pack_start(self._footer, False, False, 0)

        self._rebuild()

    def _rebuild(self):
        query = self._search.get_text().strip().lower()
        entries = self._history.all_entries()
        filtered = [
            (i, e) for i, e in enumerate(entries)
            if not query
            or (e.type == 'text' and query in e.text.lower())
            or (e.type == 'image' and 'image' in query)
        ]
        for child in self._listbox.get_children():
            self._listbox.remove(child)
        for orig_idx, entry in filtered:
            self._listbox.add(self._make_row(orig_idx, entry))
        self._listbox.show_all()
        rows = self._listbox.get_children()
        if rows:
            self._set_current_row(rows[0])
        n = len(entries); s = len(filtered)
        self._footer.set_text(f'{s}/{n} items' if query else
                              f'{n} item{"s" if n != 1 else ""}')

    def _set_current_row(self, row: 'Gtk.ListBoxRow | None'):
        if self._current_row is not None:
            self._current_row.get_style_context().remove_class('cb-current')
        self._current_row = row
        if row is not None:
            row.get_style_context().add_class('cb-current')

    def _make_row(self, orig_idx: int, entry: ClipboardEntry) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row._orig_idx = orig_idx
        row.get_style_context().add_class('cb-item')

        hbox = Gtk.Box(spacing=6)

        pin_lbl = Gtk.Label(label='📌' if entry.pinned else '', xalign=0)
        pin_lbl.set_width_chars(2)
        hbox.pack_start(pin_lbl, False, False, 0)

        if entry.type == 'image':
            content = self._image_widget(entry.image_path)
        else:
            preview = entry.text[:PREVIEW_CHARS].replace('\n', '↵').replace('\t', '→')
            if len(entry.text) > PREVIEW_CHARS:
                preview += '…'
            content = Gtk.Label(label=preview, xalign=0)
            content.set_line_wrap(True)
            content.set_line_wrap_mode(2)
            content.set_max_width_chars(36)
            content.set_lines(3)
            content.get_style_context().add_class('cb-text')
        hbox.pack_start(content, True, True, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        right.set_valign(Gtk.Align.START)
        ts_lbl = Gtk.Label(label=_fmt_time(entry.timestamp), xalign=1)
        ts_lbl.get_style_context().add_class('cb-ts')
        right.pack_start(ts_lbl, False, False, 0)
        btn_box = Gtk.Box()
        pin_btn = Gtk.Button(label='🔓' if entry.pinned else '📌')
        pin_btn.set_relief(Gtk.ReliefStyle.NONE)
        pin_btn.connect('clicked', self._on_pin, orig_idx)
        del_btn = Gtk.Button(label='✕')
        del_btn.set_relief(Gtk.ReliefStyle.NONE)
        del_btn.connect('clicked', self._on_delete, orig_idx)
        btn_box.pack_start(pin_btn, False, False, 0)
        btn_box.pack_start(del_btn, False, False, 0)
        right.pack_start(btn_box, False, False, 0)
        hbox.pack_end(right, False, False, 0)

        row.add(hbox)
        return row

    def _image_widget(self, image_path: str) -> Gtk.Widget:
        box = Gtk.Box(spacing=6)
        if image_path and Path(image_path).exists():
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(image_path)
                w, h = pb.get_width(), pb.get_height()
                if h > 0:
                    nw = max(1, int(w * THUMB_HEIGHT / h))
                    pb = pb.scale_simple(nw, THUMB_HEIGHT, GdkPixbuf.InterpType.BILINEAR)
                box.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
            except Exception:
                pass
        lbl = Gtk.Label(label='🖼 Image', xalign=0)
        lbl.get_style_context().add_class('cb-text')
        box.pack_start(lbl, False, False, 0)
        return box

    # ---- Actions ----

    def _do_copy(self, orig_idx: int):
        entries = self._history.all_entries()
        if 0 <= orig_idx < len(entries):
            e = entries[orig_idx]
            if _active_monitor:
                _active_monitor.suppress(1000)
            if e.type == 'text':
                _set_clipboard_text(e.text)
            elif e.type == 'image' and e.image_path:
                _set_clipboard_image(e.image_path)

    def _on_activate(self, listbox, row):
        entries = self._history.all_entries()
        if 0 <= row._orig_idx < len(entries):
            e = entries[row._orig_idx]
            if e.type == 'text':
                log.info('item selected: text %d chars', len(e.text))
            else:
                log.info('item selected: image')
        self._do_copy(row._orig_idx)
        # Close popup (returns focus to previous app), then send Ctrl+V.
        # 300ms delay: allows WM to complete focus transfer before keypress.
        self.destroy()
        log.debug('auto-paste launched')
        # Wayland needs more time for focus to return to the previous app
        # after keyboard grab is released and popup window is destroyed.
        delay = 500 if _is_wayland() else 300
        threading.Thread(target=lambda: _try_auto_paste(delay), daemon=True).start()

    def _on_pin(self, btn, orig_idx):
        self._history.toggle_pin(orig_idx)
        self._rebuild()

    def _on_delete(self, btn, orig_idx):
        if _active_monitor:
            _active_monitor.suppress(1000)
        self._history.delete(orig_idx)
        self._rebuild()

    def _on_clear_all(self, btn):
        dlg = Gtk.MessageDialog(transient_for=self, flags=Gtk.DialogFlags.MODAL,
                                message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.YES_NO,
                                text='Clear all unpinned items?')
        dlg.format_secondary_text('Pinned items will be kept.')
        self._settings_open = True   # prevent focus-out from closing popup
        resp = dlg.run()
        dlg.destroy()
        self._settings_open = False
        if resp == Gtk.ResponseType.YES:
            if _active_monitor:
                _active_monitor.suppress(500)
            self._history.clear_unpinned()
            self._rebuild()

    def _on_settings(self, btn):
        tool = shutil.which('farolkey-settings') or str(
            Path(__file__).parent / 'farolkey-settings'
        )
        subprocess.Popen([tool, '--tab=clipboard'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ---- Keyboard ----

    def _on_key_press(self, widget, event):
        k = event.keyval
        if k == Gdk.KEY_Escape:
            self.destroy(); return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            row = self._current_row
            if row:
                self._do_copy(row._orig_idx)
                self.destroy()
                delay = 500 if _is_wayland() else 300
                threading.Thread(target=lambda: _try_auto_paste(delay), daemon=True).start()
                return True
        if k == Gdk.KEY_Up:
            self._move_sel(-1); return True
        if k == Gdk.KEY_Down:
            self._move_sel(1); return True
        return False

    def _move_sel(self, d: int):
        rows = self._listbox.get_children()
        if not rows: return
        cur = self._current_row
        idx = rows.index(cur) if cur in rows else (-1 if d > 0 else len(rows))
        new_row = rows[max(0, min(len(rows) - 1, idx + d))]
        self._set_current_row(new_row)
        GLib.idle_add(self._scroll_to_row, new_row)

    def _scroll_to_row(self, row: Gtk.ListBoxRow) -> bool:
        """Ensure row is visible in the scrolled window. Called via GLib.idle_add."""
        adj = self._scroll.get_vadjustment()
        alloc = row.get_allocation()
        val = adj.get_value()
        page = adj.get_page_size()
        if alloc.y < val:
            adj.set_value(max(alloc.y, adj.get_lower()))
        elif alloc.y + alloc.height > val + page:
            adj.set_value(min(alloc.y + alloc.height - page,
                              adj.get_upper() - page))
        return False  # do not repeat

    # ── Focus management ──────────────────────────────────────────────────────

    def _take_focus(self):
        """Request keyboard focus. Called 50ms after show_all()."""
        gdk_win = self.get_window()
        if not gdk_win:
            return False
        if _is_wayland():
            # On Wayland we do NOT use Gdk.Seat.grab — it triggers a GNOME
            # permission dialog ("Allow inhibiting shortcuts?") which dismisses
            # instantly and fires focus-out-event, closing the popup.
            # present() asks the compositor to raise and focus the window;
            # the search widget then gets keyboard events normally.
            self.present()
        else:
            self._x11_set_focus(gdk_win)
        self._search.grab_focus()
        return False   # don't repeat

    def _x11_set_focus(self, gdk_win):
        """Use XSetInputFocus via python-xlib — works regardless of window type hint."""
        try:
            from gi.repository import GdkX11
            from Xlib.display import Display as XDisplay
            from Xlib import X
            xid = GdkX11.X11Window.get_xid(gdk_win)
            xd  = XDisplay()
            # RevertToParent: if our window is unmapped, focus goes to parent
            xd.set_input_focus(xid, X.RevertToParent, X.CurrentTime)
            xd.flush()
            xd.close()
            log.debug('X11 focus set via XSetInputFocus')
        except Exception as e:
            log.error('X11 focus failed: %s', e)
            # Fallback: GDK built-in (less reliable for UTILITY windows)
            gdk_win.focus(0)

    def destroy(self):
        super().destroy()

    # ── Click-outside detection ────────────────────────────────────────────────

    def _on_focus_out(self, widget, event):
        """Close popup when focus moves elsewhere (X11 and Wayland).

        On Wayland: works because we grab KEYBOARD only — clicking outside
        gives keyboard focus to the other window, firing this event.
        On X11: same mechanism via XSetInputFocus.
        """
        if self._dragging or self._settings_open:
            return False
        conf = load_clipboard_conf()
        if conf.get('close_on_click_outside', 'true') == 'true':
            # Short delay: WM may briefly steal focus during drag/menu operations
            GLib.timeout_add(120, self._maybe_close_focus_out)
        return False

    def _maybe_close_focus_out(self):
        if not self._dragging and not self._settings_open and not self.is_active():
            self.destroy()
        return False

    def _on_button_press_outside(self, widget, event):
        """No-op: click-outside is handled via focus-out-event on both X11 and Wayland."""
        return False

    def _on_drag(self, widget, event):
        if event.button == 1:
            self._dragging = True
            self.begin_move_drag(event.button, int(event.x_root),
                                 int(event.y_root), event.time)
            # Re-acquire focus after drag completes
            GLib.timeout_add(700, self._end_drag)

    def _end_drag(self):
        self._dragging = False
        GLib.idle_add(self._take_focus)
        return False

