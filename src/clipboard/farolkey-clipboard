#!/usr/bin/env python3
"""FarolKey Clipboard History — daemon + Windows-style popup.

Usage:
  farolkey-clipboard --daemon   # persistent daemon (monitors clipboard, serves SHOW)
  farolkey-clipboard --show     # show popup (signals daemon if running, else inline)
  farolkey-clipboard            # same as --show
"""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

import hashlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Optional

# ---------------------------------------------------------------------------
# Paths & constants
# ---------------------------------------------------------------------------

def _config_dir() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

CLIPBOARD_CONF = _config_dir() / 'clipboard.conf'

# Popup position modes: 'mouse' = near cursor, 'corner' = bottom-right of monitor
POPUP_POSITION_DEFAULT = 'mouse'

def load_clipboard_conf() -> dict:
    conf = {'popup_position': POPUP_POSITION_DEFAULT}
    if CLIPBOARD_CONF.exists():
        for line in CLIPBOARD_CONF.read_text().splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                k, _, v = line.partition('=')
                conf[k.strip()] = v.strip()
    return conf

def save_clipboard_conf(conf: dict):
    CLIPBOARD_CONF.write_text(
        '\n'.join(f'{k}={v}' for k, v in conf.items()) + '\n'
    )

def _get_monitor_at_cursor(display: 'Gdk.Display'):
    """Return the Gdk.Monitor that contains the current pointer position."""
    seat    = display.get_default_seat()
    pointer = seat.get_pointer()
    _, x, y = pointer.get_position()
    monitor = display.get_monitor_at_point(x, y)
    return monitor, x, y

def _data_dir() -> Path:
    xdg = os.environ.get('XDG_DATA_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.local' / 'share'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

def _images_dir() -> Path:
    d = _data_dir() / 'clipboard_images'
    d.mkdir(parents=True, exist_ok=True)
    return d

HISTORY_FILE = _data_dir() / 'clipboard_history.json'
SOCKET_PATH  = _data_dir() / 'clipboard.sock'

MAX_ITEMS    = 50
THUMB_HEIGHT = 72
PREVIEW_CHARS = 200
POPUP_WIDTH  = 380
POPUP_HEIGHT = 520
MARGIN       = 12

_WL_COPY  = shutil.which('wl-copy')
_XCLIP    = shutil.which('xclip')
_XSEL     = shutil.which('xsel')
_XDOTOOL  = shutil.which('xdotool')
_YDOTOOL  = shutil.which('ydotool')
_WTYPE    = shutil.which('wtype')

# Module-level monitor — allows popup to call suppress()
_active_monitor: Optional['ClipboardMonitor'] = None

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------

_PASSWORD_MANAGERS = {
    'keepass', 'keepassxc', '1password', 'bitwarden',
    'gnome-keyring', 'secret-tool', 'pass', 'gopass',
}

def _is_sensitive(text: str, owner: str = '') -> bool:
    if not text or not text.strip():
        return True
    if any(p in owner.lower() for p in _PASSWORD_MANAGERS):
        return True
    return False

# ---------------------------------------------------------------------------
# Clipboard write helpers (survive window destruction on Wayland)
# ---------------------------------------------------------------------------

def _is_wayland() -> bool:
    return 'wayland' in os.environ.get('XDG_SESSION_TYPE', '').lower()

def _set_clipboard_text(text: str):
    if _is_wayland() and _WL_COPY:
        try:
            proc = subprocess.Popen(['wl-copy', '--'], stdin=subprocess.PIPE)
            proc.stdin.write(text.encode('utf-8'))
            proc.stdin.close()
            return
        except Exception:
            pass
    for cmd in (
        ([_XCLIP, '-selection', 'clipboard'] if _XCLIP else None),
        ([_XSEL,  '--clipboard', '--input']  if _XSEL  else None),
    ):
        if cmd:
            try:
                proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
                proc.stdin.write(text.encode('utf-8'))
                proc.stdin.close()
                return
            except Exception:
                pass
    clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    clip.set_text(text, -1)
    clip.store()

def _set_clipboard_image(image_path: str):
    if not Path(image_path).exists():
        return
    if _is_wayland() and _WL_COPY:
        try:
            with open(image_path, 'rb') as f:
                proc = subprocess.Popen(
                    ['wl-copy', '--type', 'image/png'], stdin=subprocess.PIPE)
                proc.stdin.write(f.read())
                proc.stdin.close()
            return
        except Exception:
            pass
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(image_path)
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_image(pb)
        clip.store()
    except Exception:
        pass

# ---------------------------------------------------------------------------
# Auto-paste simulation
# ---------------------------------------------------------------------------

def _try_auto_paste(delay_ms: int = 150) -> bool:
    """Simulate Ctrl+V in the previously-focused window after a short delay.
    Returns True if a paste tool was found and launched (not guaranteed to succeed).
    """
    time.sleep(delay_ms / 1000.0)
    if _is_wayland():
        # ydotool needs ydotoold daemon; KEY_LEFTCTRL=29, KEY_V=47
        if _YDOTOOL:
            try:
                subprocess.run(
                    ['ydotool', 'key', '29:1', '47:1', '47:0', '29:0'],
                    capture_output=True, timeout=2)
                return True
            except Exception:
                pass
        # wtype: simple Wayland keyboard emulator
        if _WTYPE:
            try:
                subprocess.run(['wtype', '-M', 'ctrl', 'v', '-m', 'ctrl'],
                               capture_output=True, timeout=2)
                return True
            except Exception:
                pass
    else:
        if _XDOTOOL:
            try:
                subprocess.run(
                    ['xdotool', 'key', '--clearmodifiers', 'ctrl+v'],
                    capture_output=True, timeout=2)
                return True
            except Exception:
                pass
    return False


def _has_auto_paste_tool() -> bool:
    if _is_wayland():
        return bool(_YDOTOOL or _WTYPE)
    return bool(_XDOTOOL)

# ---------------------------------------------------------------------------
# Content hashing
# ---------------------------------------------------------------------------

def _text_hash(text: str) -> str:
    return hashlib.md5(text.encode('utf-8')).hexdigest()

def _pixbuf_hash(pb: GdkPixbuf.Pixbuf) -> str:
    try:
        data = pb.get_pixels()
        w, h = pb.get_width(), pb.get_height()
        sample = data[:2048] + data[-2048:] + f'{w}x{h}'.encode()
        return hashlib.md5(sample).hexdigest()
    except Exception:
        return ''

# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class ClipboardEntry:
    type: str           # 'text' | 'image'
    text: str = ''
    image_path: str = ''
    timestamp: float = field(default_factory=time.time)
    pinned: bool = False

class ClipboardHistory:
    def __init__(self):
        self._entries: list[ClipboardEntry] = []
        self._lock = threading.Lock()
        self._load()

    def _load(self):
        if not HISTORY_FILE.exists():
            return
        try:
            with open(HISTORY_FILE, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    obj = json.loads(line)
                    self._entries.append(ClipboardEntry(
                        type=obj.get('type', 'text'),
                        text=obj.get('text', ''),
                        image_path=obj.get('image_path', ''),
                        timestamp=obj.get('timestamp', 0.0),
                        pinned=obj.get('pinned', False),
                    ))
        except Exception:
            pass

    def _save(self):
        try:
            tmp = HISTORY_FILE.with_suffix('.tmp')
            with open(tmp, 'w', encoding='utf-8') as f:
                for e in self._entries:
                    f.write(json.dumps(asdict(e), ensure_ascii=False) + '\n')
            tmp.replace(HISTORY_FILE)
        except Exception:
            pass

    def add_text(self, text: str, owner: str = '') -> bool:
        if _is_sensitive(text, owner):
            return False
        h = _text_hash(text)
        with self._lock:
            # Dedup: skip if same hash in recent 5 entries
            for e in self._entries[:5]:
                if e.type == 'text' and _text_hash(e.text) == h:
                    return False
            self._entries.insert(0, ClipboardEntry(type='text', text=text))
            self._evict()
            self._save()
            return True

    def add_image(self, pixbuf: GdkPixbuf.Pixbuf) -> bool:
        h = _pixbuf_hash(pixbuf)
        if not h:
            return False
        with self._lock:
            # Dedup: skip if same hash in recent 5 image entries
            for e in self._entries[:5]:
                if e.type == 'image' and e.image_path:
                    try:
                        existing = GdkPixbuf.Pixbuf.new_from_file(e.image_path)
                        if _pixbuf_hash(existing) == h:
                            return False
                    except Exception:
                        pass
            fname = f'{int(time.time() * 1000)}.png'
            path = str(_images_dir() / fname)
            try:
                pixbuf.savev(path, 'png', [], [])
            except Exception:
                return False
            self._entries.insert(0, ClipboardEntry(type='image', image_path=path))
            self._evict()
            self._save()
            return True

    def _evict(self):
        non_pinned = [e for e in self._entries if not e.pinned]
        while len(self._entries) > MAX_ITEMS and non_pinned:
            oldest = non_pinned.pop()
            self._entries.remove(oldest)
            _unlink_image(oldest)

    def toggle_pin(self, index: int):
        with self._lock:
            if 0 <= index < len(self._entries):
                self._entries[index].pinned = not self._entries[index].pinned
                self._save()

    def delete(self, index: int):
        with self._lock:
            if 0 <= index < len(self._entries):
                e = self._entries.pop(index)
                _unlink_image(e)
                self._save()

    def clear_unpinned(self):
        with self._lock:
            to_remove = [e for e in self._entries if not e.pinned]
            for e in to_remove:
                self._entries.remove(e)
                _unlink_image(e)
            self._save()

    def all_entries(self) -> list[ClipboardEntry]:
        with self._lock:
            return list(self._entries)

def _unlink_image(entry: ClipboardEntry):
    if entry.type == 'image' and entry.image_path:
        try:
            Path(entry.image_path).unlink(missing_ok=True)
        except Exception:
            pass

# ---------------------------------------------------------------------------
# Clipboard monitor — debounced, hash-dedup, suppress
# ---------------------------------------------------------------------------

class ClipboardMonitor:
    """Monitors clipboard; debounces rapid owner-change bursts; supports suppress()."""

    def __init__(self, history: ClipboardHistory):
        self._history = history
        self._clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self._last_hash: str = ''
        self._debounce_id: Optional[int] = None
        self._suppress_until: float = 0.0
        # Called after each successful capture so open popups can refresh live.
        self._popup_notify = None
        self._clipboard.connect('owner-change', self._on_owner_change)

    def capture_now(self):
        """Capture current clipboard (must be called from inside GTK main loop)."""
        added = self._do_capture()
        if added and self._popup_notify:
            try:
                self._popup_notify()
            except Exception:
                pass

    def set_popup_notify(self, cb):
        """Register callback invoked after each successful capture (for live updates)."""
        self._popup_notify = cb

    def suppress(self, ms: int = 1000):
        """Ignore owner-change for ms ms (call before write-back to clipboard)."""
        self._suppress_until = time.monotonic() + ms / 1000.0
        if self._debounce_id is not None:
            GLib.source_remove(self._debounce_id)
            self._debounce_id = None

    def _on_owner_change(self, clipboard, event):
        if time.monotonic() < self._suppress_until:
            return
        # Debounce: cancel previous and reschedule 200 ms out.
        # Many apps fire owner-change once per MIME type offered.
        if self._debounce_id is not None:
            GLib.source_remove(self._debounce_id)
        self._debounce_id = GLib.timeout_add(200, self._delayed_capture)

    def _delayed_capture(self) -> bool:
        self._debounce_id = None
        if time.monotonic() < self._suppress_until:
            return False
        added = self._do_capture()
        # Notify open popup so it updates in real time
        if added and self._popup_notify:
            try:
                self._popup_notify()
            except Exception:
                pass
        return False

    def _do_capture(self) -> bool:
        """Read clipboard and add new content to history. Returns True if added."""
        try:
            pixbuf = self._clipboard.wait_for_image()
            if pixbuf is not None:
                h = _pixbuf_hash(pixbuf)
                if h and h != self._last_hash:
                    self._last_hash = h
                    return self._history.add_image(pixbuf)
                return False
            text = self._clipboard.wait_for_text()
            if text:
                h = _text_hash(text)
                if h != self._last_hash:
                    self._last_hash = h
                    return self._history.add_text(text)
        except Exception:
            pass
        return False

# ---------------------------------------------------------------------------
# Popup
# ---------------------------------------------------------------------------

class ClipboardPopup(Gtk.Window):

    def __init__(self, history: ClipboardHistory):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self._history = history

        self.set_title('Clipboard History')
        self.set_decorated(False)
        self.set_default_size(POPUP_WIDTH, POPUP_HEIGHT)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        # No focus-out-event → destroy: closing only via Esc / ✕ / item select.

        self._apply_css()
        self._position_window()
        self._build_ui()
        self.connect('key-press-event', self._on_key_press)
        self.show_all()
        self._search.grab_focus()

    def _apply_css(self):
        css = b"""
        window { border: 1px solid @borders; border-radius: 8px; background-color: @theme_bg_color; }
        .cb-header { background-color: @theme_selected_bg_color; padding: 8px 10px; border-radius: 8px 8px 0 0; }
        .cb-title  { color: @theme_selected_fg_color; font-weight: bold; font-size: 13px; }
        .cb-hbtn   { color: @theme_selected_fg_color; background: none; border: none; padding: 0 4px; font-size: 11px; min-height: 0; min-width: 0; }
        .cb-item   { padding: 5px 8px; border-bottom: 1px solid alpha(@borders, 0.4); }
        .cb-item:selected { background-color: alpha(@theme_selected_bg_color, 0.18); }
        .cb-text   { font-size: 12px; }
        .cb-ts     { font-size: 10px; color: alpha(@theme_fg_color, 0.45); }
        .cb-footer { padding: 3px 8px; font-size: 10px; color: alpha(@theme_fg_color, 0.5); }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _position_window(self):
        conf = load_clipboard_conf()
        mode = conf.get('popup_position', POPUP_POSITION_DEFAULT)

        display = Gdk.Display.get_default()

        if _is_wayland():
            # On Wayland, move() is a no-op — compositor places window.
            # Best-effort: CENTER gives a reasonable default.
            self.set_position(Gtk.WindowPosition.CENTER)
            return

        monitor, cx, cy = _get_monitor_at_cursor(display)
        geo = monitor.get_geometry() if monitor else None
        if geo is None:
            screen = Gdk.Screen.get_default()
            geo = screen.get_monitor_geometry(screen.get_primary_monitor())

        if mode == 'mouse':
            # Position popup so it appears near the cursor, clamped to monitor
            x = cx + 16
            y = cy + 16
            # Clamp: don't overflow right/bottom edge
            if x + POPUP_WIDTH  > geo.x + geo.width:
                x = cx - POPUP_WIDTH  - 8
            if y + POPUP_HEIGHT > geo.y + geo.height:
                y = cy - POPUP_HEIGHT - 8
            x = max(geo.x, x)
            y = max(geo.y, y)
            self.move(x, y)
        else:  # corner
            self.move(
                geo.x + geo.width  - POPUP_WIDTH  - MARGIN,
                geo.y + geo.height - POPUP_HEIGHT - MARGIN)

    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Header
        inner = Gtk.Box(spacing=6)
        inner.get_style_context().add_class('cb-header')
        title = Gtk.Label(label='📋  Clipboard History', xalign=0)
        title.get_style_context().add_class('cb-title')
        settings_btn = Gtk.Button(label='⚙')
        settings_btn.get_style_context().add_class('cb-hbtn')
        settings_btn.set_tooltip_text('Cài đặt vị trí popup')
        settings_btn.connect('clicked', self._on_settings)
        clear_btn = Gtk.Button(label='Clear all')
        clear_btn.get_style_context().add_class('cb-hbtn')
        clear_btn.connect('clicked', self._on_clear_all)
        close_btn = Gtk.Button(label='✕')
        close_btn.get_style_context().add_class('cb-hbtn')
        close_btn.connect('clicked', lambda *_: self.destroy())
        inner.pack_start(title, True, True, 0)
        inner.pack_end(close_btn, False, False, 0)
        inner.pack_end(clear_btn, False, False, 0)
        inner.pack_end(settings_btn, False, False, 0)

        hdr_eb = Gtk.EventBox()
        hdr_eb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        hdr_eb.add(inner)
        hdr_eb.connect('button-press-event', self._on_drag)
        root.pack_start(hdr_eb, False, False, 0)

        # Search
        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text('Search…')
        self._search.set_margin_start(8); self._search.set_margin_end(8)
        self._search.set_margin_top(5);   self._search.set_margin_bottom(3)
        self._search.connect('search-changed', lambda *_: self._rebuild())
        root.pack_start(self._search, False, False, 0)

        # List
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        self._listbox = Gtk.ListBox()
        self._listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._listbox.connect('row-activated', self._on_activate)
        scroll.add(self._listbox)
        root.pack_start(scroll, True, True, 0)

        # Footer
        self._footer = Gtk.Label(label='', xalign=0)
        self._footer.get_style_context().add_class('cb-footer')
        self._footer.set_margin_start(8)
        root.pack_start(self._footer, False, False, 0)

        self._rebuild()

    def _rebuild(self):
        query = self._search.get_text().strip().lower()
        entries = self._history.all_entries()
        filtered = [
            (i, e) for i, e in enumerate(entries)
            if not query
            or (e.type == 'text' and query in e.text.lower())
            or (e.type == 'image' and 'image' in query)
        ]
        for child in self._listbox.get_children():
            self._listbox.remove(child)
        for orig_idx, entry in filtered:
            self._listbox.add(self._make_row(orig_idx, entry))
        self._listbox.show_all()
        n = len(entries); s = len(filtered)
        self._footer.set_text(f'{s}/{n} items' if query else
                              f'{n} item{"s" if n != 1 else ""}')

    def _make_row(self, orig_idx: int, entry: ClipboardEntry) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row._orig_idx = orig_idx
        row.get_style_context().add_class('cb-item')

        hbox = Gtk.Box(spacing=6)

        pin_lbl = Gtk.Label(label='📌' if entry.pinned else '', xalign=0)
        pin_lbl.set_width_chars(2)
        hbox.pack_start(pin_lbl, False, False, 0)

        if entry.type == 'image':
            content = self._image_widget(entry.image_path)
        else:
            preview = entry.text[:PREVIEW_CHARS].replace('\n', '↵').replace('\t', '→')
            if len(entry.text) > PREVIEW_CHARS:
                preview += '…'
            content = Gtk.Label(label=preview, xalign=0)
            content.set_line_wrap(True)
            content.set_line_wrap_mode(2)
            content.set_max_width_chars(36)
            content.set_lines(3)
            content.get_style_context().add_class('cb-text')
        hbox.pack_start(content, True, True, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        right.set_valign(Gtk.Align.START)
        ts_lbl = Gtk.Label(label=_fmt_time(entry.timestamp), xalign=1)
        ts_lbl.get_style_context().add_class('cb-ts')
        right.pack_start(ts_lbl, False, False, 0)
        btn_box = Gtk.Box()
        pin_btn = Gtk.Button(label='🔓' if entry.pinned else '📌')
        pin_btn.set_relief(Gtk.ReliefStyle.NONE)
        pin_btn.connect('clicked', self._on_pin, orig_idx)
        del_btn = Gtk.Button(label='✕')
        del_btn.set_relief(Gtk.ReliefStyle.NONE)
        del_btn.connect('clicked', self._on_delete, orig_idx)
        btn_box.pack_start(pin_btn, False, False, 0)
        btn_box.pack_start(del_btn, False, False, 0)
        right.pack_start(btn_box, False, False, 0)
        hbox.pack_end(right, False, False, 0)

        row.add(hbox)
        return row

    def _image_widget(self, image_path: str) -> Gtk.Widget:
        box = Gtk.Box(spacing=6)
        if image_path and Path(image_path).exists():
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(image_path)
                w, h = pb.get_width(), pb.get_height()
                if h > 0:
                    nw = max(1, int(w * THUMB_HEIGHT / h))
                    pb = pb.scale_simple(nw, THUMB_HEIGHT, GdkPixbuf.InterpType.BILINEAR)
                box.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
            except Exception:
                pass
        lbl = Gtk.Label(label='🖼 Image', xalign=0)
        lbl.get_style_context().add_class('cb-text')
        box.pack_start(lbl, False, False, 0)
        return box

    # ---- Actions ----

    def _do_copy(self, orig_idx: int):
        entries = self._history.all_entries()
        if 0 <= orig_idx < len(entries):
            e = entries[orig_idx]
            if _active_monitor:
                _active_monitor.suppress(1000)
            if e.type == 'text':
                _set_clipboard_text(e.text)
            elif e.type == 'image' and e.image_path:
                _set_clipboard_image(e.image_path)

    def _on_activate(self, listbox, row):
        self._do_copy(row._orig_idx)
        if _has_auto_paste_tool():
            # Close popup first so focus returns to previous app, then paste
            self.destroy()
            threading.Thread(target=_try_auto_paste, daemon=True).start()
        else:
            # Show brief "Copied!" status then close
            self._footer.set_text('✓ Copied — press Ctrl+V to paste')
            GLib.timeout_add(500, self.destroy)

    def _on_pin(self, btn, orig_idx):
        self._history.toggle_pin(orig_idx)
        self._rebuild()

    def _on_delete(self, btn, orig_idx):
        if _active_monitor:
            _active_monitor.suppress(1000)
        self._history.delete(orig_idx)
        self._rebuild()

    def _on_clear_all(self, btn):
        dlg = Gtk.MessageDialog(transient_for=self, flags=Gtk.DialogFlags.MODAL,
                                message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.YES_NO,
                                text='Clear all unpinned items?')
        dlg.format_secondary_text('Pinned items will be kept.')
        resp = dlg.run()
        dlg.destroy()
        if resp == Gtk.ResponseType.YES:
            if _active_monitor:
                _active_monitor.suppress(500)
            self._history.clear_unpinned()
            self._rebuild()

    def _on_settings(self, btn):
        conf = load_clipboard_conf()
        current = conf.get('popup_position', POPUP_POSITION_DEFAULT)

        dlg = Gtk.Dialog(title='Cài đặt Clipboard History', transient_for=self,
                         flags=Gtk.DialogFlags.MODAL)
        dlg.set_resizable(False)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(16); box.set_margin_bottom(8)
        box.set_margin_start(16); box.set_margin_end(16)

        box.pack_start(Gtk.Label(label='Vị trí hiển thị popup:', xalign=0),
                       False, False, 0)

        radio_mouse = Gtk.RadioButton.new_with_label(None,
            '🖱  Gần con trỏ chuột (mặc định)')
        radio_corner = Gtk.RadioButton.new_with_label_from_widget(radio_mouse,
            '📐  Góc dưới-phải màn hình')

        if current == 'corner':
            radio_corner.set_active(True)
        else:
            radio_mouse.set_active(True)

        box.pack_start(radio_mouse,  False, False, 0)
        box.pack_start(radio_corner, False, False, 0)

        dlg.add_buttons('Huỷ', Gtk.ResponseType.CANCEL,
                        'Lưu', Gtk.ResponseType.OK)
        dlg.get_widget_for_response(Gtk.ResponseType.OK) \
           .get_style_context().add_class('suggested-action')
        dlg.show_all()
        resp = dlg.run()
        if resp == Gtk.ResponseType.OK:
            conf['popup_position'] = 'corner' if radio_corner.get_active() else 'mouse'
            save_clipboard_conf(conf)
        dlg.destroy()

    # ---- Keyboard ----

    def _on_key_press(self, widget, event):
        k = event.keyval
        if k == Gdk.KEY_Escape:
            self.destroy(); return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            row = self._listbox.get_selected_row()
            if row:
                self._do_copy(row._orig_idx)
                if _has_auto_paste_tool():
                    self.destroy()
                    threading.Thread(target=_try_auto_paste, daemon=True).start()
                else:
                    self._footer.set_text('✓ Copied — press Ctrl+V to paste')
                    GLib.timeout_add(500, self.destroy)
                return True
        if k == Gdk.KEY_Up:
            self._move_sel(-1); return True
        if k == Gdk.KEY_Down:
            self._move_sel(1); return True
        return False

    def _move_sel(self, d: int):
        rows = self._listbox.get_children()
        if not rows: return
        sel = self._listbox.get_selected_row()
        idx = rows.index(sel) if sel in rows else (-1 if d > 0 else len(rows))
        self._listbox.select_row(rows[max(0, min(len(rows) - 1, idx + d))])

    def _on_drag(self, widget, event):
        if event.button == 1:
            self.begin_move_drag(event.button, int(event.x_root),
                                 int(event.y_root), event.time)

