#!/usr/bin/env python3
"""CBAKey Screenshot Settings — configure screenshot preferences."""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk

import os
import subprocess
from pathlib import Path

# ─── Paths ────────────────────────────────────────────────────────────────────

def _config_dir() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'cbakey'
    d.mkdir(parents=True, exist_ok=True)
    return d

SCREENSHOT_CONF = _config_dir() / 'screenshot.conf'

_DEFAULTS = {
    'save_path':       str(Path.home() / 'Pictures' / 'Screenshots'),
    'ask_before_save': 'true',
    'auto_save':       'false',
    'hotkey':          'super+shift+s',
}

def load_conf() -> dict:
    conf = dict(_DEFAULTS)
    if SCREENSHOT_CONF.exists():
        for line in SCREENSHOT_CONF.read_text().splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                k, _, v = line.partition('=')
                conf[k.strip()] = v.strip()
    return conf

def save_conf(conf: dict):
    SCREENSHOT_CONF.write_text(
        '\n'.join(f'{k}={v}' for k, v in conf.items()) + '\n'
    )

# ─── UI ───────────────────────────────────────────────────────────────────────

_CSS = b"""
window { background-color: #2b2b2b; }
label  { color: #e0e0e0; }
label.section { font-weight: bold; color: #ffffff; font-size: 13px; margin-top: 8px; }
label.hint    { color: #888888; font-size: 11px; }
entry  { background: #3c3c3c; color: #e0e0e0; border-radius: 5px; border: 1px solid #555; }
button.suggested-action { background: #4a90d9; color: white; border-radius: 5px; }
button.suggested-action:hover { background: #5aa0e9; }
"""

class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title='CBAKey — Screenshot Settings')
        self.set_default_size(460, 380)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)

        css = Gtk.CssProvider()
        css.load_from_data(_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self._conf = load_conf()
        self._build_ui()
        self.connect('destroy', Gtk.main_quit)
        self.show_all()

    def _build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_top(20)
        vbox.set_margin_bottom(20)
        vbox.set_margin_start(24)
        vbox.set_margin_end(24)

        # ── Section: Phím tắt ─────────────────────────────────────────────────
        vbox.pack_start(self._section_label('Phím tắt'), False, False, 0)

        hotkey_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hotkey_row.set_margin_top(6)
        lbl = Gtk.Label(label='Phím tắt chụp màn hình:')
        lbl.set_xalign(0)
        lbl.set_size_request(200, -1)
        hotkey_row.pack_start(lbl, False, False, 0)
        self._hotkey_entry = Gtk.Entry()
        self._hotkey_entry.set_text(self._conf.get('hotkey', 'super+shift+s'))
        self._hotkey_entry.set_tooltip_text('Ví dụ: super+shift+s, ctrl+shift+p')
        hotkey_row.pack_start(self._hotkey_entry, True, True, 0)
        vbox.pack_start(hotkey_row, False, False, 0)

        hint = Gtk.Label(label='Dùng dấu + để kết hợp phím. Modifier hợp lệ: super, ctrl, alt, shift')
        hint.get_style_context().add_class('hint')
        hint.set_xalign(0)
        hint.set_margin_top(2)
        vbox.pack_start(hint, False, False, 0)

        # ── Section: Lưu trữ ─────────────────────────────────────────────────
        vbox.pack_start(self._section_label('Lưu trữ'), False, False, 0)

        # Save path
        path_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        path_row.set_margin_top(6)
        lbl2 = Gtk.Label(label='Thư mục lưu ảnh:')
        lbl2.set_xalign(0)
        lbl2.set_size_request(200, -1)
        path_row.pack_start(lbl2, False, False, 0)
        self._path_entry = Gtk.Entry()
        self._path_entry.set_text(self._conf.get('save_path', str(Path.home() / 'Pictures' / 'Screenshots')))
        path_row.pack_start(self._path_entry, True, True, 0)
        browse_btn = Gtk.Button(label='…')
        browse_btn.connect('clicked', self._on_browse)
        path_row.pack_start(browse_btn, False, False, 0)
        vbox.pack_start(path_row, False, False, 0)

        vbox.pack_start(Gtk.Separator(), False, False, 10)

        # Ask before save toggle
        ask_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        ask_lbl = Gtk.Label(label='Hỏi trước khi lưu ảnh')
        ask_lbl.set_xalign(0)
        ask_row.pack_start(ask_lbl, True, True, 0)
        self._ask_switch = Gtk.Switch()
        self._ask_switch.set_active(self._conf.get('ask_before_save', 'true').lower() == 'true')
        self._ask_switch.set_valign(Gtk.Align.CENTER)
        self._ask_switch.connect('notify::active', self._on_ask_toggle)
        ask_row.pack_start(self._ask_switch, False, False, 0)
        vbox.pack_start(ask_row, False, False, 0)

        # Auto save toggle
        auto_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        auto_lbl = Gtk.Label(label='Tự động lưu (không hỏi)')
        auto_lbl.set_xalign(0)
        auto_row.pack_start(auto_lbl, True, True, 0)
        self._auto_switch = Gtk.Switch()
        self._auto_switch.set_active(self._conf.get('auto_save', 'false').lower() == 'true')
        self._auto_switch.set_valign(Gtk.Align.CENTER)
        auto_row.pack_start(self._auto_switch, False, False, 0)
        vbox.pack_start(auto_row, False, False, 0)

        auto_hint = Gtk.Label(label='Bật "Tự động lưu" sẽ tắt hộp hỏi và lưu ngay vào thư mục trên')
        auto_hint.get_style_context().add_class('hint')
        auto_hint.set_xalign(0)
        auto_hint.set_margin_top(2)
        vbox.pack_start(auto_hint, False, False, 0)

        # ── Section: Công cụ ──────────────────────────────────────────────────
        vbox.pack_start(self._section_label('Công cụ hệ thống'), False, False, 0)

        tools = [
            ('grim', 'Capture Wayland'),
            ('slurp', 'Region selector Wayland'),
            ('maim', 'Capture X11'),
            ('wl-copy', 'Clipboard Wayland'),
            ('xclip', 'Clipboard X11'),
            ('notify-send', 'Notification'),
        ]
        import shutil
        tools_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        tools_box.set_margin_top(6)
        for tool, desc in tools:
            found = bool(shutil.which(tool))
            icon = '✓' if found else '✗'
            color = '#4caf50' if found else '#f44336'
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label()
            name_lbl.set_markup(f'<span foreground="{color}">{icon} {tool}</span>')
            name_lbl.set_xalign(0)
            desc_lbl = Gtk.Label(label=desc)
            desc_lbl.get_style_context().add_class('hint')
            desc_lbl.set_xalign(0)
            col.pack_start(name_lbl, False, False, 0)
            col.pack_start(desc_lbl, False, False, 0)
            tools_box.pack_start(col, False, False, 0)
        vbox.pack_start(tools_box, False, False, 0)

        # ── Buttons ───────────────────────────────────────────────────────────
        vbox.pack_start(Gtk.Separator(), False, False, 14)
        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)

        test_btn = Gtk.Button(label='Chụp thử')
        test_btn.connect('clicked', self._on_test)
        btn_row.pack_start(test_btn, False, False, 0)

        cancel_btn = Gtk.Button(label='Huỷ')
        cancel_btn.connect('clicked', lambda *_: self.destroy())
        btn_row.pack_start(cancel_btn, False, False, 0)

        save_btn = Gtk.Button(label='Lưu cài đặt')
        save_btn.get_style_context().add_class('suggested-action')
        save_btn.connect('clicked', self._on_save)
        btn_row.pack_start(save_btn, False, False, 0)

        vbox.pack_start(btn_row, False, False, 0)
        self.add(vbox)

    def _section_label(self, text: str) -> Gtk.Label:
        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class('section')
        lbl.set_xalign(0)
        lbl.set_margin_top(12)
        lbl.set_margin_bottom(4)
        return lbl

    def _on_ask_toggle(self, switch, _param):
        if switch.get_active():
            self._auto_switch.set_active(False)

    def _on_browse(self, *_):
        dlg = Gtk.FileChooserDialog(
            title='Chọn thư mục lưu ảnh',
            parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons('Huỷ', Gtk.ResponseType.CANCEL, 'Chọn', Gtk.ResponseType.OK)
        dlg.set_current_folder(self._path_entry.get_text())
        if dlg.run() == Gtk.ResponseType.OK:
            self._path_entry.set_text(dlg.get_filename())
        dlg.destroy()

    def _on_save(self, *_):
        self._conf['hotkey']          = self._hotkey_entry.get_text().strip()
        self._conf['save_path']       = self._path_entry.get_text().strip()
        self._conf['ask_before_save'] = 'true' if self._ask_switch.get_active() else 'false'
        self._conf['auto_save']       = 'true' if self._auto_switch.get_active() else 'false'
        save_conf(self._conf)

        info = Gtk.MessageDialog(
            parent=self,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text='Đã lưu cài đặt.',
            secondary_text='Khởi động lại cbakey-screenshot-daemon để áp dụng phím tắt mới.',
        )
        info.run()
        info.destroy()
        self.destroy()

    def _on_test(self, *_):
        import shutil as sh
        tool = sh.which('cbakey-screenshot') or str(Path(__file__).parent / 'cbakey-screenshot')
        subprocess.Popen([tool], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    win = SettingsWindow()
    win.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()
