    background-color: rgba(0,0,0,0.55);
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 12px;
}
"""

class CaptureReviewOverlay(Gtk.Window):
    """Fullscreen overlay with the captured screenshot as background.

    Toolbar at top-centre:
      [✂ Vùng chọn]  → rubber-band crop
      [✓ Dùng ảnh này] → use full image
      [✕ Huỷ]
    """

    def __init__(self, screenshot_bytes: bytes, conf: dict):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self._conf   = conf
        self._full   = screenshot_bytes      # original fullscreen PNG
        self._done   = False
        self._mode   = 'toolbar'             # 'toolbar' | 'selecting'
        self._drag   = False
        self._sx = self._sy = self._cx = self._cy = 0.0

        # Load pixbuf
        loader = GdkPixbuf.PixbufLoader()
        loader.write(screenshot_bytes)
        loader.close()
        self._pb = loader.get_pixbuf()

        # Calculate display dimensions and scale factor.
        # For multi-monitor screenshots the pixbuf may be wider than one monitor.
        # We letterbox (fit inside monitor, preserve aspect ratio) so the image
        # is never stretched/squished regardless of monitor count.
        mon_w, mon_h = self._sw(), self._sh()
        pb_w, pb_h   = self._pb.get_width(), self._pb.get_height()
        scale_fit    = min(mon_w / pb_w, mon_h / pb_h)
        disp_w       = int(pb_w * scale_fit)
        disp_h       = int(pb_h * scale_fit)
        # Offset to center the letterboxed image on the monitor
        self._offset_x = (mon_w - disp_w) // 2
        self._offset_y = (mon_h - disp_h) // 2
        # scale from display coords → pixbuf coords
        self._scale    = pb_w / disp_w

        # CSS
        css = Gtk.CssProvider()
        css.load_from_data(_OVERLAY_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.get_style_context().add_class('review-win')
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        self.fullscreen()

        # ── Widgets ───────────────────────────────────────────────────────────
        gtk_ov = Gtk.Overlay()

        # Background: letterboxed screenshot centered on black background
        evbox = Gtk.EventBox()
        evbox.set_opacity(0.75)
        scaled = self._pb.scale_simple(disp_w, disp_h, GdkPixbuf.InterpType.BILINEAR)
        img_widget = Gtk.Image.new_from_pixbuf(scaled)
        img_widget.set_halign(Gtk.Align.CENTER)
        img_widget.set_valign(Gtk.Align.CENTER)
        evbox.add(img_widget)
        gtk_ov.add(evbox)

        self._fixed = Gtk.Fixed()
        gtk_ov.add_overlay(self._fixed)

        # Toolbar
        self._toolbar_box = self._build_toolbar()
        self._fixed.put(self._toolbar_box, 0, 0)

        # Selection box
        self._sel_box = Gtk.Box()
        self._sel_box.get_style_context().add_class('sel-box')
        self._sel_box.set_no_show_all(True)
        self._fixed.put(self._sel_box, 0, 0)

        # Size label
        self._size_lbl = Gtk.Label()
        self._size_lbl.get_style_context().add_class('size-lbl')
        self._size_lbl.set_no_show_all(True)
        self._fixed.put(self._size_lbl, 0, 0)

        # Hint label (visible only in selecting mode)
        self._hint_lbl = Gtk.Label(label='Kéo chuột để chọn vùng  •  Esc để quay lại')
        self._hint_lbl.get_style_context().add_class('hint-lbl')
        self._hint_lbl.set_no_show_all(True)
        self._fixed.put(self._hint_lbl, 0, 0)

        self.add(gtk_ov)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK   |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.KEY_PRESS_MASK
        )
        self.connect('button-press-event',   self._on_press)
        self.connect('button-release-event', self._on_release)
        self.connect('motion-notify-event',  self._on_motion)
        self.connect('key-press-event',      self._on_key)
        self.connect('realize',              self._on_realize)

        self.show_all()
        self._toolbar_box.show()
        self._sel_box.hide()
        self._size_lbl.hide()
        self._hint_lbl.hide()

    # ── Build toolbar ─────────────────────────────────────────────────────────

    def _build_toolbar(self) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        box.get_style_context().add_class('toolbar-box')
        box.set_margin_top(6); box.set_margin_bottom(6)
        box.set_margin_start(8); box.set_margin_end(8)

        for label, style, cb in [
            ('✂  Select area',    'tb',        self._start_region),
            ('✓  Use this image', 'tb ok',     self._use_full),
            ('✕  Cancel',          'tb cancel', self._cancel),
            ('⚙  Settings',      'tb',        self._open_settings),
        ]:
            btn = Gtk.Button(label=label)
            for cls in style.split():
                btn.get_style_context().add_class(cls)
            btn.connect('clicked', lambda _b, c=cb: c())
            box.pack_start(btn, False, False, 0)

        return box

    # ── Realize: position toolbar ─────────────────────────────────────────────

    def _on_realize(self, *_):
        self.show_all()
        self._toolbar_box.show()
        self._sel_box.hide()
        self._size_lbl.hide()
        self._hint_lbl.hide()
        GLib.idle_add(self._position_toolbar)
        GLib.idle_add(self._position_hint)

    def _position_toolbar(self):
        w = self._toolbar_box.get_preferred_size()[1].width
        self._fixed.move(self._toolbar_box, (self._sw() - w) // 2, 24)
        return False

    def _position_hint(self):
        w = self._hint_lbl.get_preferred_size()[1].width
        h = self._hint_lbl.get_preferred_size()[1].height
        self._fixed.move(self._hint_lbl, (self._sw() - w) // 2, self._sh() - h - 40)
        return False

    # ── Toolbar actions ───────────────────────────────────────────────────────

    def _open_settings(self):
        settings_tool = shutil.which('farolkey-screenshot-settings') or str(
            Path(__file__).parent / 'farolkey-screenshot-settings'
        )
        subprocess.Popen([settings_tool],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _start_region(self):
        self._mode = 'selecting'
        self._toolbar_box.hide()
        self._hint_lbl.show()
        GLib.idle_add(self._set_cursor, Gdk.CursorType.CROSSHAIR)

    def _use_full(self):
        if self._done:
            return
        self._done = True
        log.info('full image selected: %dx%d px',
                 self._pb.get_width(), self._pb.get_height())
        self.hide()
        GLib.idle_add(self._deliver, self._full)

    def _cancel(self):
        if self._done:
            return
        self._done = True
        log.info('capture cancelled')
        self.hide()
        GLib.idle_add(self._quit_clean)

    # ── Region selection mouse handlers ───────────────────────────────────────

    def _on_press(self, _w, event):
        if event.button != 1 or self._mode != 'selecting' or self._done:
            return
        self._drag = True
        self._sx = self._cx = event.x
        self._sy = self._cy = event.y
        self._update_sel()

    def _on_motion(self, _w, event):
        if not self._drag or self._mode != 'selecting' or self._done:
            return
        self._cx = event.x
        self._cy = event.y
        self._update_sel()

    def _display_to_pixbuf(self, dx: float, dy: float):
        """Convert display (window) coordinates → pixbuf coordinates, clamped."""
        px = int((dx - self._offset_x) * self._scale)
        py = int((dy - self._offset_y) * self._scale)
        pw, ph = self._pb.get_width(), self._pb.get_height()
        return max(0, min(px, pw)), max(0, min(py, ph))

    def _on_release(self, _w, event):
        if event.button != 1 or not self._drag or self._mode != 'selecting' or self._done:
            return
        self._done = True
        self._drag = False
        x  = int(min(self._sx, event.x))
        y  = int(min(self._sy, event.y))
        rw = int(abs(event.x - self._sx))
        rh = int(abs(event.y - self._sy))
        self.hide()
        if rw > 4 and rh > 4:
            sx, sy = self._display_to_pixbuf(x, y)
            ex, ey = self._display_to_pixbuf(x + rw, y + rh)
            GLib.idle_add(self._crop_and_deliver, sx, sy, ex - sx, ey - sy)
        else:
            GLib.idle_add(self._quit_clean)

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            if self._mode == 'selecting' and not self._done:
                # Go back to toolbar
                self._mode = 'toolbar'
                self._drag = False
                self._sel_box.hide()
                self._size_lbl.hide()
                self._hint_lbl.hide()
                self._toolbar_box.show()
                GLib.idle_add(self._set_cursor, Gdk.CursorType.ARROW)
            elif not self._done:
                self._cancel()
            return True
        return False

    # ── Selection widget update ───────────────────────────────────────────────

    def _update_sel(self):
        x  = int(min(self._sx, self._cx))
        y  = int(min(self._sy, self._cy))
        rw = int(abs(self._cx - self._sx))
        rh = int(abs(self._cy - self._sy))

        if rw > 2 and rh > 2:
            self._fixed.move(self._sel_box, x, y)
            self._sel_box.set_size_request(rw, rh)
            self._sel_box.show()

            # Size label shows actual pixel dimensions in the original screenshot
            ex, ey = self._display_to_pixbuf(x + rw, y + rh)
            sx2, sy2 = self._display_to_pixbuf(x, y)
            self._size_lbl.set_text(f' {ex - sx2} × {ey - sy2} ')
            lw = self._size_lbl.get_preferred_size()[1].width
            lx = x + rw + 6
            if lx + lw > self._sw():
                lx = x - lw - 6
            self._fixed.move(self._size_lbl, max(0, lx), y + 2)
            self._size_lbl.show()
        else:
            self._sel_box.hide()
            self._size_lbl.hide()

    # ── Delivery ──────────────────────────────────────────────────────────────

    def _crop_and_deliver(self, x, y, w, h):
        log.info('region selected: %dx%d at (%d,%d)', w, h, x, y)
        self.destroy()
        try:
            png = crop_pixbuf(self._pb, x, y, w, h)
        except Exception as e:
            log.error('crop failed: %s', e)
            show_error(str(e))
            return False
        finish(png, self._conf)
        return False

    def _deliver(self, png: bytes):
        self.destroy()
        finish(png, self._conf)
        return False

    def _quit_clean(self):
        self.destroy()
        Gtk.main_quit()
        return False

    # ── Helpers ───────────────────────────────────────────────────────────────

    def _set_cursor(self, cursor_type):
        gdk_win = self.get_window()
        if gdk_win:
            gdk_win.set_cursor(
                Gdk.Cursor.new_for_display(Gdk.Display.get_default(), cursor_type)
            )
        return False

    def _sw(self) -> int:
        m = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        return m.get_geometry().width

    def _sh(self) -> int:
        m = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        return m.get_geometry().height

# ─── Single-instance lock ────────────────────────────────────────────────────

import fcntl as _fcntl
_LOCK_PATH = '/tmp/farolkey-screenshot.lock'
_lock_fd   = None   # kept open for the lifetime of the process

def _acquire_lock() -> bool:
    """Return True if this process is the sole screenshot instance."""
    global _lock_fd
    try:
        _lock_fd = open(_LOCK_PATH, 'w')
        _fcntl.flock(_lock_fd, _fcntl.LOCK_EX | _fcntl.LOCK_NB)
        _lock_fd.write(str(os.getpid()))
        _lock_fd.flush()
        return True
    except OSError:
        return False   # another instance holds the lock

# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    if not _acquire_lock():
        # A screenshot overlay is already open — silently ignore the new request.
        log.debug('another instance running, exiting')
        sys.exit(0)

    conf = load_conf()

    skip_review   = '--fullscreen' in sys.argv
    direct_region = '--region'     in sys.argv
    capture_mode  = conf.get('capture_mode', 'all')
    log.info('screenshot started: capture_mode=%s, skip_review=%s', capture_mode, skip_review)

    def _on_captured(png: bytes):
        if skip_review:
            finish(png, conf)
            return
        overlay = CaptureReviewOverlay(png, conf)
        overlay.show_all()
        if direct_region:
            GLib.idle_add(overlay._start_region)

    def _capture_thread():
        try:
            png = capture_fullscreen(capture_mode)
            GLib.idle_add(_on_captured, png)
        except CaptureError as e:
            log.error('capture failed: %s', e)
            GLib.idle_add(show_error, str(e))

    # Capture immediately (in background thread so GTK loop can start)
    threading.Thread(target=_capture_thread, daemon=True).start()
    Gtk.main()

if __name__ == '__main__':
    main()
