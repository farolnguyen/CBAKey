# ─── Paths ────────────────────────────────────────────────────────────────────

def _config_dir() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

def _data_dir() -> Path:
    xdg = os.environ.get('XDG_DATA_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.local' / 'share'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

SCREENSHOT_CONF = _config_dir() / 'screenshot.conf'
SOCKET_PATH     = _data_dir() / 'clipboard.sock'

# ─── Config ───────────────────────────────────────────────────────────────────

_DEFAULTS = {
    'save_path':        str(Path.home() / 'Pictures' / 'Screenshots'),
    'ask_before_save':  'true',
    'auto_save':        'false',
    'hotkey':           'super+shift+s',
    'capture_mode':     'all',   # 'all' = all monitors | 'cursor' = monitor with cursor
    'instant_capture':  'false', # 'true' = confirm on mouse release; 'false' = review mode
    'hotkey_action':    'menu',  # 'menu' = show capture menu | 'fullscreen' | 'region'
    'show_notification': 'true',
}

def load_conf() -> dict:
    conf = dict(_DEFAULTS)
    if SCREENSHOT_CONF.exists():
        for line in SCREENSHOT_CONF.read_text().splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                k, _, v = line.partition('=')
                conf[k.strip()] = v.strip()
    return conf

def save_conf(conf: dict):
    SCREENSHOT_CONF.write_text(
        '\n'.join(f'{k}={v}' for k, v in conf.items()) + '\n'
    )

# ─── Platform detection ───────────────────────────────────────────────────────

_IS_WAYLAND = bool(
    os.environ.get('WAYLAND_DISPLAY') or
    os.environ.get('XDG_SESSION_TYPE', '').lower() == 'wayland'
)
_DESKTOP   = os.environ.get('XDG_CURRENT_DESKTOP', '').upper()
_IS_GNOME  = 'GNOME' in _DESKTOP
_GRIM      = shutil.which('grim')
_SLURP     = shutil.which('slurp')
_MAIM      = shutil.which('maim')
_WL_COPY   = shutil.which('wl-copy')
_XCLIP     = shutil.which('xclip')
_NOTIFY    = shutil.which('notify-send')
_GNOME_SS  = shutil.which('gnome-screenshot')
_CANBERRA  = shutil.which('canberra-gtk-play')
_PAPLAY    = shutil.which('paplay')
_SHUTTER_SOUND = '/usr/share/sounds/freedesktop/stereo/screen-capture.oga'

# ─── Capture backends ─────────────────────────────────────────────────────────

class CaptureError(Exception):
    pass

def _get_all_monitors_bounds():
    """Return (x, y, total_width, total_height) of the bounding box of all monitors."""
    display = Gdk.Display.get_default()
    n = display.get_n_monitors()
    if n == 0:
        m = display.get_primary_monitor() or display.get_monitor(0)
        geo = m.get_geometry()
        return geo.x, geo.y, geo.width, geo.height
    min_x = min_y = float('inf')
    max_x = max_y = float('-inf')
    for i in range(n):
        geo = display.get_monitor(i).get_geometry()
        min_x = min(min_x, geo.x)
        min_y = min(min_y, geo.y)
        max_x = max(max_x, geo.x + geo.width)
        max_y = max(max_y, geo.y + geo.height)
    return int(min_x), int(min_y), int(max_x - min_x), int(max_y - min_y)

def _get_cursor_monitor_bounds():
    """Return (x, y, width, height) of the monitor containing the pointer."""
    display = Gdk.Display.get_default()
    seat    = display.get_default_seat()
    pointer = seat.get_pointer()
    _, cx, cy = pointer.get_position()
    monitor = display.get_monitor_at_point(cx, cy)
    if monitor is None:
        monitor = display.get_primary_monitor() or display.get_monitor(0)
    geo = monitor.get_geometry()
    return geo.x, geo.y, geo.width, geo.height

def _gnome_capture(x: int, y: int, w: int, h: int) -> bytes:
    """Capture a specific rectangle via gnome-screenshot or gdbus area screenshot."""
    import tempfile
    fd, tmp = tempfile.mkstemp(suffix='.png')
    os.close(fd)
    try:
        # Try gdbus ScreenshotArea first (more precise for multi-monitor)
        r = subprocess.run(
            ['gdbus', 'call', '--session',
             '--dest', 'org.gnome.Shell',
             '--object-path', '/org/gnome/Shell/Screenshot',
             '--method', 'org.gnome.Shell.Screenshot.ScreenshotArea',
             str(x), str(y), str(w), str(h), 'false', tmp],
            capture_output=True, timeout=10,
        )
        if r.returncode == 0 and Path(tmp).stat().st_size > 0:
            return Path(tmp).read_bytes()
        # Fallback: full screenshot via gnome-screenshot
        if not _GNOME_SS:
            raise CaptureError(
                'GNOME Wayland cần gnome-screenshot.\n'
                'Cài đặt: sudo apt install gnome-screenshot'
            )
        r2 = subprocess.run([_GNOME_SS, '--file', tmp],
                            capture_output=True, timeout=10)
        if r2.returncode != 0:
            raise CaptureError(f'gnome-screenshot failed: {r2.stderr.decode().strip()}')
        data = Path(tmp).read_bytes()
        if not data:
            raise CaptureError('gnome-screenshot returned empty file')
        return data
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def capture_fullscreen(capture_mode: str = 'all') -> bytes:
    """Capture screenshot.
    capture_mode='all'    — all monitors combined (default)
    capture_mode='cursor' — only the monitor containing the cursor
    """
    if capture_mode == 'cursor':
        x, y, w, h = _get_cursor_monitor_bounds()
    else:
        x, y, w, h = _get_all_monitors_bounds()

    log.info('capture start: mode=%s, region=%dx%d+%d+%d', capture_mode, w, h, x, y)

    if _IS_WAYLAND:
        if _IS_GNOME:
            data = _gnome_capture(x, y, w, h)
            log.info('capture ok: %d bytes (gnome)', len(data))
            return data
        if _GRIM:
            # grim supports -g "x,y WxH" for specific region
            geo_arg = f'{x},{y} {w}x{h}'
            r = subprocess.run([_GRIM, '-g', geo_arg, '-'], capture_output=True)
            if r.returncode != 0:
                raise CaptureError(f'grim failed: {r.stderr.decode().strip()}')
            log.info('capture ok: %d bytes (grim)', len(r.stdout))
            return r.stdout
        raise CaptureError('Cần cài grim: sudo apt install grim')
    if _MAIM:
        if capture_mode == 'cursor':
            # maim supports --geometry=WxH+X+Y
            r = subprocess.run(
                [_MAIM, f'--geometry={w}x{h}+{x}+{y}'],
                capture_output=True,
            )
        else:
            r = subprocess.run([_MAIM], capture_output=True)
        if r.returncode != 0 or not r.stdout:
            raise CaptureError(f'maim failed: {r.stderr.decode().strip()}')
        log.info('capture ok: %d bytes (maim)', len(r.stdout))
        return r.stdout
    raise CaptureError('Cần cài maim: sudo apt install maim')

def crop_pixbuf(pixbuf: GdkPixbuf.Pixbuf, x: int, y: int, w: int, h: int) -> bytes:
    pw, ph = pixbuf.get_width(), pixbuf.get_height()
    x = max(0, min(x, pw - 1))
    y = max(0, min(y, ph - 1))
    w = max(1, min(w, pw - x))
    h = max(1, min(h, ph - y))
    cropped = pixbuf.new_subpixbuf(x, y, w, h)
    ok, data = cropped.save_to_bufferv('png', [], [])
    if not ok:
        raise CaptureError('Failed to encode cropped PNG')
    return bytes(data)

# ─── Clipboard + notifications ────────────────────────────────────────────────

def copy_to_clipboard(png: bytes):
    if _IS_WAYLAND and _WL_COPY:
        p = subprocess.Popen([_WL_COPY, '--type', 'image/png'], stdin=subprocess.PIPE)
        p.communicate(png)
    elif _XCLIP:
        p = subprocess.Popen(
            [_XCLIP, '-selection', 'clipboard', '-t', 'image/png'],
            stdin=subprocess.PIPE,
        )
        p.communicate(png)

def push_image_to_clipboard_history(png: bytes):
    """Send the PNG directly to the clipboard daemon's history.

    copy_to_clipboard() sets the X11/Wayland selection so other apps can
    paste, but the daemon's Gtk.Clipboard.wait_for_image() can fail to read
    large selections back (X11 INCR transfer limits) — pushing the bytes
    directly avoids that round-trip entirely.
    """
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2.0)
            s.connect(str(SOCKET_PATH))
            s.sendall(b'IMG ' + len(png).to_bytes(4, 'big') + png)
    except Exception:
        pass

def notify(msg: str):
    if _NOTIFY:
        subprocess.Popen([_NOTIFY, '-a', 'FarolKey', '-t', '2000', 'FarolKey', msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# ─── Capture effect (flash + shutter sound) ──────────────────────────────────

_FLASH_CSS     = b"window.flash-win { background-color: white; }"
_FLASH_OPACITY = 0.5

def _play_shutter_sound():
    if _CANBERRA:
        subprocess.Popen([_CANBERRA, '-i', 'screen-capture'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif _PAPLAY and os.path.exists(_SHUTTER_SOUND):
        subprocess.Popen([_PAPLAY, _SHUTTER_SOUND],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def _make_flash_window() -> Gtk.Window:
    w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    w.set_decorated(False)
    w.set_keep_above(True)
    w.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
    w.set_accept_focus(False)
    w.get_style_context().add_class('flash-win')
    return w

def _show_flash(w: Gtk.Window):
    """Show w, apply _FLASH_OPACITY, and raise it above other windows.

    Gtk.Widget.set_opacity() is a no-op for toplevel X11 windows in this GTK
    version — _NET_WM_WINDOW_OPACITY must be set via Gdk.Window.set_opacity()
    on the realized window, i.e. after show_all(). Under Mutter, plain
    Gdk.Window.raise_() does NOT restack undecorated/SPLASHSCREEN windows
    above an already-present()'d window (e.g. farolkey-settings) — only
    present()+raise_() together do. set_accept_focus(False) keeps present()
    from stealing keyboard focus from whatever app the user is using.
    """
    w.show_all()
    w.present()
    gdkwin = w.get_window()
    gdkwin.set_opacity(_FLASH_OPACITY)
    gdkwin.raise_()

def _flash_screen(region=None):
    """Briefly flash white, like a camera shutter.

    If region (ax, ay, aw, ah) in absolute logical coords is given, flash
    only that rectangle; otherwise flash every monitor fullscreen.
    """
    css = Gtk.CssProvider()
    css.load_from_data(_FLASH_CSS)
    display = Gdk.Display.get_default()
    screen  = display.get_default_screen()
    Gtk.StyleContext.add_provider_for_screen(
        screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    wins = []
    if region is not None:
        ax, ay, aw, ah = region
        w = _make_flash_window()
        w.set_default_size(aw, ah)
        w.move(ax, ay)
        _show_flash(w)
        wins.append(w)
    else:
        for i in range(max(1, display.get_n_monitors())):
            w = _make_flash_window()
            w.fullscreen_on_monitor(screen, i)
            _show_flash(w)
            wins.append(w)

    def _close():
        for w in wins:
            w.destroy()
        return False
    GLib.timeout_add(120, _close)

def play_capture_effect(region=None):
    _flash_screen(region)
    _play_shutter_sound()

def save_file(png: bytes, path: str) -> str:
    p = Path(path)
    p.mkdir(parents=True, exist_ok=True)
    fp = p / f'screenshot_{time.strftime("%Y%m%d_%H%M%S")}.png'
    fp.write_bytes(png)
    log.info('file saved: %s', str(fp))
    return str(fp)

# ─── Post-capture: clipboard + optional save dialog ──────────────────────────

def finish(png: bytes, conf: dict, region=None):
    """Copy to clipboard, notify, optionally save.

    region (ax, ay, aw, ah) in absolute logical coords, if given, restricts
    the capture-effect flash to that rectangle instead of the whole screen.
    """
    log.info('finish: %d bytes, auto_save=%s, ask=%s',
             len(png),
             conf.get('auto_save', 'false'),
             conf.get('ask_before_save', 'true'))
    copy_to_clipboard(png)
    push_image_to_clipboard_history(png)
    if conf.get('show_notification', 'true').lower() == 'true':
        notify('Screenshot copied')
    play_capture_effect(region)

    auto = conf.get('auto_save', 'false').lower() == 'true'
    ask  = conf.get('ask_before_save', 'true').lower() == 'true'

    if auto:
        fp = save_file(png, conf['save_path'])
        log.info('auto-saved: %s', fp)
        # Delay quit so the capture-effect flash window has time to render.
        GLib.timeout_add(150, Gtk.main_quit)
        return

    if ask:
        dlg = SaveDialog(png, conf)
        resp = dlg.run()
        no_ask = dlg.no_ask_checked
        dlg.destroy()
        if no_ask:
            conf['ask_before_save'] = 'false'
            save_conf(conf)
        if resp == Gtk.ResponseType.YES:
            fp = save_file(png, conf['save_path'])
            log.info('saved: %s', fp)
        else:
            log.info('save declined')
        Gtk.main_quit()
        return

    GLib.timeout_add(150, Gtk.main_quit)

def show_error(msg: str):
    dlg = Gtk.MessageDialog(
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text='Chụp màn hình thất bại',
        secondary_text=msg,
    )
    dlg.run()
    dlg.destroy()
    Gtk.main_quit()

# ─── Save dialog ──────────────────────────────────────────────────────────────

class SaveDialog(Gtk.Dialog):
    def __init__(self, png: bytes, conf: dict):
        super().__init__(title='Lưu ảnh chụp màn hình')
        self.set_modal(True)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)

        try:
            loader = GdkPixbuf.PixbufLoader.new_with_type('png')
            loader.write(png)
            loader.close()
            pb = loader.get_pixbuf()
            if pb.get_width() > 360:
                s = 360 / pb.get_width()
                pb = pb.scale_simple(360, int(pb.get_height() * s), GdkPixbuf.InterpType.BILINEAR)
            img = Gtk.Image.new_from_pixbuf(pb)
        except Exception:
            img = Gtk.Image.new_from_icon_name('image-x-generic', Gtk.IconSize.DIALOG)

        box = self.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(16); box.set_margin_bottom(8)
        box.set_margin_start(16); box.set_margin_end(16)
        box.pack_start(img, False, False, 0)
        box.pack_start(Gtk.Label(label='Bạn có muốn lưu ảnh chụp màn hình không?'), False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.pack_start(Gtk.Label(label='Lưu vào:'), False, False, 0)
        lbl = Gtk.Label(label=conf.get('save_path', ''))
        lbl.set_ellipsize(3)
        row.pack_start(lbl, True, True, 0)
        box.pack_start(row, False, False, 0)

        self._cb = Gtk.CheckButton(label='Không hỏi lại (thay đổi trong Screenshot Settings)')
        box.pack_start(self._cb, False, False, 0)

        self.add_buttons('Không lưu', Gtk.ResponseType.NO, 'Lưu', Gtk.ResponseType.YES)
        self.get_widget_for_response(Gtk.ResponseType.YES).get_style_context().add_class('suggested-action')
        self.set_default_response(Gtk.ResponseType.YES)
        self.show_all()

    @property
    def no_ask_checked(self) -> bool:
        return self._cb.get_active()

