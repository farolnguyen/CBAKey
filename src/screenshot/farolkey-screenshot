class _SelState:
    """Selection state shared across all MonitorOverlay windows (absolute logical coords)."""
    __slots__ = ('mode', 'dragging', 'sx', 'sy', 'ex', 'ey')

    def __init__(self):
        self.mode     = 'toolbar'   # 'toolbar' | 'selecting'
        self.dragging = False
        self.sx = self.sy = self.ex = self.ey = 0

    def rect(self):
        """Return (x, y, w, h) in absolute logical coords, normalised."""
        x = min(self.sx, self.ex)
        y = min(self.sy, self.ey)
        return x, y, abs(self.ex - self.sx), abs(self.ey - self.sy)


class MonitorOverlay(Gtk.Window):
    """One fullscreen overlay window for a single monitor."""

    def __init__(self, mon_idx: int, geo,
                 mon_pb: 'GdkPixbuf.Pixbuf',
                 has_toolbar: bool,
                 sel: '_SelState', overlays: list,
                 on_confirm, on_cancel,
                 instant_capture: bool = False):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self._idx             = mon_idx
        self._geo             = geo       # Gdk.Rectangle in logical coords
        self._pb              = mon_pb    # already sized to geo.width × geo.height
        self._sel             = sel
        self._overlays        = overlays  # shared list; populated after all overlays built
        self._on_confirm      = on_confirm
        self._on_cancel       = on_cancel
        self._done            = False
        self._instant_capture = instant_capture
        self._rev_drag        = None  # dict when dragging in review mode

        _css = Gtk.CssProvider()
        _css.load_from_data(_OVERLAY_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), _css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.get_style_context().add_class('review-win')
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        self.fullscreen_on_monitor(self.get_screen(), mon_idx)

        gtk_ov = Gtk.Overlay()

        # Background: screenshot at 75% opacity
        bg_evbox = Gtk.EventBox()
        bg_evbox.set_opacity(0.75)
        self._bg_img = Gtk.Image.new_from_pixbuf(mon_pb)
        bg_evbox.add(self._bg_img)
        gtk_ov.add(bg_evbox)

        self._fixed = Gtk.Fixed()
        gtk_ov.add_overlay(self._fixed)
        self.add(gtk_ov)

        # Full-brightness sub-image inside the selection (sits on top of dimmed bg)
        self._sel_img_box = Gtk.EventBox()
        self._sel_img_box.set_no_show_all(True)
        self._sel_img = Gtk.Image()
        self._sel_img_box.add(self._sel_img)
        self._fixed.put(self._sel_img_box, 0, 0)

        # Selection border box (CSS .sel-box)
        self._sel_box = Gtk.Box()
        self._sel_box.get_style_context().add_class('sel-box')
        self._sel_box.set_no_show_all(True)
        self._fixed.put(self._sel_box, 0, 0)

        self._toolbar_box = None
        if has_toolbar:
            self._toolbar_box = self._build_toolbar()
            self._fixed.put(self._toolbar_box, 0, 0)

        self._size_lbl = Gtk.Label()
        self._size_lbl.get_style_context().add_class('size-lbl')
        self._size_lbl.set_no_show_all(True)
        self._fixed.put(self._size_lbl, 0, 0)

        self._hint_lbl = Gtk.Label(
            label='Kéo chuột để chọn vùng  •  Esc để huỷ'
        )
        self._hint_lbl.get_style_context().add_class('hint-lbl')
        self._hint_lbl.set_no_show_all(True)
        self._fixed.put(self._hint_lbl, 0, 0)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK   |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.KEY_PRESS_MASK
        )
        self.connect('button-press-event',   self._on_press)
        self.connect('button-release-event', self._on_release)
        self.connect('motion-notify-event',  self._on_motion)
        self.connect('key-press-event',      self._on_key)
        self.connect('realize',              self._on_realize)

    # ── Toolbar ───────────────────────────────────────────────────────────────

    def _build_toolbar(self) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        box.get_style_context().add_class('toolbar-box')
        box.set_margin_top(6); box.set_margin_bottom(6)
        box.set_margin_start(8); box.set_margin_end(8)
        for lbl, style, cb in [
            ('✂  Select area',    'tb',        self._act_start_region),
            ('✓  Use this image', 'tb ok',     self._act_use_full),
            ('✕  Cancel',          'tb cancel', self._act_cancel),
            ('⚙  Settings',      'tb',        self._act_settings),
        ]:
            btn = Gtk.Button(label=lbl)
            for cls in style.split():
                btn.get_style_context().add_class(cls)
            btn.connect('clicked', lambda _b, c=cb: c())
            box.pack_start(btn, False, False, 0)
        return box

    def _on_realize(self, *_):
        self.show_all()
        self._size_lbl.hide()
        self._hint_lbl.hide()
        # Raise above other keep_above windows (e.g. farolkey-settings, which
        # may already be open and on top) so region selection stays usable.
        # NOTE: present() was tried here too but it interferes with the
        # fullscreen_on_monitor() handshake — the overlay ends up as a
        # normal floating window below the GNOME top bar/dock instead of
        # true fullscreen. raise_() alone doesn't restack above an
        # already-present()'d Settings window, but it's harmless and is
        # the best available trade-off until a non-present() fix is found.
        self.get_window().raise_()
        GLib.idle_add(self._position_toolbar)
        GLib.idle_add(self._position_hint)

    def _position_toolbar(self):
        if self._toolbar_box:
            w = self._toolbar_box.get_preferred_size()[1].width
            self._fixed.move(self._toolbar_box, (self._geo.width - w) // 2, 24)
        return False

    def _position_hint(self):
        w = self._hint_lbl.get_preferred_size()[1].width
        h = self._hint_lbl.get_preferred_size()[1].height
        self._fixed.move(self._hint_lbl,
                         (self._geo.width - w) // 2,
                         self._geo.height - h - 40)
        return False

    # ── Toolbar actions ───────────────────────────────────────────────────────

    def _act_settings(self):
        tool = shutil.which('farolkey-settings') or str(
            Path(__file__).parent / 'farolkey-settings'
        )
        subprocess.Popen([tool, '--tab=screenshot'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _act_start_region(self):
        self._sel.mode = 'selecting'
        for ov in self._overlays:
            if ov._toolbar_box:
                ov._toolbar_box.hide()
            ov._hint_lbl.show()
            ov._set_cursor(Gdk.CursorType.CROSSHAIR)

    def _act_use_full(self):
        if self._done: return
        self._set_done()
        self._on_confirm(None)

    def _act_cancel(self):
        if self._done: return
        self._set_done()
        self._on_cancel()

    def _set_done(self):
        for ov in self._overlays:
            ov._done = True

    # ── Review-mode helpers ───────────────────────────────────────────────────

    _REVIEW_HANDLE = 14  # px — hit zone for corner / edge handles

    def _review_hit_test(self, ax, ay):
        """Return (hit_type, ox1, oy1, ox2, oy2) for review-mode interaction.

        hit_type: 'move' | 'corner-tl/tr/bl/br' | 'edge-t/b/l/r' | None
        ox1/oy1/ox2/oy2: normalised selection rect at call time.
        """
        H = self._REVIEW_HANDLE
        sx, sy, sw, sh = self._sel.rect()
        x1, y1 = sx, sy
        x2, y2 = sx + sw, sy + sh
        # Corners (checked before edges to avoid overlap)
        if abs(ax - x1) <= H and abs(ay - y1) <= H: return 'corner-tl', x1, y1, x2, y2
        if abs(ax - x2) <= H and abs(ay - y1) <= H: return 'corner-tr', x1, y1, x2, y2
        if abs(ax - x1) <= H and abs(ay - y2) <= H: return 'corner-bl', x1, y1, x2, y2
        if abs(ax - x2) <= H and abs(ay - y2) <= H: return 'corner-br', x1, y1, x2, y2
        # Edges
        if x1 <= ax <= x2 and abs(ay - y1) <= H:    return 'edge-t', x1, y1, x2, y2
        if x1 <= ax <= x2 and abs(ay - y2) <= H:    return 'edge-b', x1, y1, x2, y2
        if y1 <= ay <= y2 and abs(ax - x1) <= H:    return 'edge-l', x1, y1, x2, y2
        if y1 <= ay <= y2 and abs(ax - x2) <= H:    return 'edge-r', x1, y1, x2, y2
        # Interior
        if x1 <= ax <= x2 and y1 <= ay <= y2:       return 'move',   x1, y1, x2, y2
        return None, x1, y1, x2, y2

    def _update_cursor_for_review(self, ax, ay):
        if ax is None:
            self._set_cursor(Gdk.CursorType.CROSSHAIR)
            return
        hit, *_ = self._review_hit_test(ax, ay)
        self._set_cursor({
            'corner-tl': Gdk.CursorType.TOP_LEFT_CORNER,
            'corner-tr': Gdk.CursorType.TOP_RIGHT_CORNER,
            'corner-bl': Gdk.CursorType.BOTTOM_LEFT_CORNER,
            'corner-br': Gdk.CursorType.BOTTOM_RIGHT_CORNER,
            'edge-t':    Gdk.CursorType.TOP_SIDE,
            'edge-b':    Gdk.CursorType.BOTTOM_SIDE,
            'edge-l':    Gdk.CursorType.LEFT_SIDE,
            'edge-r':    Gdk.CursorType.RIGHT_SIDE,
            'move':      Gdk.CursorType.FLEUR,
        }.get(hit, Gdk.CursorType.CROSSHAIR))

    # ── Mouse handlers ────────────────────────────────────────────────────────

    def _to_abs(self, lx, ly):
        return self._geo.x + int(lx), self._geo.y + int(ly)

    def _on_press(self, _w, event):
        if event.button != 1 or self._done:
            return
        ax, ay = self._to_abs(event.x, event.y)

        if self._sel.mode == 'selecting':
            self._sel.dragging = True
            self._sel.sx = self._sel.ex = ax
            self._sel.sy = self._sel.ey = ay
            self._update_all_sel_visuals()

        elif self._sel.mode == 'review':
            hit, ox1, oy1, ox2, oy2 = self._review_hit_test(ax, ay)
            if hit is None:
                # Click outside selection → start a fresh drag
                self._sel.mode = 'selecting'
                self._rev_drag = None
                _sel_hint = 'Kéo chuột để chọn vùng  •  Esc để huỷ'
                for ov in self._overlays:
                    ov._hint_lbl.set_text(_sel_hint)
                    ov._size_lbl.hide()
                    ov._sel_box.hide()
                    ov._sel_img_box.hide()
                    ov._set_cursor(Gdk.CursorType.CROSSHAIR)
                    GLib.idle_add(ov._position_hint)
                self._sel.dragging = True
                self._sel.sx = self._sel.ex = ax
                self._sel.sy = self._sel.ey = ay
            else:
                self._rev_drag = {
                    'mode': hit,
                    'start_ax': ax, 'start_ay': ay,
                    'ox1': ox1, 'oy1': oy1, 'ox2': ox2, 'oy2': oy2,
                }

    def _on_motion(self, _w, event):
        ax, ay = self._to_abs(event.x, event.y)

        if self._sel.mode == 'selecting' and self._sel.dragging and not self._done:
            self._sel.ex = ax
            self._sel.ey = ay
            self._update_all_sel_visuals()
            self._update_size_labels()

        elif self._sel.mode == 'review' and not self._done:
            if self._rev_drag:
                d = self._rev_drag
                m = d['mode']
                ox1, oy1, ox2, oy2 = d['ox1'], d['oy1'], d['ox2'], d['oy2']
                if m == 'move':
                    dx = ax - d['start_ax']; dy = ay - d['start_ay']
                    self._sel.sx = ox1 + dx; self._sel.sy = oy1 + dy
                    self._sel.ex = ox2 + dx; self._sel.ey = oy2 + dy
                elif m == 'corner-tl':
                    self._sel.sx = ax;  self._sel.sy = ay
                    self._sel.ex = ox2; self._sel.ey = oy2
                elif m == 'corner-tr':
                    self._sel.sx = ox1; self._sel.sy = ay
                    self._sel.ex = ax;  self._sel.ey = oy2
                elif m == 'corner-bl':
                    self._sel.sx = ax;  self._sel.sy = oy1
                    self._sel.ex = ox2; self._sel.ey = ay
                elif m == 'corner-br':
                    self._sel.sx = ox1; self._sel.sy = oy1
                    self._sel.ex = ax;  self._sel.ey = ay
                elif m == 'edge-t':
                    self._sel.sx = ox1; self._sel.sy = ay
                    self._sel.ex = ox2; self._sel.ey = oy2
                elif m == 'edge-b':
                    self._sel.sx = ox1; self._sel.sy = oy1
                    self._sel.ex = ox2; self._sel.ey = ay
                elif m == 'edge-l':
                    self._sel.sx = ax;  self._sel.sy = oy1
                    self._sel.ex = ox2; self._sel.ey = oy2
                elif m == 'edge-r':
                    self._sel.sx = ox1; self._sel.sy = oy1
                    self._sel.ex = ax;  self._sel.ey = oy2
                self._update_all_sel_visuals()
                self._update_size_labels()
            else:
                self._update_cursor_for_review(ax, ay)

    def _on_release(self, _w, event):
        if event.button != 1 or self._done:
            return
        ax, ay = self._to_abs(event.x, event.y)

        if self._sel.mode == 'selecting' and self._sel.dragging:
            self._sel.ex = ax
            self._sel.ey = ay
            self._sel.dragging = False
            self._update_all_sel_visuals()
            self._update_size_labels()
            x, y, w, h = self._sel.rect()
            if w > 4 and h > 4:
                if self._instant_capture:
                    self._set_done()
                    GLib.idle_add(self._deliver_region, x, y, w, h)
                else:
                    self._sel.mode = 'review'
                    _hint = ('Kéo góc/cạnh để chỉnh  •  Kéo trong vùng để di chuyển'
                             '  •  Enter để xác nhận  •  Esc để chọn lại')
                    for ov in self._overlays:
                        ov._hint_lbl.set_text(_hint)
                        ov._hint_lbl.show()
                        ov._rev_drag = None
                        GLib.idle_add(ov._position_hint)
                    self._update_cursor_for_review(ax, ay)

        elif self._sel.mode == 'review' and self._rev_drag:
            self._rev_drag = None
            self._update_cursor_for_review(ax, ay)

    def _on_key(self, _w, event):
        k = event.keyval
        if k == Gdk.KEY_Escape:
            if self._sel.mode == 'selecting' and not self._done:
                self._sel.mode     = 'toolbar'
                self._sel.dragging = False
                for ov in self._overlays:
                    if ov._toolbar_box:
                        ov._toolbar_box.show()
                    ov._hint_lbl.hide()
                    ov._size_lbl.hide()
                    ov._sel_box.hide()
                    ov._sel_img_box.hide()
                    ov._set_cursor(Gdk.CursorType.ARROW)
                    ov._rev_drag = None
            elif self._sel.mode == 'review' and not self._done:
                # Return to selecting mode — clear selection, allow a new drag
                self._sel.mode     = 'selecting'
                self._sel.dragging = False
                _sel_hint = 'Kéo chuột để chọn vùng  •  Esc để huỷ'
                for ov in self._overlays:
                    ov._hint_lbl.set_text(_sel_hint)
                    ov._size_lbl.hide()
                    ov._sel_box.hide()
                    ov._sel_img_box.hide()
                    ov._set_cursor(Gdk.CursorType.CROSSHAIR)
                    ov._rev_drag = None
                    GLib.idle_add(ov._position_hint)
            elif not self._done:
                self._act_cancel()
            return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self._sel.mode in ('selecting', 'review') and not self._done:
                x, y, w, h = self._sel.rect()
                if w > 4 and h > 4:
                    self._set_done()
                    GLib.idle_add(self._deliver_region, x, y, w, h)
                return True
        return False

    def _deliver_region(self, ax, ay, aw, ah):
        for ov in self._overlays:
            ov.hide()
        self._on_confirm((ax, ay, aw, ah))
        return False

    # ── Selection visuals ─────────────────────────────────────────────────────

    def _update_sel_visuals(self):
        """Update the sel-box border and bright inner image for this monitor."""
        sx, sy, sw, sh = self._sel.rect()
        geo = self._geo
        lx  = sx - geo.x
        ly  = sy - geo.y
        cx1 = max(0, lx)
        cy1 = max(0, ly)
        cx2 = min(lx + sw, geo.width)
        cy2 = min(ly + sh, geo.height)
        cw  = cx2 - cx1
        ch  = cy2 - cy1
        if cw > 2 and ch > 2:
            # Bright sub-image (zero-copy view into the monitor pixbuf)
            sub = self._pb.new_subpixbuf(cx1, cy1, cw, ch)
            self._sel_img.set_from_pixbuf(sub)
            self._fixed.move(self._sel_img_box, cx1, cy1)
            self._sel_img_box.show()
            # Border box
            self._fixed.move(self._sel_box, cx1, cy1)
            self._sel_box.set_size_request(cw, ch)
            self._sel_box.show()
        else:
            self._sel_img_box.hide()
            self._sel_box.hide()

    def _update_all_sel_visuals(self):
        for ov in self._overlays:
            ov._update_sel_visuals()

    def _update_size_labels(self):
        sx, sy, sw, sh = self._sel.rect()
        if sw < 4 or sh < 4:
            for ov in self._overlays:
                ov._size_lbl.hide()
            return
        ex, ey = self._sel.ex, self._sel.ey
        for ov in self._overlays:
            g = ov._geo
            if g.x <= ex < g.x + g.width and g.y <= ey < g.y + g.height:
                txt = f' {sw} × {sh} '
                ov._size_lbl.set_text(txt)
                lx = ex - g.x + 6
                ly = ey - g.y - 20
                lw = ov._size_lbl.get_preferred_size()[1].width
                if lx + lw > g.width:
                    lx = ex - g.x - lw - 6
                ov._fixed.move(ov._size_lbl, max(0, lx), max(0, ly))
                ov._size_lbl.show()
            else:
                ov._size_lbl.hide()

    def _set_cursor(self, cursor_type):
        gdk_win = self.get_window()
        if gdk_win:
            gdk_win.set_cursor(
                Gdk.Cursor.new_for_display(Gdk.Display.get_default(), cursor_type)
            )


class CaptureReviewOverlay:
    """Manages one MonitorOverlay per monitor for multi-monitor capture review.

    Public API matches the old single-window class so main() needs no changes:
      overlay = CaptureReviewOverlay(png, conf)
      overlay.show_all()
      overlay._start_region()   # optional
    """

    def __init__(self, screenshot_bytes: bytes, conf: dict):
        self._conf = conf
        self._full = screenshot_bytes
        self._done = False

        loader = GdkPixbuf.PixbufLoader()
        loader.write(screenshot_bytes)
        loader.close()
        self._pb = loader.get_pixbuf()

        display  = Gdk.Display.get_default()
        n        = max(1, display.get_n_monitors())
        geos     = [display.get_monitor(i).get_geometry() for i in range(n)]
        pb_ox    = min(g.x for g in geos)
        pb_oy    = min(g.y for g in geos)
        self._pb_ox = pb_ox
        self._pb_oy = pb_oy

        # Toolbar goes on the monitor that contains the cursor
        seat = display.get_default_seat()
        _, cx, cy = seat.get_pointer().get_position()
        cursor_mon = next(
            (i for i, g in enumerate(geos)
             if g.x <= cx < g.x + g.width and g.y <= cy < g.y + g.height),
            0
        )

        instant_capture = conf.get('instant_capture', 'false').lower() == 'true'

        sel            = _SelState()
        self._overlays: list = []
        pb_w = self._pb.get_width()
        pb_h = self._pb.get_height()

        for i, geo in enumerate(geos):
            # Slice the combined pixbuf to this monitor's area
            sx_ = max(0, geo.x - pb_ox)
            sy_ = max(0, geo.y - pb_oy)
            sw_ = min(geo.width,  pb_w - sx_)
            sh_ = min(geo.height, pb_h - sy_)
            if sw_ <= 0 or sh_ <= 0:
                sw_ = sh_ = 1
            mon_pb = self._pb.new_subpixbuf(sx_, sy_, sw_, sh_)
            # Scale to logical window size if capture resolution differs (HiDPI)
            if sw_ != geo.width or sh_ != geo.height:
                mon_pb = mon_pb.scale_simple(
                    geo.width, geo.height, GdkPixbuf.InterpType.BILINEAR
                )
            ov = MonitorOverlay(
                mon_idx=i, geo=geo,
                mon_pb=mon_pb,
                has_toolbar=(i == cursor_mon),
                sel=sel, overlays=self._overlays,
                on_confirm=self._on_confirm,
                on_cancel=self._on_cancel,
                instant_capture=instant_capture,
            )
            self._overlays.append(ov)

    def show_all(self):
        for ov in self._overlays:
            ov.show_all()

    def _start_region(self):
        if self._overlays:
            self._overlays[0]._act_start_region()

    def _on_confirm(self, region):
        if self._done: return
        self._done = True
        for ov in self._overlays:
            ov.destroy()
        if region is None:
            log.info('full image used: %d bytes', len(self._full))
            finish(self._full, self._conf)
            return
        ax, ay, aw, ah = region
        px = ax - self._pb_ox
        py = ay - self._pb_oy
        log.info('region selected: %dx%d abs=(%d,%d) pb=(%d,%d)', aw, ah, ax, ay, px, py)
        try:
            png = crop_pixbuf(self._pb, px, py, aw, ah)
        except Exception as e:
            log.error('crop failed: %s', e)
            show_error(str(e))
            return
        finish(png, self._conf, region=region)

    def _on_cancel(self):
        if self._done: return
        self._done = True
        log.info('capture cancelled')
        for ov in self._overlays:
            ov.destroy()
        Gtk.main_quit()

# ─── Single-instance lock ────────────────────────────────────────────────────

import fcntl as _fcntl
_LOCK_PATH = '/tmp/farolkey-screenshot.lock'
_lock_fd   = None   # kept open for the lifetime of the process

def _acquire_lock() -> bool:
    """Return True if this process is the sole screenshot instance."""
    global _lock_fd
    try:
        _lock_fd = open(_LOCK_PATH, 'w')
        _fcntl.flock(_lock_fd, _fcntl.LOCK_EX | _fcntl.LOCK_NB)
        _lock_fd.write(str(os.getpid()))
        _lock_fd.flush()
        return True
    except OSError:
        return False   # another instance holds the lock

# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    if not _acquire_lock():
        # A screenshot overlay is already open — silently ignore the new request.
        log.debug('another instance running, exiting')
        sys.exit(0)

    conf = load_conf()

    hotkey_action = conf.get('hotkey_action', 'menu')
    skip_review   = '--fullscreen' in sys.argv or hotkey_action == 'fullscreen'
    direct_region = '--region'     in sys.argv or hotkey_action == 'region'
    capture_mode  = conf.get('capture_mode', 'all')
    log.info('screenshot started: capture_mode=%s, skip_review=%s', capture_mode, skip_review)

    def _on_captured(png: bytes):
        if skip_review:
            finish(png, conf)
            return
        overlay = CaptureReviewOverlay(png, conf)
        overlay.show_all()
        if direct_region:
            GLib.idle_add(overlay._start_region)

    def _capture_thread():
        try:
            png = capture_fullscreen(capture_mode)
            GLib.idle_add(_on_captured, png)
        except CaptureError as e:
            log.error('capture failed: %s', e)
            GLib.idle_add(show_error, str(e))

    # Capture immediately (in background thread so GTK loop can start)
    threading.Thread(target=_capture_thread, daemon=True).start()
    Gtk.main()

if __name__ == '__main__':
    main()
