#!/usr/bin/env python3
"""FarolKey Screenshot — hotkey triggers instant capture → review overlay.

Flow:
  hotkey / CLI → capture fullscreen immediately → CaptureReviewOverlay
    [✂ Vùng chọn]  → rubber-band region select on the captured image → crop
    [✓ Dùng ảnh này] → use full screenshot
    [✕ Huỷ]          → cancel

Usage:
  farolkey-screenshot              # capture now, show review overlay
  farolkey-screenshot --fullscreen # capture fullscreen, skip review
  farolkey-screenshot --region     # capture fullscreen, go straight to region select
"""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

import os
import shutil
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Optional, Callable

# ─── Paths ────────────────────────────────────────────────────────────────────

def _config_dir() -> Path:
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

def _data_dir() -> Path:
    xdg = os.environ.get('XDG_DATA_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.local' / 'share'
    d = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

SCREENSHOT_CONF = _config_dir() / 'screenshot.conf'
SOCKET_PATH     = _data_dir() / 'clipboard.sock'

# ─── Config ───────────────────────────────────────────────────────────────────

_DEFAULTS = {
    'save_path':       str(Path.home() / 'Pictures' / 'Screenshots'),
    'ask_before_save': 'true',
    'auto_save':       'false',
    'hotkey':          'super+shift+s',
}

def load_conf() -> dict:
    conf = dict(_DEFAULTS)
    if SCREENSHOT_CONF.exists():
        for line in SCREENSHOT_CONF.read_text().splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                k, _, v = line.partition('=')
                conf[k.strip()] = v.strip()
    return conf

def save_conf(conf: dict):
    SCREENSHOT_CONF.write_text(
        '\n'.join(f'{k}={v}' for k, v in conf.items()) + '\n'
    )

# ─── Platform detection ───────────────────────────────────────────────────────

_IS_WAYLAND = bool(
    os.environ.get('WAYLAND_DISPLAY') or
    os.environ.get('XDG_SESSION_TYPE', '').lower() == 'wayland'
)
_DESKTOP   = os.environ.get('XDG_CURRENT_DESKTOP', '').upper()
_IS_GNOME  = 'GNOME' in _DESKTOP
_GRIM      = shutil.which('grim')
_SLURP     = shutil.which('slurp')
_MAIM      = shutil.which('maim')
_WL_COPY   = shutil.which('wl-copy')
_XCLIP     = shutil.which('xclip')
_NOTIFY    = shutil.which('notify-send')
_GNOME_SS  = shutil.which('gnome-screenshot')

# ─── Capture backends ─────────────────────────────────────────────────────────

class CaptureError(Exception):
    pass

def capture_fullscreen() -> bytes:
    if _IS_WAYLAND:
        if _IS_GNOME:
            if not _GNOME_SS:
                raise CaptureError(
                    'GNOME Wayland cần gnome-screenshot.\n'
                    'Cài đặt: sudo apt install gnome-screenshot'
                )
            import tempfile
            fd, tmp = tempfile.mkstemp(suffix='.png')
            os.close(fd)
            try:
                r = subprocess.run([_GNOME_SS, '--file', tmp],
                                   capture_output=True, timeout=10)
                if r.returncode != 0:
                    raise CaptureError(
                        f'gnome-screenshot failed: {r.stderr.decode().strip()}'
                    )
                data = Path(tmp).read_bytes()
                if not data:
                    raise CaptureError('gnome-screenshot returned empty file')
                return data
            finally:
                if os.path.exists(tmp):
                    os.unlink(tmp)
        if _GRIM:
            r = subprocess.run([_GRIM, '-'], capture_output=True)
            if r.returncode != 0:
                raise CaptureError(f'grim failed: {r.stderr.decode().strip()}')
            return r.stdout
        raise CaptureError('Cần cài grim: sudo apt install grim')
    if _MAIM:
        # maim outputs PNG to stdout when no filename is given (don't pass '-')
        r = subprocess.run([_MAIM], capture_output=True)
        if r.returncode != 0 or not r.stdout:
            raise CaptureError(f'maim failed: {r.stderr.decode().strip()}')
        return r.stdout
    raise CaptureError('Cần cài maim: sudo apt install maim')

def crop_pixbuf(pixbuf: GdkPixbuf.Pixbuf, x: int, y: int, w: int, h: int) -> bytes:
    pw, ph = pixbuf.get_width(), pixbuf.get_height()
    x = max(0, min(x, pw - 1))
    y = max(0, min(y, ph - 1))
    w = max(1, min(w, pw - x))
    h = max(1, min(h, ph - y))
    cropped = pixbuf.new_subpixbuf(x, y, w, h)
    ok, data = cropped.save_to_bufferv('png', [], [])
    if not ok:
        raise CaptureError('Failed to encode cropped PNG')
    return bytes(data)

# ─── Clipboard + notifications ────────────────────────────────────────────────

def copy_to_clipboard(png: bytes):
    if _IS_WAYLAND and _WL_COPY:
        p = subprocess.Popen([_WL_COPY, '--type', 'image/png'], stdin=subprocess.PIPE)
        p.communicate(png)
    elif _XCLIP:
        p = subprocess.Popen(
            [_XCLIP, '-selection', 'clipboard', '-t', 'image/png'],
            stdin=subprocess.PIPE,
        )
        p.communicate(png)

def ping_clipboard_daemon():
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(str(SOCKET_PATH))
            s.sendall(b'PING\n')
    except Exception:
        pass

def notify(msg: str):
    if _NOTIFY:
        subprocess.Popen([_NOTIFY, '-a', 'FarolKey', '-t', '2000', 'FarolKey', msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def save_file(png: bytes, path: str) -> str:
    p = Path(path)
    p.mkdir(parents=True, exist_ok=True)
    fp = p / f'screenshot_{time.strftime("%Y%m%d_%H%M%S")}.png'
    fp.write_bytes(png)
    return str(fp)

# ─── Post-capture: clipboard + optional save dialog ──────────────────────────

def finish(png: bytes, conf: dict):
    """Copy to clipboard, notify, optionally save."""
    copy_to_clipboard(png)
    ping_clipboard_daemon()
    notify('Screenshot copied')

    auto = conf.get('auto_save', 'false').lower() == 'true'
    ask  = conf.get('ask_before_save', 'true').lower() == 'true'

    if auto:
        save_file(png, conf['save_path'])
        Gtk.main_quit()
        return

    if ask:
        dlg = SaveDialog(png, conf)
        resp = dlg.run()
        no_ask = dlg.no_ask_checked
        dlg.destroy()
        if no_ask:
            conf['ask_before_save'] = 'false'
            save_conf(conf)
        if resp == Gtk.ResponseType.YES:
            save_file(png, conf['save_path'])

    Gtk.main_quit()

def show_error(msg: str):
    dlg = Gtk.MessageDialog(
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text='Chụp màn hình thất bại',
        secondary_text=msg,
    )
    dlg.run()
    dlg.destroy()
    Gtk.main_quit()

# ─── Save dialog ──────────────────────────────────────────────────────────────

class SaveDialog(Gtk.Dialog):
    def __init__(self, png: bytes, conf: dict):
        super().__init__(title='Lưu ảnh chụp màn hình')
        self.set_modal(True)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)

        try:
            loader = GdkPixbuf.PixbufLoader.new_with_type('png')
            loader.write(png)
            loader.close()
            pb = loader.get_pixbuf()
            if pb.get_width() > 360:
                s = 360 / pb.get_width()
                pb = pb.scale_simple(360, int(pb.get_height() * s), GdkPixbuf.InterpType.BILINEAR)
            img = Gtk.Image.new_from_pixbuf(pb)
        except Exception:
            img = Gtk.Image.new_from_icon_name('image-x-generic', Gtk.IconSize.DIALOG)

        box = self.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(16); box.set_margin_bottom(8)
        box.set_margin_start(16); box.set_margin_end(16)
        box.pack_start(img, False, False, 0)
        box.pack_start(Gtk.Label(label='Bạn có muốn lưu ảnh chụp màn hình không?'), False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.pack_start(Gtk.Label(label='Lưu vào:'), False, False, 0)
        lbl = Gtk.Label(label=conf.get('save_path', ''))
        lbl.set_ellipsize(3)
        row.pack_start(lbl, True, True, 0)
        box.pack_start(row, False, False, 0)

        self._cb = Gtk.CheckButton(label='Không hỏi lại (thay đổi trong Screenshot Settings)')
        box.pack_start(self._cb, False, False, 0)

        self.add_buttons('Không lưu', Gtk.ResponseType.NO, 'Lưu', Gtk.ResponseType.YES)
        self.get_widget_for_response(Gtk.ResponseType.YES).get_style_context().add_class('suggested-action')
        self.set_default_response(Gtk.ResponseType.YES)
        self.show_all()

    @property
    def no_ask_checked(self) -> bool:
        return self._cb.get_active()

# ─── Capture Review Overlay ───────────────────────────────────────────────────
# Shows captured screenshot fullscreen. User picks: crop region or use full image.

_OVERLAY_CSS = b"""
window.review-win { background-color: black; }

box.toolbar-box {
    background-color: rgba(28, 28, 28, 0.95);
    border-radius: 10px;
    padding: 2px 8px;
}
button.tb {
    background: transparent;
    border: none;
    color: white;
    padding: 8px 14px;
    font-size: 13px;
    border-radius: 6px;
}
button.tb:hover { background-color: rgba(255,255,255,0.15); }
button.tb.ok     { color: #69db7c; }
button.tb.cancel { color: #ff6b6b; }

box.sel-box {
    border: 2px solid rgba(60, 140, 255, 0.95);
    background-color: rgba(60, 140, 255, 0.12);
}
label.size-lbl {
    color: white;
    background-color: rgba(0,0,0,0.70);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: bold;
}
label.hint-lbl {
    color: rgba(255,255,255,0.70);
    background-color: rgba(0,0,0,0.55);
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 12px;
}
"""

class CaptureReviewOverlay(Gtk.Window):
    """Fullscreen overlay with the captured screenshot as background.

    Toolbar at top-centre:
      [✂ Vùng chọn]  → rubber-band crop
      [✓ Dùng ảnh này] → use full image
      [✕ Huỷ]
    """

    def __init__(self, screenshot_bytes: bytes, conf: dict):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self._conf   = conf
        self._full   = screenshot_bytes      # original fullscreen PNG
        self._done   = False
        self._mode   = 'toolbar'             # 'toolbar' | 'selecting'
        self._drag   = False
        self._sx = self._sy = self._cx = self._cy = 0.0

        # Load pixbuf
        loader = GdkPixbuf.PixbufLoader()
        loader.write(screenshot_bytes)
        loader.close()
        self._pb    = loader.get_pixbuf()
        self._scale = self._pb.get_width() / self._sw()

        # CSS
        css = Gtk.CssProvider()
        css.load_from_data(_OVERLAY_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.get_style_context().add_class('review-win')
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        self.fullscreen()

        # ── Widgets ───────────────────────────────────────────────────────────
        gtk_ov = Gtk.Overlay()

        # Background: screenshot (slightly dimmed)
        evbox = Gtk.EventBox()
        evbox.set_opacity(0.75)
        scaled = self._pb.scale_simple(self._sw(), self._sh(), GdkPixbuf.InterpType.BILINEAR)
        evbox.add(Gtk.Image.new_from_pixbuf(scaled))
        gtk_ov.add(evbox)

        self._fixed = Gtk.Fixed()
        gtk_ov.add_overlay(self._fixed)

        # Toolbar
        self._toolbar_box = self._build_toolbar()
        self._fixed.put(self._toolbar_box, 0, 0)

        # Selection box
        self._sel_box = Gtk.Box()
        self._sel_box.get_style_context().add_class('sel-box')
        self._sel_box.set_no_show_all(True)
        self._fixed.put(self._sel_box, 0, 0)

        # Size label
        self._size_lbl = Gtk.Label()
        self._size_lbl.get_style_context().add_class('size-lbl')
        self._size_lbl.set_no_show_all(True)
        self._fixed.put(self._size_lbl, 0, 0)

        # Hint label (visible only in selecting mode)
        self._hint_lbl = Gtk.Label(label='Kéo chuột để chọn vùng  •  Esc để quay lại')
        self._hint_lbl.get_style_context().add_class('hint-lbl')
        self._hint_lbl.set_no_show_all(True)
        self._fixed.put(self._hint_lbl, 0, 0)

        self.add(gtk_ov)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK   |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.KEY_PRESS_MASK
        )
        self.connect('button-press-event',   self._on_press)
        self.connect('button-release-event', self._on_release)
        self.connect('motion-notify-event',  self._on_motion)
        self.connect('key-press-event',      self._on_key)
        self.connect('realize',              self._on_realize)

        self.show_all()
        self._toolbar_box.show()
        self._sel_box.hide()
        self._size_lbl.hide()
        self._hint_lbl.hide()

    # ── Build toolbar ─────────────────────────────────────────────────────────

    def _build_toolbar(self) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        box.get_style_context().add_class('toolbar-box')
        box.set_margin_top(6); box.set_margin_bottom(6)
        box.set_margin_start(8); box.set_margin_end(8)

        for label, style, cb in [
            ('✂  Chọn vùng',    'tb',        self._start_region),
            ('✓  Dùng ảnh này', 'tb ok',     self._use_full),
            ('✕  Huỷ',          'tb cancel', self._cancel),
            ('⚙  Cài đặt',      'tb',        self._open_settings),
        ]:
            btn = Gtk.Button(label=label)
            for cls in style.split():
                btn.get_style_context().add_class(cls)
            btn.connect('clicked', lambda _b, c=cb: c())
            box.pack_start(btn, False, False, 0)

        return box

    # ── Realize: position toolbar ─────────────────────────────────────────────

    def _on_realize(self, *_):
        self.show_all()
        self._toolbar_box.show()
        self._sel_box.hide()
        self._size_lbl.hide()
        self._hint_lbl.hide()
        GLib.idle_add(self._position_toolbar)
        GLib.idle_add(self._position_hint)

    def _position_toolbar(self):
        w = self._toolbar_box.get_preferred_size()[1].width
        self._fixed.move(self._toolbar_box, (self._sw() - w) // 2, 24)
        return False

    def _position_hint(self):
        w = self._hint_lbl.get_preferred_size()[1].width
        h = self._hint_lbl.get_preferred_size()[1].height
        self._fixed.move(self._hint_lbl, (self._sw() - w) // 2, self._sh() - h - 40)
        return False

    # ── Toolbar actions ───────────────────────────────────────────────────────

    def _open_settings(self):
        settings_tool = shutil.which('farolkey-screenshot-settings') or str(
            Path(__file__).parent / 'farolkey-screenshot-settings'
        )
        subprocess.Popen([settings_tool],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _start_region(self):
        self._mode = 'selecting'
        self._toolbar_box.hide()
        self._hint_lbl.show()
        GLib.idle_add(self._set_cursor, Gdk.CursorType.CROSSHAIR)

    def _use_full(self):
        if self._done:
            return
        self._done = True
        self.hide()
        GLib.idle_add(self._deliver, self._full)

    def _cancel(self):
        if self._done:
            return
        self._done = True
        self.hide()
        GLib.idle_add(self._quit_clean)

    # ── Region selection mouse handlers ───────────────────────────────────────

    def _on_press(self, _w, event):
        if event.button != 1 or self._mode != 'selecting' or self._done:
            return
        self._drag = True
        self._sx = self._cx = event.x
        self._sy = self._cy = event.y
        self._update_sel()

    def _on_motion(self, _w, event):
        if not self._drag or self._mode != 'selecting' or self._done:
            return
        self._cx = event.x
        self._cy = event.y
        self._update_sel()

    def _on_release(self, _w, event):
        if event.button != 1 or not self._drag or self._mode != 'selecting' or self._done:
            return
        self._done = True
        self._drag = False
        x  = int(min(self._sx, event.x))
        y  = int(min(self._sy, event.y))
        rw = int(abs(event.x - self._sx))
        rh = int(abs(event.y - self._sy))
        self.hide()
        if rw > 4 and rh > 4:
            sx, sy = int(x * self._scale), int(y * self._scale)
            sw, sh = int(rw * self._scale), int(rh * self._scale)
            GLib.idle_add(self._crop_and_deliver, sx, sy, sw, sh)
        else:
            GLib.idle_add(self._quit_clean)

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            if self._mode == 'selecting' and not self._done:
                # Go back to toolbar
                self._mode = 'toolbar'
                self._drag = False
                self._sel_box.hide()
                self._size_lbl.hide()
                self._hint_lbl.hide()
                self._toolbar_box.show()
                GLib.idle_add(self._set_cursor, Gdk.CursorType.ARROW)
            elif not self._done:
                self._cancel()
            return True
        return False

    # ── Selection widget update ───────────────────────────────────────────────

    def _update_sel(self):
        x  = int(min(self._sx, self._cx))
        y  = int(min(self._sy, self._cy))
        rw = int(abs(self._cx - self._sx))
        rh = int(abs(self._cy - self._sy))

        if rw > 2 and rh > 2:
            self._fixed.move(self._sel_box, x, y)
            self._sel_box.set_size_request(rw, rh)
            self._sel_box.show()

            self._size_lbl.set_text(f' {int(rw * self._scale)} × {int(rh * self._scale)} ')
            lw = self._size_lbl.get_preferred_size()[1].width
            lx = x + rw + 6
            if lx + lw > self._sw():
                lx = x - lw - 6
            self._fixed.move(self._size_lbl, max(0, lx), y + 2)
            self._size_lbl.show()
        else:
            self._sel_box.hide()
            self._size_lbl.hide()

    # ── Delivery ──────────────────────────────────────────────────────────────

    def _crop_and_deliver(self, x, y, w, h):
        self.destroy()
        try:
            png = crop_pixbuf(self._pb, x, y, w, h)
        except Exception as e:
            show_error(str(e))
            return False
        finish(png, self._conf)
        return False

    def _deliver(self, png: bytes):
        self.destroy()
        finish(png, self._conf)
        return False

    def _quit_clean(self):
        self.destroy()
        Gtk.main_quit()
        return False

    # ── Helpers ───────────────────────────────────────────────────────────────

    def _set_cursor(self, cursor_type):
        gdk_win = self.get_window()
        if gdk_win:
            gdk_win.set_cursor(
                Gdk.Cursor.new_for_display(Gdk.Display.get_default(), cursor_type)
            )
        return False

    def _sw(self) -> int:
        m = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        return m.get_geometry().width

    def _sh(self) -> int:
        m = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        return m.get_geometry().height

# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    conf = load_conf()

    skip_review  = '--fullscreen' in sys.argv
    direct_region = '--region'    in sys.argv

    def _on_captured(png: bytes):
        if skip_review:
            finish(png, conf)
            return
        overlay = CaptureReviewOverlay(png, conf)
        overlay.show_all()
        if direct_region:
            GLib.idle_add(overlay._start_region)

    def _capture_thread():
        try:
            png = capture_fullscreen()
            GLib.idle_add(_on_captured, png)
        except CaptureError as e:
            GLib.idle_add(show_error, str(e))

    # Capture immediately (in background thread so GTK loop can start)
    threading.Thread(target=_capture_thread, daemon=True).start()
    Gtk.main()

if __name__ == '__main__':
    main()
