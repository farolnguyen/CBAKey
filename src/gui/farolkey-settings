            default_name = f'farolkey_log_{time.strftime("%Y%m%d_%H%M%S")}.zip'
            dlg = Gtk.FileChooserDialog(title='Save log bundle', transient_for=self,
                                        action=Gtk.FileChooserAction.SAVE)
