    def _on_fl_add(self, _btn):
        dlg = _FreeLayoutRuleDialog(self.get_toplevel())
        if dlg.run() == Gtk.ResponseType.OK:
            k, o = dlg.get_rule()
            if k and o:
                shortcuts = self._fl_entries.setdefault('shortcuts', [])
                # Replace existing entry with same key
                shortcuts = [r for r in shortcuts if r.get('key') != k]
                shortcuts.append({'key': k, 'output': o})
                self._fl_entries['shortcuts'] = shortcuts
                self._fl_refresh_table()
        dlg.destroy()

    def _on_fl_edit(self, _btn):
        idx = self._fl_selected_index()
        if idx < 0: return
        shortcuts = self._fl_entries.get('shortcuts', [])
        rule = shortcuts[idx]
        dlg = _FreeLayoutRuleDialog(self.get_toplevel(), rule.get('key',''), rule.get('output',''))
        if dlg.run() == Gtk.ResponseType.OK:
            k, o = dlg.get_rule()
            if k and o:
                shortcuts[idx] = {'key': k, 'output': o}
                self._fl_entries['shortcuts'] = shortcuts
                self._fl_refresh_table()
        dlg.destroy()

    def _on_fl_delete(self, _btn):
        idx = self._fl_selected_index()
        if idx < 0: return
        shortcuts = self._fl_entries.get('shortcuts', [])
        del shortcuts[idx]
        self._fl_entries['shortcuts'] = shortcuts
        self._fl_refresh_table()

    def _on_fl_tone_key_press(self, entry, event, field):
        keyval = event.keyval
        if keyval == Gdk.KEY_BackSpace or keyval == Gdk.KEY_Delete:
            entry.set_text(''); return True
        if keyval == Gdk.KEY_Escape: return False
        ch = chr(keyval) if 32 <= keyval <= 126 else None
        if ch:
            entry.set_text(ch)  # dedup handled by 'changed' signal
            return True
        return False

    def _on_fl_tone_changed(self, entry, field):
        # Fires for ALL text changes — direct key, IM commit, paste, set_text().
        ch = entry.get_text()
        if len(ch) != 1:
            return
        # Remove the same key from every other tone field.
        for other_field, other_entry in self._fl_tone_entries.items():
            if other_field != field and other_entry.get_text() == ch:
                # Block this handler on other_entry to avoid recursion.
                other_entry.handler_block_by_func(self._on_fl_tone_changed)
                other_entry.set_text('')
                other_entry.handler_unblock_by_func(self._on_fl_tone_changed)

    def _on_fl_clear_tones(self, _btn):
        for entry in self._fl_tone_entries.values():
            entry.set_text('')
        self._show_info(_('Tone keys cleared.'))

    def _on_fl_save(self, _btn):
        # Collect inline tone entries
        tones = {}
        for field, entry in self._fl_tone_entries.items():
            val = entry.get_text().strip()
            tones[field] = val if len(val) == 1 else ''
        self._fl_entries['tones'] = tones
        self._fl_save_file()
        try:
            subprocess.run(['farolkey-reload'], capture_output=True, timeout=3)
        except Exception:
            pass
        self._show_info(_('Free Layout saved. Changes take effect immediately.'))

