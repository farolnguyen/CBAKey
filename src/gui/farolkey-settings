        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scroll.set_size_request(172, -1)

        self._listbox = Gtk.ListBox()
        self._listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)

        for m in self._METHODS:
            lb_row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=m, xalign=0)
            lbl.set_margin_start(14)
            lbl.set_margin_end(14)
            lbl.set_margin_top(9)
            lbl.set_margin_bottom(9)
            lb_row.add(lbl)
            self._listbox.add(lb_row)

        sidebar_scroll.add(self._listbox)
        outer.pack_start(sidebar_scroll, False, False, 0)
        outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)

        # ── Content ───────────────────────────────────────────────────────────
        self._content_scroll = Gtk.ScrolledWindow()
        self._content_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self._content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self._content_box.set_margin_start(20)
        self._content_box.set_margin_end(20)
        self._content_box.set_margin_top(16)
        self._content_box.set_margin_bottom(16)
        self._content_scroll.add(self._content_box)

        outer.pack_start(self._content_scroll, True, True, 0)
        content.pack_start(outer, True, True, 0)

        self._listbox.connect('row-selected', self._on_select)

        idx = self._METHODS.index(initial_method) if initial_method in self._METHODS else 0
        self._listbox.select_row(self._listbox.get_row_at_index(idx))

        self.show_all()

    # ── Rendering ─────────────────────────────────────────────────────────────

    def _clear(self):
        for child in self._content_box.get_children():
            self._content_box.remove(child)

    def _lbl(self, markup, wrap=False, margin_start=0):
        w = Gtk.Label()
        w.set_markup(markup)
        w.set_halign(Gtk.Align.START)
        w.set_margin_start(margin_start)
        if wrap:
            w.set_line_wrap(True)
            w.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self._content_box.pack_start(w, False, False, 0)

    def _table(self, rows):
        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(3)
        grid.set_margin_start(12)
        for i, (key, val) in enumerate(rows):
            k = Gtk.Label()
            k.set_markup('<tt><b>' + GLib.markup_escape_text(key) + '</b></tt>')
            k.set_halign(Gtk.Align.START)
            a = Gtk.Label(label='→')
            a.set_halign(Gtk.Align.CENTER)
            v = Gtk.Label(label=val)
            v.set_halign(Gtk.Align.START)
            v.set_line_wrap(True)
            grid.attach(k, 0, i, 1, 1)
            grid.attach(a, 1, i, 1, 1)
            grid.attach(v, 2, i, 1, 1)
        self._content_box.pack_start(grid, False, False, 0)

    def _notes(self, items):
        for item in items:
            self._lbl(GLib.markup_escape_text('• ' + item), wrap=True, margin_start=12)

    def _on_select(self, _lb, row):
        if row is None:
            return
        self._clear()
        name = row.get_child().get_text()
        data = self._REFS.get(name)
        if not data:
            return

        self._lbl('<span size="x-large" weight="bold">' +
                  GLib.markup_escape_text(name) + '</span>')
        self._lbl(GLib.markup_escape_text(data['desc']), wrap=True)
        self._content_box.pack_start(Gtk.Separator(), False, False, 4)

        for sec_title, sec_type, sec_data in data.get('sections', []):
            self._lbl('<b>' + GLib.markup_escape_text(sec_title) + '</b>')
            if sec_type == 'table':
                self._table(sec_data)
            elif sec_type == 'notes':
                self._notes(sec_data)
            self._content_box.pack_start(Gtk.Box(), False, False, 2)

        self._content_box.show_all()


