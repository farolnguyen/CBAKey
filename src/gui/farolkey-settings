    def _fl_load(self):
        try:
            with open(self._fl_conf_path, encoding='utf-8') as f:
                data = json.load(f)
            return {
                'tones':     data.get('tones', {}),
                'shortcuts': data.get('shortcuts', []),
            }
        except Exception:
            return {'tones': {}, 'shortcuts': []}

    def _fl_save_file(self):
        os.makedirs(os.path.dirname(self._fl_conf_path), exist_ok=True)
        tmp = self._fl_conf_path + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(self._fl_entries, f, ensure_ascii=False, indent=2)
            f.write('\n')
        os.replace(tmp, self._fl_conf_path)

    def _fl_refresh_table(self):
        self._fl_store.clear()
        for rule in self._fl_entries.get('shortcuts', []):
            self._fl_store.append([rule.get('key', ''), rule.get('output', '')])

    def _fl_selected_index(self):
        model, it = self._fl_selection.get_selected()
        if it is None: return -1
        return model.get_path(it).get_indices()[0]

