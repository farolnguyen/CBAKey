        dlg.set_filename(self._ss_path_entry.get_text())
        if dlg.run() == Gtk.ResponseType.OK:
            self._ss_path_entry.set_text(dlg.get_filename())
        dlg.destroy()

    def _on_screenshot_save(self, _btn):
        old_conf   = load_screenshot_conf()
        old_hotkey = old_conf.get('hotkey', '')
        conf = {
            'hotkey':          self._ss_hotkey_entry.get_text().strip(),
            'capture_mode':    'cursor' if self._ss_cap_cursor_radio.get_active() else 'all',
            'instant_capture': 'true' if self._ss_instant_switch.get_active() else 'false',
            'show_notification': 'true' if self._ss_notify_switch.get_active() else 'false',
            'hotkey_action':   self._ss_action_combo.get_active_id() or 'menu',
            'save_path':       self._ss_path_entry.get_text().strip(),
            'ask_before_save': 'true' if self._ss_ask_switch.get_active() else 'false',
            'auto_save':       'true' if self._ss_auto_switch.get_active() else 'false',
        }
        save_screenshot_conf(conf)
        if conf['hotkey'] != old_hotkey:
            daemon = shutil.which('farolkey-screenshot-daemon')
            if daemon:
                try:
                    subprocess.run([daemon, '--setup'], capture_output=True, timeout=5)
                except Exception:
                    pass
        self._show_info(_('Screenshot settings saved.'))

    def _on_ss_test(self, _btn):
        tool = shutil.which('farolkey-screenshot')
        if tool:
            subprocess.Popen([tool], start_new_session=True)
        else:
            self._show_error('farolkey-screenshot not found in PATH.')

