        nb.append_page(self._build_about_tab(),      Gtk.Label(label=_('About')))

        self._refresh_table()
        self._refresh_template_table()

    # ── Tab 1: General ─────────────────────────────────────────────────────────

    def _build_general_tab(self):
        conf = load_general_conf()
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_top(16); vbox.set_margin_bottom(16)
        vbox.set_margin_start(24); vbox.set_margin_end(24)
        scroll.add(vbox)

        def section(text):
            lbl = Gtk.Label(label=text, xalign=0)
            lbl.get_style_context().add_class('section-hdr')
            return lbl

        def hint(text):
            lbl = Gtk.Label(label=text, xalign=0)
            lbl.set_line_wrap(True)
            lbl.get_style_context().add_class('hint')
            lbl.set_margin_start(4)
            return lbl

        def row(label_text, widget, expand=False):
            box = Gtk.Box(spacing=12)
            lbl = Gtk.Label(label=label_text, xalign=0)
            lbl.set_size_request(220, -1)
            box.pack_start(lbl, False, False, 0)
            box.pack_start(widget, expand, expand, 0)
            return box

        # ── Interface (Language) ───────────────────────────────────────────────
        vbox.pack_start(section(_('Interface')), False, False, 0)

        self._lang_combo = Gtk.ComboBoxText()
        self._lang_combo.append('en', 'English')
        self._lang_combo.append('vi', 'Tiếng Việt')
        self._lang_combo.set_active_id(_STARTUP_LANGUAGE)
        self._lang_combo.set_hexpand(False)
