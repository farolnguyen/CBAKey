    def _on_export(self, _btn):
        dlg = Gtk.FileChooserDialog(title=_('Export Dictionary as CSV'), transient_for=self,
                                    action=Gtk.FileChooserAction.SAVE)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Save'), Gtk.ResponseType.OK)
        dlg.set_current_name('farolkey_dict.csv')
        dlg.set_do_overwrite_confirmation(True)
        ff = Gtk.FileFilter(); ff.set_name('CSV files (*.csv)')
        ff.add_mime_type('text/csv'); ff.add_pattern('*.csv'); dlg.add_filter(ff)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            if not path.endswith('.csv'): path += '.csv'
            try:
                with open(path, 'w', encoding='utf-8', newline='') as f:
                    f.write(entries_to_csv(self.entries))
                self._show_info(f'Exported {len(self.entries)} entries to:\n{path}')
            except OSError as ex:
                self._show_error(f'Export failed: {ex}')
        dlg.destroy()

    def _on_import(self, _btn):
        dlg = Gtk.FileChooserDialog(title=_('Import Dictionary from CSV'), transient_for=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Select'), Gtk.ResponseType.OK)
        ff = Gtk.FileFilter(); ff.set_name('CSV files (*.csv)')
        ff.add_mime_type('text/csv'); ff.add_pattern('*.csv'); dlg.add_filter(ff)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            try:
                with open(path, encoding='utf-8') as f:
                    imported = csv_to_entries(f.read())
                existing = {e['trigger'] for e in self.entries}
                added, skipped = 0, 0
                for e in imported:
                    if e['trigger'] in existing: skipped += 1
                    else:
                        self.entries.append(e); existing.add(e['trigger']); added += 1
                if added:
                    save_entries(self.dict_path, self.entries)
                    self._refresh_table()
                msg = f'Imported {added} new entr{"y" if added == 1 else "ies"}.'
                if skipped: msg += f'\n{skipped} skipped (trigger already exists).'
                self._show_info(msg)
            except Exception as ex:
                self._show_error(f'Import failed: {ex}')
        dlg.destroy()

