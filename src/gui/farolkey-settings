    def _build_clipboard_tab(self):
        conf   = load_clipboard_conf()
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_top(16); vbox.set_margin_bottom(16)
        vbox.set_margin_start(24); vbox.set_margin_end(24)
        scroll.add(vbox)

        def section(text):
            lbl = Gtk.Label(label=text, xalign=0)
            lbl.get_style_context().add_class('section-hdr')
            return lbl

        def hint(text):
            lbl = Gtk.Label(label=text, xalign=0)
            lbl.set_line_wrap(True)
            lbl.get_style_context().add_class('hint')
            lbl.set_margin_start(4)
            return lbl

        vbox.pack_start(section(_('Popup display')), False, False, 0)
        self._cb_radio_mouse  = Gtk.RadioButton.new_with_label(None, _('🖱  Near cursor (default)'))
        self._cb_radio_corner = Gtk.RadioButton.new_with_label_from_widget(
            self._cb_radio_mouse, _('📐  Bottom-right corner of screen'))
        if conf.get('popup_position', 'mouse') == 'corner':
            self._cb_radio_corner.set_active(True)
        else:
            self._cb_radio_mouse.set_active(True)
        vbox.pack_start(self._cb_radio_mouse,  False, False, 4)
        vbox.pack_start(self._cb_radio_corner, False, False, 4)

        vbox.pack_start(Gtk.Separator(), False, False, 8)
        close_row = Gtk.Box(spacing=12)
        close_lbl = Gtk.Label(label=_('Close popup on click outside'), xalign=0)
        self._cb_close_switch = Gtk.Switch()
        self._cb_close_switch.set_active(conf.get('close_on_click_outside', 'true') == 'true')
        self._cb_close_switch.set_valign(Gtk.Align.CENTER)
        close_row.pack_start(close_lbl, True, True, 0)
        close_row.pack_start(self._cb_close_switch, False, False, 0)
        vbox.pack_start(close_row, False, False, 6)

        vbox.pack_start(Gtk.Separator(), False, False, 8)
        vbox.pack_start(section(_('System tools')), False, False, 0)
        tools = [
            (shutil.which('wl-copy'),  'wl-copy',  _('Clipboard write (Wayland)')),
            (shutil.which('xclip'),    'xclip',    _('Clipboard write (X11)')),
            (shutil.which('xdotool'),  'xdotool',  _('Auto-paste Ctrl+V (X11)')),
            (shutil.which('wtype'),    'wtype',    _('Auto-paste Ctrl+V (Wayland)')),
        ]
        tools_box = Gtk.Box(spacing=20)
        tools_box.set_margin_top(6)
        for found, name, desc in tools:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label()
            name_lbl.set_markup(f'<span foreground="{"#4caf50" if found else "#f44336"}">{"✓" if found else "✗"} {name}</span>')
            name_lbl.set_xalign(0)
            desc_lbl = Gtk.Label(label=desc); desc_lbl.set_xalign(0)
            desc_lbl.get_style_context().add_class('hint')
            col.pack_start(name_lbl, False, False, 0)
            col.pack_start(desc_lbl, False, False, 0)
            tools_box.pack_start(col, False, False, 0)
        vbox.pack_start(tools_box, False, False, 0)
        missing = [n for f, n, _ in tools if not f]
        if missing:
            vbox.pack_start(hint(f'Missing: {", ".join(missing)} — run: sudo apt install {" ".join(missing)}'), False, False, 4)

        vbox.pack_start(Gtk.Separator(), False, False, 16)
        btn_row = Gtk.Box(spacing=8)
        btn_row.set_halign(Gtk.Align.END)
        save_btn = Gtk.Button(label=_('Save & Apply'))
        save_btn.get_style_context().add_class('suggested-action')
        save_btn.connect('clicked', self._on_clipboard_save)
        btn_row.pack_start(save_btn, False, False, 0)
        vbox.pack_start(btn_row, False, False, 0)
        return scroll

    def _on_clipboard_save(self, _btn):
        conf = load_clipboard_conf()
        conf['popup_position']         = 'corner' if self._cb_radio_corner.get_active() else 'mouse'
        conf['close_on_click_outside'] = 'true' if self._cb_close_switch.get_active() else 'false'
        save_clipboard_conf(conf)
        self._show_info(_('Clipboard History settings saved.\nChanges will take effect on next popup open.'))

