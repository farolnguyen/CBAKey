    def _on_general_save(self, _btn):
        methods = ['Telex', 'VNI', 'VIQR']
        pmodes  = ['Auto', 'Client', 'Panel']
        new_lang = self._lang_combo.get_active_id() or 'en'
        updates = {
            'Method':               methods[self._method_combo.get_active()],
            'ToggleKey':            self._toggle_entry.get_text().strip(),
            'PreeditMode':          pmodes[self._preedit_combo.get_active()],
            'ShowPreeditUnderline': 'True' if self._underline_switch.get_active() else 'False',
            'AutoCapitalize':       'True' if self._autocap_switch.get_active() else 'False',
            'CommittedRewrite':     'True' if self._rewrite_switch.get_active() else 'False',
            'language':             new_lang,
        }
        save_general_conf(updates)
        try:
            subprocess.run(['farolkey-reload'], capture_output=True, timeout=3)
        except Exception:
            pass
        msg = _('Settings saved and applied.')
        if new_lang != _STARTUP_LANGUAGE:
            msg += '\n\n' + _('Restart required after changing language.')
        self._show_info(msg)

    def _on_general_reset(self, _btn):
        methods = ['Telex', 'VNI', 'VIQR']
        pmodes  = ['Auto', 'Client', 'Panel']
        current = {
            'Method':               methods[self._method_combo.get_active()],
            'ToggleKey':            self._toggle_entry.get_text().strip(),
            'PreeditMode':          pmodes[self._preedit_combo.get_active()],
            'ShowPreeditUnderline': 'True' if self._underline_switch.get_active() else 'False',
            'AutoCapitalize':       'True' if self._autocap_switch.get_active() else 'False',
            'CommittedRewrite':     'True' if self._rewrite_switch.get_active() else 'False',
        }

        changes = [(k, current[k], _GENERAL_DEFAULTS[k])
                   for k in _GENERAL_DEFAULTS if current[k] != _GENERAL_DEFAULTS[k]]

        if not changes:
            dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
                text=_('All settings are already at their defaults.'))
            dlg.run()
            dlg.destroy()
            return

        _setting_labels = {
            'Method':               _('Input method'),
            'ToggleKey':            _('EN/VI toggle key'),
            'PreeditMode':          _('Preedit mode'),
            'ShowPreeditUnderline': _('Show underline while composing'),
            'AutoCapitalize':       _('Auto-capitalize sentences'),
            'CommittedRewrite':     _('Allow editing committed syllable'),
        }
        _bool_display = {'True': _('On'), 'False': _('Off')}

        def _fmt(v):
            return _bool_display.get(v, v)

        dlg = Gtk.Dialog(title=_('Restore defaults'), transient_for=self, modal=True)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL,
                        _('Restore'), Gtk.ResponseType.OK)
        dlg.get_widget_for_response(Gtk.ResponseType.OK) \
           .get_style_context().add_class('destructive-action')

        area = dlg.get_content_area()
        area.set_spacing(8)
        area.set_margin_start(20)
        area.set_margin_end(20)
        area.set_margin_top(16)
        area.set_margin_bottom(8)

        area.add(Gtk.Label(
            label=_('The following settings will be reset to their defaults:'),
            xalign=0))

        grid = Gtk.Grid(row_spacing=6, column_spacing=20)
        grid.set_margin_top(10)
        grid.set_margin_bottom(4)

        for i, (key, cur_val, def_val) in enumerate(changes):
            name_lbl = Gtk.Label(label=_setting_labels.get(key, key), xalign=0)
            name_lbl.set_hexpand(True)

            cur_lbl = Gtk.Label(label=_fmt(cur_val), xalign=0.5)
            cur_lbl.get_style_context().add_class('error')

            arr_lbl = Gtk.Label(label=' → ')

            def_lbl = Gtk.Label(label=_fmt(def_val), xalign=0.5)
            def_lbl.get_style_context().add_class('success')

            grid.attach(name_lbl, 0, i, 1, 1)
            grid.attach(cur_lbl,  1, i, 1, 1)
            grid.attach(arr_lbl,  2, i, 1, 1)
            grid.attach(def_lbl,  3, i, 1, 1)

        area.add(grid)
        area.show_all()

        if dlg.run() == Gtk.ResponseType.OK:
            dlg.destroy()
            save_general_conf(_GENERAL_DEFAULTS)
            conf = load_general_conf()
            _m = conf.get('Method', 'Telex')
            _ml = ['Telex', 'VNI', 'VIQR']
            self._method_combo.set_active(_ml.index(_m) if _m in _ml else 0)
            self._toggle_entry.set_text(conf['ToggleKey'])
            pm = conf['PreeditMode']
            self._preedit_combo.set_active(
                ['Auto','Client','Panel'].index(pm) if pm in ['Auto','Client','Panel'] else 0)
            self._underline_switch.set_active(conf['ShowPreeditUnderline'].lower() == 'true')
            self._autocap_switch.set_active(conf['AutoCapitalize'].lower() == 'true')
            self._rewrite_switch.set_active(conf['CommittedRewrite'].lower() == 'true')
            try:
                subprocess.run(['farolkey-reload'], capture_output=True, timeout=3)
            except Exception:
                pass
        else:
            dlg.destroy()

