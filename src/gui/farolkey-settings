# ── Single-instance lock ───────────────────────────────────────────────────────

_LOCK_PATH = f'/tmp/farolkey-settings-{os.getuid()}.lock'
_lock_fd   = None

def _acquire_single_instance():
    global _lock_fd
    _lock_fd = open(_LOCK_PATH, 'w')
    try:
        fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError:
        return False

# ── Cross-instance tab switching (IPC) ──────────────────────────────────────────
# Lets other FarolKey tools (screenshot overlay, clipboard popup) open this
# window directly on a given tab via `farolkey-settings --tab=<name>`, even if
# an instance is already running.

_SOCK_PATH = f'/tmp/farolkey-settings-{os.getuid()}.sock'

# Must match the nb.append_page() order in SettingsWindow.__init__
_TAB_INDEX = {
    'general':     0,
    'dict':        1,
    'clipboard':   2,
    'screenshot':  3,
    'free_layout': 4,
    'about':       5,
}

def _start_ipc_listener(win):
    try:
        if os.path.exists(_SOCK_PATH):
            os.unlink(_SOCK_PATH)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(_SOCK_PATH)
        srv.listen(4)
    except OSError:
        return

    def _loop():
        while True:
            try:
                conn, _addr = srv.accept()
            except OSError:
                return
            with conn:
                msg = conn.recv(64).decode().strip()
            if msg == '__LOWER__':
                GLib.idle_add(_lower_settings, win)
            elif msg == '__RESTORE__':
                GLib.idle_add(_restore_settings, win)
            else:
                GLib.idle_add(_switch_tab, win, msg)

    threading.Thread(target=_loop, daemon=True).start()

def _switch_tab(win, tab: str):
    idx = _TAB_INDEX.get(tab)
    if idx is not None:
        win._nb.set_current_page(idx)
    win.present()
    return False

def _lower_settings(win):
    """Step aside for the screenshot region-select overlay (also keep_above)."""
    win.set_keep_above(False)
    gdkwin = win.get_window()
    if gdkwin is not None:
        gdkwin.lower()
    return False

def _restore_settings(win):
    """Undo _lower_settings() once the screenshot overlay closes."""
    win.set_keep_above(True)
    win.present()
    return False

def _send_tab_request(tab: str):
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(_SOCK_PATH)
        sock.sendall(tab.encode())
        sock.close()
    except OSError:
        subprocess.run(['wmctrl', '-a', 'FarolKey Settings'], capture_output=True)

