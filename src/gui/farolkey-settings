    def _refresh_status(self):
        checks = {
            'fcitx5':            'pgrep -x fcitx5',
            'farolkey_plugin':   'pgrep -x fcitx5',
            'clipboard_daemon':  'pgrep -f farolkey-clipboard',
            'screenshot_daemon': 'pgrep -f farolkey-screenshot-daemon',
        }
        for key, cmd in checks.items():
            running = subprocess.run(cmd.split(), capture_output=True).returncode == 0
            lbl = self._status_labels[key]
            if running:
                lbl.set_markup(f'<span foreground="#4caf50">{_("● Running")}</span>')
            else:
                lbl.set_markup(f'<span foreground="#f44336">{_("✕ Not running")}</span>')

    def _restart_daemon(self, daemon_name: str):
        subprocess.run(['pkill', '-f', daemon_name], capture_output=True)
        time.sleep(0.4)
        daemon_path = shutil.which(daemon_name)
        if daemon_path:
            subprocess.Popen([daemon_path], start_new_session=True)
            time.sleep(0.6)
            self._refresh_status()
        else:
            self._show_error(f'{daemon_name} not found in PATH.')

