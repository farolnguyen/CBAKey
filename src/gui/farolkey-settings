        for e in self.entries:
            self.store.append([e['trigger'], e['expansion'],
                               mode_display.get(e['abbrev_mode'], 'VI')])
        self._update_count()

    def _update_count(self):
        n = len(self.entries)
        q = self.search_entry.get_text().strip()
        if q:
            shown = self.filter_model.iter_n_children(None)
            self.count_label.set_text(f'{shown}/{n}')
