        grid = Gtk.Grid(row_spacing=8, column_spacing=12)
        grid.attach(Gtk.Label(label=_('Pattern:'), xalign=1), 0, 0, 1, 1)
        self._pattern = Gtk.Entry()
        self._pattern.set_hexpand(True)
        self._pattern.set_placeholder_text('e.g.  {n}++  or  hello{name}')
        if tmpl:
            self._pattern.set_text(tmpl['pattern'])
        grid.attach(self._pattern, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label=_('Mode:'), xalign=1), 0, 1, 1, 1)
        self._mode_combo = Gtk.ComboBoxText()
        for m in ['en', 'vi', 'both']:
            self._mode_combo.append_text(m)
        cur = tmpl.get('mode', 'both') if tmpl else 'both'
        self._mode_combo.set_active(['en', 'vi', 'both'].index(cur) if cur in ['en', 'vi', 'both'] else 2)
        grid.attach(self._mode_combo, 1, 1, 1, 1)
        box.add(grid)

        box.add(Gtk.Label(label=_('Expansion (Jinja2):'), xalign=0))
        exp_scroll = Gtk.ScrolledWindow()
        exp_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        exp_scroll.set_size_request(-1, 120)
        self._exp_view = Gtk.TextView()
        self._exp_view.set_monospace(True)
        self._exp_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        if tmpl:
            self._exp_view.get_buffer().set_text(tmpl['expansion'])
        exp_scroll.add(self._exp_view)
        box.add(exp_scroll)

        prev_row = Gtk.Box(spacing=8)
        prev_row.add(Gtk.Label(label=_('Test input:')))
        self._prev_entry = Gtk.Entry()
        self._prev_entry.set_width_chars(22)
        self._prev_entry.set_placeholder_text('e.g. 5  or  derrick')
        prev_btn = Gtk.Button(label=_('▶ Preview'))
        prev_btn.connect('clicked', self._on_preview)
        self._prev_entry.connect('activate', self._on_preview)
        prev_row.add(self._prev_entry)
        prev_row.add(prev_btn)
        box.add(prev_row)

        preview_scroll = Gtk.ScrolledWindow()
        preview_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        preview_scroll.set_size_request(-1, 80)
        self._preview_view = Gtk.TextView()
        self._preview_view.set_monospace(True)
        self._preview_view.set_editable(False)
        self._preview_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        preview_scroll.add(self._preview_view)
        box.add(preview_scroll)

        self.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Save'), Gtk.ResponseType.OK)
        self.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class('suggested-action')
        self.show_all()

    def _on_preview(self, *_):
        buf     = self._exp_view.get_buffer()
        pattern = self._pattern.get_text().strip()
        exp     = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        test    = self._prev_entry.get_text().strip()
        if not pattern or not exp or not test:
            self._preview_view.get_buffer().set_text('(fill in pattern, expansion, and test input)')
            return
        _VAR = re.compile(r'\{(\w+)\}')
        parts, last = [], 0
        for m in _VAR.finditer(pattern):
            parts.append(re.escape(pattern[last:m.start()]))
            parts.append(f'(?P<{m.group(1)}>.+)')
            last = m.end()
        parts.append(re.escape(pattern[last:]))
        try:
            rx = re.compile('^' + ''.join(parts) + '$')
            match = rx.match(test)
            if not match:
                self._preview_view.get_buffer().set_text(f'No match for "{test}" with pattern "{pattern}"')
                return
            captures = match.groupdict()
            from jinja2.sandbox import SandboxedEnvironment
            from datetime import datetime
            env = SandboxedEnvironment(keep_trailing_newline=True)
            env.globals.update({
                'numbered': lambda n, start=1, sep='\n': sep.join(str(i) for i in range(int(start), int(n)+1)),
                'today':    lambda fmt='%d/%m/%Y': datetime.now().strftime(fmt),
                'now':      lambda fmt='%H:%M:%S': datetime.now().strftime(fmt),
                'repeat':   lambda text, n, sep='': sep.join([str(text)] * int(n)),
            })
            self._preview_view.get_buffer().set_text(env.from_string(exp).render(**captures))
        except ImportError:
            self._preview_view.get_buffer().set_text('jinja2 not installed. Run: pip3 install jinja2')
        except Exception as e:
            self._preview_view.get_buffer().set_text(f'Error: {e}')

    def get_template(self):
        buf  = self._exp_view.get_buffer()
        modes = ['en', 'vi', 'both']
        return {
            'pattern':   self._pattern.get_text().strip(),
            'expansion': buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False),
            'mode':      modes[self._mode_combo.get_active()],
        }


