# ── General config (farolkey.conf) ─────────────────────────────────────────────

_GENERAL_DEFAULTS = {
    'Method':               'Telex',
    'ToggleKey':            'Control+Alt+z',
    'ShowPreeditUnderline': 'True',
    'AutoCapitalize':       'False',
    'PreeditMode':          'Auto',
    'CommittedRewrite':     'True',
}

def load_general_conf() -> dict:
    conf = dict(_GENERAL_DEFAULTS)
    p    = Path(get_conf_path())
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line.startswith('#') or '=' not in line:
                continue
            k, _, v = line.partition('=')
            k = k.strip(); v = v.strip()
            if k in conf:
                conf[k] = v
    return conf

def save_general_conf(updates: dict):
    """Merge updates into farolkey.conf, preserving unknown keys and comments."""
    p     = Path(get_conf_path())
    lines = p.read_text().splitlines() if p.exists() else []
    written = set()
    out   = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith('#') or '=' not in stripped:
            out.append(line)
            continue
        k = stripped.split('=', 1)[0].strip()
        if k in updates:
            out.append(f'{k}={updates[k]}')
            written.add(k)
        else:
            out.append(line)
    for k, v in updates.items():
        if k not in written:
            out.append(f'{k}={v}')
    p.write_text('\n'.join(out) + '\n')

# ── Dict-GUI helpers (copied from farolkey-dict-gui) ──────────────────────────

def _is_enable_key(s):
    return (s.startswith('enable_user_dictionary=') or
            s.startswith('enableuserdictionary='))

def read_enable_setting(conf_path):
    try:
        with open(conf_path) as f:
            for line in f:
                ls = line.strip().lower()
                if _is_enable_key(ls):
                    return ls.split('=', 1)[1].strip() == 'true'
    except FileNotFoundError:
        pass
    return True

def write_enable_setting(conf_path, enabled):
    val   = 'true' if enabled else 'false'
    lines = []
    found = False
    try:
        with open(conf_path) as f:
            for line in f:
                ls = line.strip().lower()
                if _is_enable_key(ls):
                    orig_key = line.split('=', 1)[0]
                    lines.append(f'{orig_key}={val}\n')
                    found = True
                else:
                    lines.append(line)
    except FileNotFoundError:
        pass
    if not found:
        lines.append(f'EnableUserDictionary={val}\n')
    os.makedirs(os.path.dirname(conf_path), exist_ok=True)
    tmp = conf_path + '.tmp'
    with open(tmp, 'w') as f:
        f.writelines(lines)
    os.replace(tmp, conf_path)

def read_smart_templates_setting(conf_path):
    try:
        with open(conf_path) as f:
            for line in f:
                ls = line.strip().lower()
                if ls.startswith('enable_smart_templates='):
                    return ls.split('=', 1)[1].strip() == 'true'
    except FileNotFoundError:
        pass
    return True

def write_smart_templates_setting(conf_path, enabled):
    val   = 'true' if enabled else 'false'
    lines = []
    found = False
    try:
        with open(conf_path) as f:
            for line in f:
                if line.strip().lower().startswith('enable_smart_templates='):
                    lines.append(f'enable_smart_templates={val}\n')
                    found = True
                else:
                    lines.append(line)
    except FileNotFoundError:
        pass
    if not found:
        lines.append(f'enable_smart_templates={val}\n')
    os.makedirs(os.path.dirname(conf_path), exist_ok=True)
    tmp = conf_path + '.tmp'
    with open(tmp, 'w') as f:
        f.writelines(lines)
    os.replace(tmp, conf_path)

def load_entries(path):
    entries = []
    try:
        with open(path) as f:
            content = f.read().strip()
        if content.startswith('['):
            for item in json.loads(content):
                if isinstance(item, dict) and 'trigger' in item and 'expansion' in item:
                    entries.append({'trigger': item['trigger'], 'expansion': item['expansion'],
                                    'abbrev_mode': item.get('abbrev_mode', 'vi')})
        else:
            for line in content.splitlines():
                line = line.strip().rstrip(',')
                if not line or line in ('[', ']'):
                    continue
                try:
                    item = json.loads(line)
                    if 'trigger' in item and 'expansion' in item:
                        entries.append({'trigger': item['trigger'], 'expansion': item['expansion'],
                                        'abbrev_mode': item.get('abbrev_mode', 'vi')})
                except json.JSONDecodeError:
                    pass
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return entries

def save_entries(path, entries):
    bak = path + '.bak'
    if os.path.exists(path):
        shutil.copy2(path, bak)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        for e in entries:
            f.write(json.dumps({'trigger': e['trigger'], 'expansion': e['expansion'],
                                'abbrev_mode': e['abbrev_mode']}, ensure_ascii=False) + '\n')
    os.replace(tmp, path)

CSV_HEADER  = ['trigger', 'expansion', 'abbrev_mode']
VALID_MODES = {'vi', 'en', 'both'}

def entries_to_csv(entries):
    buf = io.StringIO()
    w   = csv.DictWriter(buf, fieldnames=CSV_HEADER, lineterminator='\n')
    w.writeheader(); w.writerows(entries)
    return buf.getvalue()

def csv_to_entries(text):
    reader = csv.DictReader(io.StringIO(text))
    if reader.fieldnames and set(CSV_HEADER) - set(reader.fieldnames):
        raise ValueError(f'CSV must have columns: {CSV_HEADER}')
    result = []
    for row in reader:
        t = row.get('trigger', '').strip()
        e = row.get('expansion', '').strip()
        m = row.get('abbrev_mode', 'vi').strip().lower()
        if not t or not e:
            continue
        result.append({'trigger': t, 'expansion': e, 'abbrev_mode': m if m in VALID_MODES else 'vi'})
    return result

_DEFAULT_TEMPLATES = [
    {'pattern': '{n}++',      'expansion': '{% for i in range(1, n|int+1) %}{{ i }}\n{% endfor %}', 'mode': 'en'},
    {'pattern': 'for{n}',     'expansion': 'for (let i = 1; i <= {{ n|int }}; i++) {\n    // ...\n}', 'mode': 'en'},
    {'pattern': 'date',       'expansion': '{{ today() }}', 'mode': 'both'},
    {'pattern': 'hello{name}','expansion': 'Kính gửi {{ name|title }},\n\nThân gửi,', 'mode': 'both'},
    {'pattern': 'list{n}',    'expansion': '{{ numbered(n) }}', 'mode': 'both'},
    {'pattern': 'line{n}',    'expansion': '{{ repeat("=-", n|int, sep="") }}', 'mode': 'both'},
]

def load_templates(path):
    if not os.path.exists(path):
        return [dict(t) for t in _DEFAULT_TEMPLATES]
    templates = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                    if 'pattern' in obj and 'expansion' in obj:
                        templates.append({'pattern': obj['pattern'], 'expansion': obj['expansion'],
                                          'mode': obj.get('mode', 'both')})
                except json.JSONDecodeError:
                    pass
    except OSError:
        pass
    return templates

def save_templates(path, templates):
    bak = path + '.bak'
    if os.path.exists(path):
        shutil.copy2(path, bak)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        for t in templates:
            f.write(json.dumps({'pattern': t['pattern'], 'expansion': t['expansion'],
                                'mode': t['mode']}, ensure_ascii=False) + '\n')
    os.replace(tmp, path)

def expand_template_preview(test_input: str):
    if test_input.startswith('[') and test_input.endswith(']') and len(test_input) > 2:
        test_input = test_input[1:-1]
    if not test_input:
        return False, 'Empty trigger.'
    bin_path = shutil.which('farolkey-template')
    if not bin_path:
        return False, 'farolkey-template not found in PATH.'
    try:
        result = subprocess.run([bin_path, 'expand', test_input],
                                capture_output=True, text=True, timeout=5)
        if result.returncode == 0:
            return True, result.stdout
        return False, f'No template matched "{test_input}"'
    except subprocess.TimeoutExpired:
        return False, 'Timeout: template took too long to render.'
    except Exception as e:
        return False, f'Error: {e}'

