        dlg.destroy()

    def _on_import(self, _btn):
        dlg = Gtk.FileChooserDialog(title=_('Import Dictionary from CSV'), transient_for=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Select'), Gtk.ResponseType.OK)
        ff = Gtk.FileFilter(); ff.set_name('CSV files (*.csv)')
        ff.add_mime_type('text/csv'); ff.add_pattern('*.csv'); dlg.add_filter(ff)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            try:
                with open(path, encoding='utf-8') as f:
                    imported = csv_to_entries(f.read())
                existing = {e['trigger'] for e in self.entries}
                added, skipped = 0, 0
                for e in imported:
                    if e['trigger'] in existing: skipped += 1
                    else:
                        self.entries.append(e); existing.add(e['trigger']); added += 1
                if added:
                    save_entries(self.dict_path, self.entries)
                    self._refresh_table()
                msg = f'Imported {added} new entr{"y" if added == 1 else "ies"}.'
                if skipped: msg += f'\n{skipped} skipped (trigger already exists).'
                self._show_info(msg)
            except Exception as ex:
                self._show_error(f'Import failed: {ex}')
        dlg.destroy()

    # ── Dict-GUI helpers (templates) ───────────────────────────────────────────

    def _tmpl_filter_func(self, model, it, _data):
        q = self.tmpl_search.get_text().strip().lower()
        if not q: return True
        return (q in (model.get_value(it, 0) or '').lower() or
                q in (model.get_value(it, 1) or '').lower())

    def _on_tmpl_search_changed(self, _entry):
        self.tmpl_filter.refilter()
        self._update_tmpl_count()

    def _refresh_template_table(self):
        self.tmpl_store.clear()
        for t in self.templates:
            exp_preview = t['expansion'][:80].replace('\n', '↵')
            if len(t['expansion']) > 80: exp_preview += '…'
            self.tmpl_store.append([t['pattern'], exp_preview, t['mode']])
        self._update_tmpl_count()

    def _update_tmpl_count(self):
        n = len(self.templates)
        q = self.tmpl_search.get_text().strip()
        if q:
            shown = self.tmpl_filter.iter_n_children(None)
            self.tmpl_count_label.set_text(f'{shown}/{n}')
        else:
            self.tmpl_count_label.set_text(f'{n} template{"s" if n != 1 else ""}')

    def _tmpl_selected_index(self):
        model, it = self.tmpl_selection.get_selected()
        if it is None: return -1
        child_it = self.tmpl_filter.convert_iter_to_child_iter(it)
        return self.tmpl_store.get_path(child_it).get_indices()[0]

    def _on_tmpl_enable_toggled(self, switch, _param):
        write_smart_templates_setting(self.conf_path, switch.get_active())

    def _on_tmpl_selection_changed(self, _sel):
        has = self._tmpl_selected_index() >= 0
        self.tmpl_btn_edit.set_sensitive(has)
        self.tmpl_btn_delete.set_sensitive(has)

    def _on_tmpl_row_activated(self, *_): self._on_tmpl_edit(None)

    def _on_tmpl_add(self, _btn):
        dlg = TemplateDialog(self, _('Add Smart Template'))
        if dlg.run() == Gtk.ResponseType.OK:
            t = dlg.get_template()
            if not t['pattern'] or not t['expansion']:
                self._show_error(_('Pattern and Expansion cannot be empty.'))
            elif any(x['pattern'] == t['pattern'] for x in self.templates):
                self._show_error(f'Pattern "{t["pattern"]}" already exists.')
            else:
                self.templates.append(t)
                save_templates(self.tmpl_path, self.templates)
                self._refresh_template_table()
        dlg.destroy()

    def _on_tmpl_edit(self, _btn):
        idx = self._tmpl_selected_index()
        if idx < 0: return
        dlg = TemplateDialog(self, _('Edit Smart Template'), self.templates[idx])
        if dlg.run() == Gtk.ResponseType.OK:
            t = dlg.get_template()
            if not t['pattern'] or not t['expansion']:
                self._show_error(_('Pattern and Expansion cannot be empty.'))
            else:
                self.templates[idx] = t
                save_templates(self.tmpl_path, self.templates)
                self._refresh_template_table()
                fp = self.tmpl_filter.convert_child_path_to_path(Gtk.TreePath(idx))
                if fp: self.tmpl_tree.get_selection().select_path(fp)
        dlg.destroy()

    def _on_tmpl_delete(self, _btn):
        idx = self._tmpl_selected_index()
        if idx < 0: return
        pattern = self.templates[idx]['pattern']
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.OK_CANCEL,
            text=f'Delete template "{pattern}"?')
        dlg.format_secondary_text('A backup is kept as templates.json.bak')
        if dlg.run() == Gtk.ResponseType.OK:
            del self.templates[idx]
            save_templates(self.tmpl_path, self.templates)
            self._refresh_template_table()
        dlg.destroy()

    def _on_tmpl_quick_test(self, *_):
        test_input = self.tmpl_quick_entry.get_text().strip()
        if not test_input: return
        ok, output = expand_template_preview(test_input)
        if ok: self._show_info(f'Input: {test_input}\n\nOutput:\n{output}')
        else:  self._show_error(output)

    def _on_tmpl_export(self, _btn):
        dlg = Gtk.FileChooserDialog(title=_('Export Smart Templates as CSV'), transient_for=self,
                                    action=Gtk.FileChooserAction.SAVE)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Save'), Gtk.ResponseType.OK)
        dlg.set_current_name('farolkey_templates.csv')
        dlg.set_do_overwrite_confirmation(True)
        ff = Gtk.FileFilter(); ff.set_name('CSV files (*.csv)')
        ff.add_mime_type('text/csv'); ff.add_pattern('*.csv'); dlg.add_filter(ff)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            if not path.endswith('.csv'): path += '.csv'
            try:
                buf = io.StringIO()
                w = csv.DictWriter(buf, fieldnames=['pattern', 'expansion', 'mode'], lineterminator='\n')
                w.writeheader(); w.writerows(self.templates)
                with open(path, 'w', encoding='utf-8', newline='') as f:
                    f.write(buf.getvalue())
                self._show_info(f'Exported {len(self.templates)} template(s) to:\n{path}')
            except OSError as ex:
                self._show_error(f'Export failed: {ex}')
        dlg.destroy()

    def _on_tmpl_import(self, _btn):
        dlg = Gtk.FileChooserDialog(title=_('Import Smart Templates from CSV'), transient_for=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('Select'), Gtk.ResponseType.OK)
        ff = Gtk.FileFilter(); ff.set_name('CSV files (*.csv)')
        ff.add_mime_type('text/csv'); ff.add_pattern('*.csv'); dlg.add_filter(ff)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            try:
                with open(path, encoding='utf-8') as f:
                    reader = csv.DictReader(f)
                    required = {'pattern', 'expansion', 'mode'}
                    if reader.fieldnames and not required.issubset(set(reader.fieldnames)):
                        raise ValueError(f'CSV must have columns: {sorted(required)}')
                    imported = []
                    for row in reader:
                        p = row.get('pattern', '').strip()
                        e = row.get('expansion', '').strip()
                        m = row.get('mode', 'both').strip().lower()
                        if not p or not e: continue
                        if m not in ('en', 'vi', 'both'): m = 'both'
                        imported.append({'pattern': p, 'expansion': e, 'mode': m})
                existing = {t['pattern'] for t in self.templates}
                added, skipped = 0, 0
                for t in imported:
                    if t['pattern'] in existing: skipped += 1
                    else:
                        self.templates.append(t); existing.add(t['pattern']); added += 1
                if added:
                    save_templates(self.tmpl_path, self.templates)
                    self._refresh_template_table()
                msg = f'Imported {added} new template(s).'
                if skipped: msg += f'\n{skipped} skipped (pattern already exists).'
                self._show_info(msg)
            except Exception as ex:
                self._show_error(f'Import failed: {ex}')
        dlg.destroy()

    # ── Shared helpers ─────────────────────────────────────────────────────────

    def _show_error(self, msg):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK, text=msg)
        dlg.run(); dlg.destroy()

    def _show_info(self, msg):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text=msg)
        dlg.run(); dlg.destroy()


# ── Entry point ────────────────────────────────────────────────────────────────

def main():
    tab_arg = None
    for arg in sys.argv[1:]:
        if arg.startswith('--tab='):
            tab_arg = arg.split('=', 1)[1]

    if not _acquire_single_instance():
        if tab_arg:
            _send_tab_request(tab_arg)
        else:
            subprocess.run(['wmctrl', '-a', 'FarolKey Settings'], capture_output=True)
        sys.exit(0)

    win = SettingsWindow(initial_tab=tab_arg)
    _start_ipc_listener(win)
    win.show_all()
    win.present()
    Gtk.main()


if __name__ == '__main__':
    main()
