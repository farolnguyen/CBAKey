class EntryDialog(Gtk.Dialog):

    def __init__(self, parent, title, entry=None):
        super().__init__(title=title, transient_for=parent, modal=True)
        self.set_default_size(480, 200)
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(16); box.set_margin_bottom(8)
        box.set_margin_start(16); box.set_margin_end(16)

        grid = Gtk.Grid(row_spacing=8, column_spacing=12)

        grid.attach(Gtk.Label(label=_('Trigger:'), xalign=1), 0, 0, 1, 1)
        self._trigger = Gtk.Entry()
        self._trigger.set_hexpand(True)
        if entry:
            self._trigger.set_text(entry['trigger'])
        grid.attach(self._trigger, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label=_('Expansion:'), xalign=1), 0, 1, 1, 1)
        self._expansion = Gtk.Entry()
        self._expansion.set_hexpand(True)
        if entry:
            self._expansion.set_text(entry['expansion'])
        grid.attach(self._expansion, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label=_('Mode:'), xalign=1), 0, 2, 1, 1)
        self._mode_combo = Gtk.ComboBoxText()
        for m in ['vi', 'en', 'both']:
            self._mode_combo.append_text(m)
        cur = entry.get('abbrev_mode', 'vi') if entry else 'vi'
        self._mode_combo.set_active(['vi', 'en', 'both'].index(cur) if cur in ['vi', 'en', 'both'] else 0)
        grid.attach(self._mode_combo, 1, 2, 1, 1)

        box.add(grid)
        self.add_buttons(_('Cancel'), Gtk.ResponseType.CANCEL, _('OK'), Gtk.ResponseType.OK)
        self.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class('suggested-action')
        self._trigger.connect('activate', lambda _: self.response(Gtk.ResponseType.OK))
        self._expansion.connect('activate', lambda _: self.response(Gtk.ResponseType.OK))
        self.show_all()

    def get_entry(self):
        modes = ['vi', 'en', 'both']
        return {
            'trigger':     self._trigger.get_text().strip(),
            'expansion':   self._expansion.get_text(),
            'abbrev_mode': modes[self._mode_combo.get_active()],
        }


class TemplateDialog(Gtk.Dialog):

    def __init__(self, parent, title, tmpl=None):
        super().__init__(title=title, transient_for=parent, modal=True)
        self.set_default_size(600, 460)
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(16); box.set_margin_bottom(8)
