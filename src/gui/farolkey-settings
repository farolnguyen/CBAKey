def _config_dir() -> Path:
    xdg  = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg else Path.home() / '.config'
    d    = base / 'farolkey'
    d.mkdir(parents=True, exist_ok=True)
    return d

def get_conf_path()     -> str: return str(_config_dir() / 'farolkey.conf')
def get_dict_path()     -> str: return str(_config_dir() / 'user_dict.json')
