#!/usr/bin/env python3
"""CBAKey Dictionary Manager — GTK3 GUI for managing user abbreviations."""

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GObject, Pango

import json
import os
import shutil
import sys

# ── Paths ─────────────────────────────────────────────────────────────────────

def get_dict_path():
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'cbakey', 'user_dict.json')

def get_conf_path():
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'cbakey', 'cbakey.conf')

# ── Config helpers ─────────────────────────────────────────────────────────────

def read_enable_setting(conf_path):
    """Return True if EnableUserDictionary=True in cbakey.conf (default True)."""
    try:
        with open(conf_path) as f:
            for line in f:
                line = line.strip()
                if line.lower().startswith('enableuserdictionary='):
                    return line.split('=', 1)[1].strip().lower() == 'true'
    except FileNotFoundError:
        pass
    return True

def write_enable_setting(conf_path, enabled):
    """Write EnableUserDictionary to cbakey.conf, preserving other settings."""
    lines = []
    found = False
    try:
        with open(conf_path) as f:
            for line in f:
                if line.strip().lower().startswith('enableuserdictionary='):
                    lines.append(f'EnableUserDictionary={'true' if enabled else 'false'}\n')
                    found = True
                else:
                    lines.append(line)
    except FileNotFoundError:
        pass
    if not found:
        lines.append(f'EnableUserDictionary={'true' if enabled else 'false'}\n')
    os.makedirs(os.path.dirname(conf_path), exist_ok=True)
    tmp = conf_path + '.tmp'
    with open(tmp, 'w') as f:
        f.writelines(lines)
    os.replace(tmp, conf_path)

# ── Dictionary I/O ─────────────────────────────────────────────────────────────

def load_entries(path):
    """Load entries from JSONL or JSON array file. Returns list of dicts."""
    entries = []
    try:
        with open(path) as f:
            content = f.read().strip()
        if content.startswith('['):
            data = json.loads(content)
            for item in data:
                if isinstance(item, dict) and 'trigger' in item and 'expansion' in item:
                    entries.append({
                        'trigger':     item['trigger'],
                        'expansion':   item['expansion'],
                        'abbrev_mode': item.get('abbrev_mode', 'vi'),
                    })
        else:
            for line in content.splitlines():
                line = line.strip().rstrip(',')
                if not line or line in ('[', ']'):
                    continue
                try:
                    item = json.loads(line)
                    if 'trigger' in item and 'expansion' in item:
                        entries.append({
                            'trigger':     item['trigger'],
                            'expansion':   item['expansion'],
                            'abbrev_mode': item.get('abbrev_mode', 'vi'),
                        })
                except json.JSONDecodeError:
                    pass
    except FileNotFoundError:
        pass
    return entries

def save_entries(path, entries):
    """Save entries to JSONL with atomic write + backup."""
    bak = path + '.bak'
    if os.path.exists(path):
        shutil.copy2(path, bak)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        for e in entries:
            f.write(json.dumps({
                'trigger':     e['trigger'],
                'expansion':   e['expansion'],
                'abbrev_mode': e['abbrev_mode'],
            }, ensure_ascii=False) + '\n')
    os.replace(tmp, path)

# ── Add/Edit Dialog ────────────────────────────────────────────────────────────

class EntryDialog(Gtk.Dialog):
    """Popup dialog for adding or editing a dictionary entry."""

    def __init__(self, parent, title, entry=None):
        super().__init__(title=title, transient_for=parent, modal=True)
        self.set_default_size(420, 220)
        self.add_buttons('Cancel', Gtk.ResponseType.CANCEL,
                         'Save',   Gtk.ResponseType.OK)
        self.set_default_response(Gtk.ResponseType.OK)

        box = self.get_content_area()
        box.set_margin_top(16)
        box.set_margin_bottom(8)
        box.set_margin_start(20)
        box.set_margin_end(20)
        box.set_spacing(10)

        grid = Gtk.Grid(row_spacing=8, column_spacing=12)

        # Trigger
        grid.attach(Gtk.Label(label='Trigger:', xalign=1.0), 0, 0, 1, 1)
        self.trigger_entry = Gtk.Entry()
        self.trigger_entry.set_hexpand(True)
        self.trigger_entry.set_placeholder_text('e.g.  ko  btv  gc')
        grid.attach(self.trigger_entry, 1, 0, 2, 1)

        # Expansion
        grid.attach(Gtk.Label(label='Expansion:', xalign=1.0), 0, 1, 1, 1)
        self.expansion_entry = Gtk.Entry()
        self.expansion_entry.set_hexpand(True)
        self.expansion_entry.set_placeholder_text('e.g.  không  Ban Tổ chức')
        grid.attach(self.expansion_entry, 1, 1, 2, 1)

        # Mode
        grid.attach(Gtk.Label(label='Mode:', xalign=1.0), 0, 2, 1, 1)
        mode_box = Gtk.Box(spacing=16)
        self.mode_vi   = Gtk.RadioButton.new_with_label(None, 'VI (Vietnamese)')
        self.mode_en   = Gtk.RadioButton.new_with_label_from_widget(self.mode_vi, 'EN (English)')
        self.mode_both = Gtk.RadioButton.new_with_label_from_widget(self.mode_vi, 'Both')
        mode_box.pack_start(self.mode_vi,   False, False, 0)
        mode_box.pack_start(self.mode_en,   False, False, 0)
        mode_box.pack_start(self.mode_both, False, False, 0)
        grid.attach(mode_box, 1, 2, 2, 1)

        box.pack_start(grid, True, True, 0)

        # Populate if editing
        if entry:
            self.trigger_entry.set_text(entry['trigger'])
            self.expansion_entry.set_text(entry['expansion'])
            m = entry.get('abbrev_mode', 'vi')
            if m == 'en':
                self.mode_en.set_active(True)
            elif m == 'both':
                self.mode_both.set_active(True)
            else:
                self.mode_vi.set_active(True)

        self.show_all()

    def get_entry(self):
        trigger   = self.trigger_entry.get_text().strip()
        expansion = self.expansion_entry.get_text().strip()
        if self.mode_en.get_active():
            mode = 'en'
        elif self.mode_both.get_active():
            mode = 'both'
        else:
            mode = 'vi'
        return {'trigger': trigger, 'expansion': expansion, 'abbrev_mode': mode}

# ── Main Window ───────────────────────────────────────────────────────────────

class DictManagerWindow(Gtk.Window):

    def __init__(self):
        super().__init__(title='CBAKey — Dictionary Manager')
        self.set_default_size(580, 440)
        self.set_border_width(0)
        self.connect('destroy', Gtk.main_quit)

        self.dict_path = get_dict_path()
        self.conf_path = get_conf_path()
        self.entries   = load_entries(self.dict_path)

        self._build_ui()
        self._refresh_table()

    # ── UI construction ────────────────────────────────────────────────────────

    def _build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)

        # ── Top bar: enable toggle + entry count ──
        top_bar = Gtk.Box(spacing=12)
        top_bar.set_margin_top(12)
        top_bar.set_margin_bottom(8)
        top_bar.set_margin_start(12)
        top_bar.set_margin_end(12)

        self.enable_switch = Gtk.Switch()
        self.enable_switch.set_active(read_enable_setting(self.conf_path))
        self.enable_switch.connect('notify::active', self._on_enable_toggled)
        enable_label = Gtk.Label(label='Enable user dictionary')

        top_bar.pack_start(enable_label,       False, False, 0)
        top_bar.pack_start(self.enable_switch, False, False, 0)

        self.count_label = Gtk.Label()
        self.count_label.set_halign(Gtk.Align.END)
        top_bar.pack_end(self.count_label, False, False, 0)

        vbox.pack_start(top_bar, False, False, 0)

        sep1 = Gtk.Separator()
        vbox.pack_start(sep1, False, False, 0)

        # ── Table ──────────────────────────────────────────────────────────────
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_margin_top(8)
        scroll.set_margin_start(12)
        scroll.set_margin_end(12)

        # ListStore: trigger, expansion, mode (display), row index
        self.store = Gtk.ListStore(str, str, str)
        self.tree  = Gtk.TreeView(model=self.store)
        self.tree.set_headers_visible(True)
        self.tree.set_grid_lines(Gtk.TreeViewGridLines.HORIZONTAL)
        self.tree.connect('row-activated', self._on_row_activated)

        for i, (title, expand) in enumerate([
            ('Trigger', False), ('Expansion', True), ('Mode', False)
        ]):
            renderer = Gtk.CellRendererText()
            renderer.set_property('ellipsize', Pango.EllipsizeMode.END)
            col = Gtk.TreeViewColumn(title, renderer, text=i)
            col.set_resizable(True)
            col.set_expand(expand)
            if i == 0:
                col.set_min_width(110)
            self.tree.append_column(col)

        self.selection = self.tree.get_selection()
        self.selection.connect('changed', self._on_selection_changed)

        scroll.add(self.tree)
        vbox.pack_start(scroll, True, True, 0)

        # ── Button bar ─────────────────────────────────────────────────────────
        sep2 = Gtk.Separator()
        vbox.pack_start(sep2, False, False, 8)

        btn_bar = Gtk.Box(spacing=8)
        btn_bar.set_margin_bottom(12)
        btn_bar.set_margin_start(12)
        btn_bar.set_margin_end(12)

        self.btn_add    = Gtk.Button(label='+ Add')
        self.btn_edit   = Gtk.Button(label='✏ Edit')
        self.btn_delete = Gtk.Button(label='🗑 Delete')
        btn_close       = Gtk.Button(label='Close')

        self.btn_edit.set_sensitive(False)
        self.btn_delete.set_sensitive(False)

        self.btn_add.connect('clicked',    self._on_add)
        self.btn_edit.connect('clicked',   self._on_edit)
        self.btn_delete.connect('clicked', self._on_delete)
        btn_close.connect('clicked',       lambda _: self.destroy())

        btn_bar.pack_start(self.btn_add,    False, False, 0)
        btn_bar.pack_start(self.btn_edit,   False, False, 0)
        btn_bar.pack_start(self.btn_delete, False, False, 0)
        btn_bar.pack_end(btn_close,         False, False, 0)

        # Status label (reload hint)
        self.status_label = Gtk.Label()
        self.status_label.set_halign(Gtk.Align.CENTER)
        self.status_label.set_markup(
            '<small><i>Changes are saved immediately. '
            'Refocus a window for CBAKey to pick them up.</i></small>')
        btn_bar.pack_start(self.status_label, True, True, 0)

        vbox.pack_start(btn_bar, False, False, 0)

    # ── Table refresh ─────────────────────────────────────────────────────────

    def _refresh_table(self):
        self.store.clear()
        mode_display = {'vi': 'VI', 'en': 'EN', 'both': 'Both'}
        for e in self.entries:
            self.store.append([
                e['trigger'],
                e['expansion'],
                mode_display.get(e['abbrev_mode'], 'VI'),
            ])
        n = len(self.entries)
        self.count_label.set_text(f'{n} entr{"y" if n == 1 else "ies"}')

    def _selected_index(self):
        model, it = self.selection.get_selected()
        if it is None:
            return -1
        path = model.get_path(it)
        return path.get_indices()[0]

    # ── Signal handlers ───────────────────────────────────────────────────────

    def _on_selection_changed(self, _sel):
        has = self._selected_index() >= 0
        self.btn_edit.set_sensitive(has)
        self.btn_delete.set_sensitive(has)

    def _on_row_activated(self, _tree, _path, _col):
        self._on_edit(None)

    def _on_enable_toggled(self, switch, _param):
        write_enable_setting(self.conf_path, switch.get_active())

    def _on_add(self, _btn):
        dlg = EntryDialog(self, 'Add Entry')
        if dlg.run() == Gtk.ResponseType.OK:
            e = dlg.get_entry()
            if not e['trigger'] or not e['expansion']:
                self._show_error('Trigger and Expansion cannot be empty.')
            elif any(x['trigger'] == e['trigger'] for x in self.entries):
                self._show_error(f'Trigger "{e["trigger"]}" already exists. Edit it instead.')
            else:
                self.entries.append(e)
                save_entries(self.dict_path, self.entries)
                self._refresh_table()
        dlg.destroy()

    def _on_edit(self, _btn):
        idx = self._selected_index()
        if idx < 0:
            return
        dlg = EntryDialog(self, 'Edit Entry', self.entries[idx])
        if dlg.run() == Gtk.ResponseType.OK:
            e = dlg.get_entry()
            if not e['trigger'] or not e['expansion']:
                self._show_error('Trigger and Expansion cannot be empty.')
            else:
                self.entries[idx] = e
                save_entries(self.dict_path, self.entries)
                self._refresh_table()
                # Re-select same row
                if idx < len(self.entries):
                    self.tree.get_selection().select_path(Gtk.TreePath(idx))
        dlg.destroy()

    def _on_delete(self, _btn):
        idx = self._selected_index()
        if idx < 0:
            return
        trigger = self.entries[idx]['trigger']
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=f'Delete "{trigger}"?',
        )
        dlg.format_secondary_text('This cannot be undone (a backup is kept as user_dict.json.bak).')
        if dlg.run() == Gtk.ResponseType.OK:
            del self.entries[idx]
            save_entries(self.dict_path, self.entries)
            self._refresh_table()
        dlg.destroy()

    def _show_error(self, msg):
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dlg.run()
        dlg.destroy()


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    win = DictManagerWindow()
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
